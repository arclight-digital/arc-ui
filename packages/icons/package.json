{
  "name": "@arclux/arc-ui-icons",
  "version": "3.2.0",
  "description": "ARC UI — Phosphor and Lucide icon packs, registered into @arclux/arc-ui on demand.",
  "sideEffects": [
    "./src/*.register.js"
  ],
  "license": "MIT AND ISC",
  "type": "module",
  "files": [
    "src/"
  ],
  "exports": {
    "./phosphor": "./src/phosphor.register.js",
    "./phosphor/*": "./src/phosphor/*.js",
    "./lucide": "./src/lucide.register.js",
    "./lucide/*": "./src/lucide/*.js",
    "./all/phosphor": {
      "types": "./src/phosphor.d.ts",
      "default": "./src/phosphor.js"
    },
    "./all/lucide": {
      "types": "./src/lucide.d.ts",
      "default": "./src/lucide.js"
    },
    "./aliases": "./src/aliases.js",
    "./types": {
      "types": "./src/types.d.ts",
      "default": "./src/types.d.ts"
    }
  },
  "peerDependencies": {
    "@arclux/arc-ui": "workspace:^"
  },
  "devDependencies": {
    "@arclux/arc-ui": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "arc-ui",
    "icons",
    "phosphor",
    "lucide",
    "svg",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arclight-digital/arc-ui",
    "directory": "packages/icons"
  },
  "homepage": "https://arcui.dev",
  "bugs": {
    "url": "https://github.com/arclight-digital/arc-ui/issues"
  }
}
