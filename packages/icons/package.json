{
  "name": "@arclux/arc-ui-icons",
  "version": "4.0.1",
  "description": "ARC UI \u2014 Phosphor and Lucide icon packs, registered into @arclux/arc-ui on demand.",
  "sideEffects": [
    "./src/*.register.js"
  ],
  "license": "MIT AND ISC",
  "type": "module",
  "scripts": {
    "prepublishOnly": "node ../../scripts/publish-guard.js"
  },
  "files": [
    "src/"
  ],
  "exports": {
    "./phosphor": {
      "types": "./src/phosphor.register.d.ts",
      "default": "./src/phosphor.register.js"
    },
    "./phosphor/*": {
      "types": "./src/glyph.d.ts",
      "default": "./src/phosphor/*.js"
    },
    "./lucide": {
      "types": "./src/lucide.register.d.ts",
      "default": "./src/lucide.register.js"
    },
    "./lucide/*": {
      "types": "./src/glyph.d.ts",
      "default": "./src/lucide/*.js"
    },
    "./all/phosphor": {
      "types": "./src/phosphor.d.ts",
      "default": "./src/phosphor.js"
    },
    "./all/lucide": {
      "types": "./src/lucide.d.ts",
      "default": "./src/lucide.js"
    },
    "./aliases": {
      "types": "./src/aliases.d.ts",
      "default": "./src/aliases.js"
    },
    "./types": {
      "types": "./src/types.d.ts",
      "default": "./src/types.d.ts"
    }
  },
  "peerDependencies": {
    "@arclux/arc-ui": "workspace:^"
  },
  "devDependencies": {
    "@arclux/arc-ui": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "arc-ui",
    "icons",
    "phosphor",
    "lucide",
    "svg",
    "web-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arclight-digital/arc-ui",
    "directory": "packages/icons"
  },
  "homepage": "https://arcui.dev",
  "bugs": {
    "url": "https://github.com/arclight-digital/arc-ui/issues"
  }
}
