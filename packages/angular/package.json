{
  "name": "@arclux/arc-ui-angular",
  "version": "4.2.1",
  "description": "Angular standalone component wrappers for ARC UI Web Components.",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "node ../../scripts/publish-guard.js"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0 <22.0.0",
    "@angular/core": ">=17.0.0 <22.0.0",
    "@angular/forms": ">=17.0.0 <22.0.0",
    "@arclux/arc-ui": "workspace:^"
  },
  "license": "MIT",
  "keywords": [
    "angular",
    "web-components",
    "design-system",
    "arclight"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arclight-digital/arc-ui",
    "directory": "packages/angular"
  },
  "homepage": "https://arcui.dev",
  "bugs": {
    "url": "https://github.com/arclight-digital/arc-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "devDependencies": {
    "@angular/common": "^17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@arclux/arc-ui": "workspace:*",
    "ng-packagr": "^17.3.0",
    "rxjs": "^7.8.2",
    "typescript": "~5.4.5",
    "zone.js": "~0.14.10"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
