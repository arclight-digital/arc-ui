<script>
  import { init as glintInit, arm } from '@arclux/glint/full';
  import '@arclux/glint/glint.css';
  import '@arclux/arc-ui/utilities.css';
  // arc-code-block is opt-in only (it lazy-loads a syntax highlighter), so
  // the register barrel skips it. Without this import the
  // framework switcher's window never upgrades and the FOUC guard hides it.
  import '@arclux/arc-ui/code-block';
  import { initLightplay } from '../scripts/arc-lightplay.js';

  /* ── Lightplay hero ──
     One WebGL pass (scripts/arc-lightplay.js) draws the whole hero light
     system. It owns its own resize, visibility pause, reduced-motion still
     frame, and theme sync, including re-reading the accent tokens when the
     swatch demo writes them onto <html>'s style attribute, so all this page
     does is start it, reveal the hero behind the first frame, and dispose on
     navigation. */
  function initHero() {
    const canvas = document.querySelector('[data-lightplay]') as HTMLCanvasElement | null;
    if (!canvas) return;
    // Guard against double init: on first load both the direct call and
    // astro:page-load fire, and a second context on one canvas is a leak
    if ((canvas as any).__arcLightplay) return;
    (canvas as any).__arcLightplay = true;
    const hero = canvas.closest('.hero');
    // The field defocuses behind the copy and the top bar so their text
    // keeps its contrast
    const dispose = initLightplay(canvas, {
      quiet: [hero?.querySelector('.hero__copy'), hero?.querySelector('.mixer'), document.querySelector('arc-top-bar')].filter(Boolean),
    });
    initMixer();
    // Reveal on the frame after the shader's first draw, so load-time jank
    // happens behind the fade instead of in front of the visitor
    requestAnimationFrame(() => hero?.classList.add('hero--live'));
    document.addEventListener('astro:before-swap', () => dispose(), { once: true });
  }

  /* ── The hero's mixer: the three real theming inputs, applied to the page.
     Hue writes the two accent tokens at :root (secondary 70° round the
     wheel), exactly as a consumer's theme.css would; density sets
     [data-density] on <html>; the scheme control is arc-theme-toggle. ── */
  function initMixer() {
    const mixer = document.getElementById('hero-mixer');
    const hue = document.getElementById('hero-hue') as any;
    const density = document.getElementById('hero-density') as any;
    const scheme = document.getElementById('hero-scheme') as any;
    const reset = document.getElementById('mixer-reset') as any;
    const hexOut = document.getElementById('mixer-hex');
    if (!mixer || !hue || (mixer as any).dataset.init) return;
    (mixer as any).dataset.init = '1';
    const root = document.documentElement;
    const PROPS = ['--accent-primary', '--accent-primary-rgb', '--accent-secondary', '--accent-secondary-rgb'];
    const hsl = (h: number, s: number, l: number) => {
      const k = (n: number) => (n + h / 30) % 12;
      const a = s * Math.min(l, 1 - l);
      const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
      return [f(0), f(8), f(4)].map((v) => Math.round(v * 255));
    };
    const hex = (c: number[]) => '#' + c.map((v) => v.toString(16).padStart(2, '0')).join('');
    const hueOf = (rgb: string) => {
      const [r, g, b] = rgb.split(',').map((n) => +n / 255);
      const max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min;
      if (!d) return 0;
      const h = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
      return Math.round((h * 60 + 360) % 360);
    };
    // Read through the -rgb channels: the color tokens can compute to any
    // CSS color syntax, and the readout should always say what a theme.css
    // would contain
    const readout = () => {
      const cs = getComputedStyle(root);
      const asHex = (name: string) => hex(cs.getPropertyValue(name).split(',').map((n) => Math.round(+n)));
      if (hexOut) hexOut.textContent = `${asHex('--accent-primary-rgb')}  ${asHex('--accent-secondary-rgb')}`;
    };
    // What the visitor arrived with, so reset is a real undo: the shipped
    // accents (the override removed), default density, and their own scheme,
    // which is a saved preference, not ours to overwrite
    const homeHue = hueOf(getComputedStyle(root).getPropertyValue('--accent-primary-rgb'));
    const homeScheme = scheme?.theme ?? 'auto';
    hue.value = homeHue;
    readout();

    let dirty = false;
    const touch = () => { dirty = true; reset.disabled = false; };

    hue.addEventListener('arc-input', (e: any) => {
      const h = +(e.detail?.value ?? hue.value);
      const p = hsl(h, 0.85, 0.6), q = hsl((h + 70) % 360, 0.85, 0.62);
      root.style.setProperty('--accent-primary', hex(p));
      root.style.setProperty('--accent-primary-rgb', p.join(', '));
      root.style.setProperty('--accent-secondary', hex(q));
      root.style.setProperty('--accent-secondary-rgb', q.join(', '));
      readout();
      touch();
    });
    density?.addEventListener('arc-change', (e: any) => {
      const v = e.detail?.value;
      if (v === 'default') root.removeAttribute('data-density');
      else root.setAttribute('data-density', v);
      touch();
    });
    scheme?.addEventListener('arc-change', () => { touch(); requestAnimationFrame(readout); });

    const undo = () => {
      if (!dirty) return;
      PROPS.forEach((prop) => root.style.removeProperty(prop));
      root.removeAttribute('data-density');
      if (density) density.value = 'default';
      if (scheme && scheme.theme !== homeScheme) scheme.theme = homeScheme;
      hue.value = homeHue;
      // The accent swatches further down wrote to the same tokens; their
      // console goes back to the shipped theme too
      document.querySelector<HTMLElement>('#accent-swatches [data-default]')?.click();
      requestAnimationFrame(readout);
      dirty = false;
      reset.disabled = true;
    };
    reset?.addEventListener('click', undo);
    mixer.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && dirty) { e.preventDefault(); undo(); }
    });

    document.addEventListener('astro:before-swap', () => {
      PROPS.forEach((prop) => root.style.removeProperty(prop));
      root.removeAttribute('data-density');
    }, { once: true });
  }

  /* ── Reveal on scroll (glint) ──
     The revealed state is the default: glint hides at runtime, so a script
     failure leaves the page readable instead of blank. Reduced motion,
     focus-into-pending, and the forced-reveal ceiling all come with it.
     Durations and easing follow the ARC motion tokens (--duration-enter,
     --ease-out) via glint.css. */
  /* One controller per page view. astro:page-load fires on the initial load
     too, so without the guard this ran twice and the second init re-hid the
     elements the first had just revealed: the CTA banner faded in, blinked
     out, and faded back. The guard clears on before-swap so a soft
     navigation still gets a fresh controller. */
  let glint: ReturnType<typeof glintInit> | null = null;
  function initReveal() {
    if (glint) return;
    glint = glintInit();
    // arm() re-hides before a soft navigation swaps content in, so the page
    // navigated *to* gets the same flash-free entrance as a full load.
    document.addEventListener('astro:before-swap', () => {
      arm();
      glint?.destroy();
      glint = null;
    }, { once: true });
  }

  /* ── Utilities demo: one token moves everything. Spacing and radius scope
     to the stage; a scoped override is exactly how a consumer would use
     them, unlike the accents, whose compounds only recompose at :root ── */
  function initTokensDemo() {
    const stage = document.getElementById('tokens-demo-stage');
    if (!stage) return;
    const wire = (sliderId: string, readoutId: string, prop: string) => {
      const slider = document.getElementById(sliderId) as any;
      const readout = document.getElementById(readoutId);
      if (!slider || slider.dataset.demoInit) return;
      slider.dataset.demoInit = '1';
      slider.addEventListener('arc-input', (e: any) => {
        const v = Math.round(e.detail?.value ?? slider.value);
        stage.style.setProperty(prop, `${v}px`);
        if (readout) readout.textContent = `${v}px`;
      });
    };
    wire('tokens-demo-slider', 'tokens-demo-readout', '--space-md');
    wire('radius-slider', 'radius-readout', '--radius-lg');
  }

  /* ── Stat count-up ── */
  function initStatCountUp() {
    const nums = document.querySelectorAll('arc-animated-number[data-target]');
    if (!nums.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as any;
          const target = el.dataset.target;
          if (prefersReducedMotion) {
            el.value = target;
          } else {
            // Small delay for visual effect
            requestAnimationFrame(() => { el.value = target; });
          }
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.3 });

    nums.forEach(el => observer.observe(el));
  }

  /* ── Accent swatches: the theme.css panel rewrites itself, and the
     override applies at :root, the real consumer recipe, applied for real.
     Compound tokens compose on :root, so a scoped override would recolor
     direct var() uses and quietly skip every gradient, glow and focus ring;
     applying to documentElement is the demo that cannot lie. The lightplay
     shader needs no notifying: it watches <html>'s style attribute and
     re-reads the accent tokens itself. Cleanup on navigation keeps the
     override from following the visitor into docs. ── */
  function initAccentSwatches() {
    const group = document.getElementById('accent-swatches');
    if (!group || (group as any).dataset.init) return;
    (group as any).dataset.init = '1';

    const PROPS = ['--accent-primary', '--accent-primary-rgb', '--accent-secondary', '--accent-secondary-rgb'];
    document.addEventListener('astro:before-swap', () => {
      PROPS.forEach((prop) => document.documentElement.style.removeProperty(prop));
    }, { once: true });

    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.swatch');
      if (!btn) return;
      const { p, prgb, s, srgb } = btn.dataset;
      const root = document.documentElement.style;
      if (btn.dataset.default) {
        // The first swatch is the shipped theme: a real reset, not a repaint
        // that happens to match. Removing the override hands control back to
        // base.css, so light mode, .theme-fixed and future token changes all
        // resolve exactly as if the demo was never touched.
        PROPS.forEach((prop) => root.removeProperty(prop));
      } else {
        root.setProperty('--accent-primary', p!);
        root.setProperty('--accent-primary-rgb', prgb!);
        root.setProperty('--accent-secondary', s!);
        root.setProperty('--accent-secondary-rgb', srgb!);
      }
      const spaced = (rgb: string) => rgb.split(',').map((n) => n.trim()).join(', ');
      const vals: Record<string, string> = { p: p!, prgb: spaced(prgb!), s: s!, srgb: spaced(srgb!) };
      document.querySelectorAll<HTMLElement>('[data-theme-val]').forEach((el) => {
        el.textContent = vals[el.dataset.themeVal!] ?? el.textContent;
      });
      Array.from(group.children).forEach((c) => {
        c.classList.toggle('is-active', c === btn);
        c.setAttribute('aria-pressed', String(c === btn));
      });
    });
  }

  /* ── Prism: pick an output, its ray lights and its file opens ── */
  function initPrism() {
    const rig = document.getElementById('prism-rig');
    if (!rig || (rig as any).dataset.init) return;
    (rig as any).dataset.init = '1';
    const outs = Array.from(rig.querySelectorAll<HTMLElement>('.out'));
    const rays = Array.from(rig.querySelectorAll<SVGPathElement>('.prism__ray'));
    const files = Array.from(document.querySelectorAll<HTMLElement>('.prism__file'));
    const select = (i: number) => {
      outs.forEach((o, j) => {
        o.classList.toggle('is-on', i === j);
        o.setAttribute('aria-pressed', String(i === j));
      });
      rays.forEach((r, j) => r.classList.toggle('is-on', i === j));
      files.forEach((f, j) => f.toggleAttribute('hidden', i !== j));
    };
    outs.forEach((o, i) => o.addEventListener('click', () => select(i)));
    // Hovering previews the ray without committing the selection
    outs.forEach((o, i) => {
      o.addEventListener('pointerenter', () => rays[i]?.classList.add('is-hover'));
      o.addEventListener('pointerleave', () => rays[i]?.classList.remove('is-hover'));
    });
    // The light travels through once, when the rig first comes into view.
    // Armed from script, so without it the rays simply stand lit.
    rig.classList.add('is-armed');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      rig.classList.add('is-lit');
      io.disconnect();
    }, { threshold: 0.35 });
    io.observe(rig);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }

  /* ── App: the issue tracker ──
     One array is the source of truth. The list was rendered by the server;
     everything after load (the board, the sheet, a moved card, a new issue,
     the cycle's progress and the rail's load chart) is written from it. */
  type Issue = { id: string; title: string; who: string; status: string; priority: string; points: number; body: string };
  type Status = { id: string; label: string; variant: string };
  function initApp() {
    const dataEl = document.getElementById('app-data');
    const list = document.getElementById('app-list') as any;
    if (!dataEl || !list || list.dataset.init) return;
    list.dataset.init = '1';
    const { statuses, issues } = JSON.parse(dataEl.textContent!) as { statuses: Status[]; issues: Issue[] };
    const $ = <T extends HTMLElement = any>(id: string) => document.getElementById(id) as T & any;
    const board = $('app-board');
    const sheet = $('app-sheet');
    const dialog = $('app-new');
    const toast = $('app-toast');
    const statusOf = (id: string) => statuses.find((s) => s.id === id)!;
    let query = '';
    let view = 'all';
    let openId = '';
    const ME = 'Nina Park';

    const inView = (i: Issue) =>
      view === 'all' ? true
      : view === 'mine' ? i.who === ME
      : view === 'review' || view === 'done' ? i.status === view
      : view.startsWith('who-') ? i.who.split(' ')[0].toLowerCase() === view.slice(4)
      : true;
    const matches = (i: Issue) =>
      inView(i) && (!query || `${i.id} ${i.title} ${i.who}`.toLowerCase().includes(query));

    const renderBoard = () => {
      board.columns = statuses.map((s) => ({
        id: s.id,
        title: s.label,
        ...(s.id === 'doing' ? { limit: 3 } : {}),
        items: issues
          .filter((i) => i.status === s.id && matches(i))
          .map((i) => ({ id: i.id, label: i.title, description: `${i.id} · ${i.who.split(' ')[0]}`, tag: i.priority, variant: i.priority === 'Urgent' ? 'error' : i.priority === 'High' ? 'warning' : 'default' })),
      }));
    };

    const itemFor = (id: string) =>
      Array.from(list.querySelectorAll('arc-list-item')).find((el: any) => el.value === id) as HTMLElement | undefined;

    const makeItem = (i: Issue) => {
      const item = document.createElement('arc-list-item') as any;
      item.value = i.id;
      const avatar = document.createElement('arc-avatar') as any;
      avatar.slot = 'prefix';
      avatar.setAttribute('name', i.who);
      avatar.setAttribute('size', 'sm');
      const desc = document.createElement('span');
      desc.slot = 'description';
      desc.textContent = `${i.id} · ${i.who.split(' ')[0]} · ${i.priority}`;
      const st = document.createElement('span');
      st.className = 'app__desc-status';
      st.innerHTML = ' · <span data-status-text></span>';
      desc.append(st);
      const tag = document.createElement('arc-tag');
      tag.slot = 'suffix';
      tag.setAttribute('size', 'sm');
      const done = document.createElement('arc-icon-button') as any;
      done.slot = 'actions';
      done.setAttribute('size', 'xs');
      done.setAttribute('label', `Mark ${i.id} as done`);
      done.dataset.done = i.id;
      done.innerHTML = '<svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      item.append(avatar, document.createTextNode(i.title), desc, tag, done);
      return item;
    };

    const syncItem = (i: Issue) => {
      const el = itemFor(i.id);
      const tag = el?.querySelector('arc-tag');
      if (!el || !tag) return;
      tag.setAttribute('variant', statusOf(i.status).variant);
      tag.textContent = statusOf(i.status).label;
      const txt = el.querySelector('[data-status-text]');
      if (txt) txt.textContent = statusOf(i.status).label;
      (el.querySelector('[data-done]') as any).disabled = i.status === 'done';
    };

    const syncSummary = () => {
      const done = issues.filter((i) => i.status === 'done').length;
      $('app-cycle-count').textContent = `${done} of ${issues.length} done`;
      $('app-cycle-bar').value = Math.round((done / issues.length) * 100);
      const people = [...new Set(issues.map((i) => i.who))];
      $('app-load').items = people
        .map((who) => ({
          label: who.split(' ')[0],
          value: issues.filter((i) => i.who === who && i.status !== 'done').reduce((n, i) => n + i.points, 0),
        }))
        .sort((a, b) => b.value - a.value);
    };

    const filter = () => {
      let shown = 0;
      issues.forEach((i) => {
        const el = itemFor(i.id);
        const on = matches(i);
        el?.toggleAttribute('hidden', !on);
        if (on) shown++;
      });
      $('app-empty').hidden = shown > 0 || !board.hidden;
      renderBoard();
    };

    const fillSheet = (i: Issue) => {
      openId = i.id;
      sheet.heading = i.title;
      $('app-sheet-id').textContent = i.id;
      $('app-sheet-status').textContent = statusOf(i.status).label;
      $('app-sheet-who').textContent = i.who;
      $('app-sheet-priority').textContent = i.priority;
      $('app-sheet-points').textContent = `${i.points} ${i.points === 1 ? 'point' : 'points'}`;
      $('app-sheet-body').textContent = i.body;
      const tl = $('app-sheet-timeline');
      tl.replaceChildren();
      const add = (heading: string, date: string) => {
        const t = document.createElement('arc-timeline-item');
        t.setAttribute('heading', heading);
        t.setAttribute('date', date);
        tl.append(t);
      };
      add(`Opened by ${i.who.split(' ')[0]}`, 'Sep 22');
      if (i.status !== 'todo') add(`Moved to ${statusOf(i.status).label}`, 'Sep 26');
      $('app-sheet-done').disabled = i.status === 'done';
    };

    const openIssue = (id: string) => {
      const i = issues.find((x) => x.id === id);
      if (!i) return;
      fillSheet(i);
      markOpen(id);
      sheet.open = true;
    };
    // The open issue's row stays lit while its sheet is up
    const markOpen = (id: string) =>
      list.querySelectorAll('arc-list-item').forEach((el: any) => { el.selected = el.value === id; });
    sheet.addEventListener('arc-close', () => { markOpen(''); openId = ''; });

    const setStatus = (id: string, status: string, undoable = true) => {
      const i = issues.find((x) => x.id === id);
      if (!i || i.status === status) return;
      const was = i.status;
      i.status = status;
      syncItem(i);
      syncSummary();
      renderBoard();
      if (openId === id && sheet.open) fillSheet(i);
      if (!undoable) return;
      toast.show({
        message: `${i.id} moved to ${statusOf(status).label}`,
        variant: status === 'done' ? 'success' : 'info',
        actionLabel: 'Undo',
        action: () => setStatus(id, was, false),
      });
    };

    // The sidebar's links are this app's views. Cancelling arc-navigate
    // keeps the anchor from firing; stopping it keeps the page's own
    // soft-navigation listener from following the href.
    const side = $('app-side');
    const titles: Record<string, string> = { all: 'All issues', mine: 'Assigned to me', review: 'In review', done: 'Done' };
    side.addEventListener('arc-navigate', (e: any) => {
      e.preventDefault();
      e.stopPropagation();
      view = String(e.detail?.href ?? '#all').slice(1);
      const who = issues.find((i) => `who-${i.who.split(' ')[0].toLowerCase()}` === view)?.who;
      $('app-heading').heading = titles[view] ?? who ?? 'Issues';
      filter();
    });

    list.addEventListener('arc-select', (e: any) => {
      const id = e.detail?.value ?? (e.target as any)?.value;
      if (id) openIssue(id);
    });
    board.addEventListener('arc-card-click', (e: any) => openIssue(e.detail.cardId));
    board.addEventListener('arc-card-move', (e: any) => {
      setStatus(e.detail.cardId, e.detail.toColumn);
    });
    // Row actions: the check on a hovered or focused row. Stopping the click
    // keeps it from also opening the issue.
    list.addEventListener('click', (e: Event) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-done]');
      if (!btn) return;
      e.stopPropagation();
      setStatus(btn.dataset.done!, 'done');
    }, true);

    $('app-view').addEventListener('arc-change', (e: any) => {
      const board_ = e.detail.value === 'board';
      board.hidden = !board_;
      list.hidden = board_;
      $('app-body').classList.toggle('is-board', board_);
      filter();
    });
    $('app-search').addEventListener('arc-input', (e: any) => {
      query = (e.detail?.value ?? '').trim().toLowerCase();
      filter();
    });
    $('app-search').addEventListener('arc-clear', () => {
      query = '';
      filter();
    });

    $('app-sheet-close').addEventListener('click', () => { sheet.open = false; });
    $('app-sheet-done').addEventListener('click', () => {
      setStatus(openId, 'done');
      sheet.open = false;
    });

    const title = $('app-new-title');
    const resetForm = () => {
      title.value = '';
      title.error = '';
      $('app-new-body').value = '';
    };
    $('app-new-open').addEventListener('click', () => {
      resetForm();
      dialog.open = true;
    });
    $('app-new-cancel').addEventListener('click', () => { dialog.open = false; });
    title.addEventListener('arc-input', () => { if (title.error) title.error = ''; });
    const create = () => {
      const text = (title.value ?? '').trim();
      if (!text) {
        title.error = 'Give the issue a title.';
        title.focus();
        return;
      }
      const next = Math.max(...issues.map((i) => +i.id.split('-')[1])) + 1;
      const issue: Issue = {
        id: `ARC-${next}`,
        title: text,
        who: $('app-new-who').value,
        status: 'todo',
        priority: $('app-new-priority').value,
        points: 1,
        body: ($('app-new-body').value ?? '').trim() || 'No description yet.',
      };
      issues.unshift(issue);
      const item = makeItem(issue);
      list.prepend(item);
      syncItem(issue);
      syncSummary();
      filter();
      dialog.open = false;
      toast.show({ message: `${issue.id} created`, variant: 'success' });
    };
    $('app-new-create').addEventListener('click', create);
    $('app-new-form').addEventListener('submit', (e: Event) => { e.preventDefault(); create(); });

    renderBoard();

    // The sheet, dialog and toast belong to this page; a soft navigation
    // must not carry an open one into the docs
    document.addEventListener('astro:before-swap', () => {
      sheet.open = false;
      dialog.open = false;
    }, { once: true });
  }

  async function initNavigation() {
    // Document-level listener survives soft navigations; without the guard,
    // every astro:page-load stacked another copy and one click navigated N times.
    if ((window as any).__arcNavigate) return;
    (window as any).__arcNavigate = true;
    const { navigate } = await import('astro:transitions/client');
    document.addEventListener('arc-navigate', (e: any) => {
      const href = e.detail?.href;
      if (href) {
        e.preventDefault();
        navigate(href);
      }
    });
  }

  initHero();
  initReveal();
  initStatCountUp();
  initPrism();
  initApp();
  initTokensDemo();
  initAccentSwatches();
  initNavigation();
  document.addEventListener('astro:page-load', () => {
    initHero();
    initReveal();
    initStatCountUp();
      initPrism();
    initApp();
    initTokensDemo();
    initAccentSwatches();
    initNavigation();
  });
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: clip;
    padding: calc(var(--space-3xl) + 80px) var(--space-lg) var(--space-2xl);
    min-height: 85vh;
    display: flex;
    align-items: center;
    /* The headline's bloom follows --glow-a, calmer on light. The shader
       handles its own light/dark internally. */
    --glow-a: 1;
  }

  :global([data-theme='light']) .hero {
    --glow-a: 0.4;
  }

  @media (prefers-color-scheme: light) {
    :global([data-theme='auto']) .hero {
      --glow-a: 0.4;
    }
  }

  /* ── Lightplay canvas ──
     The whole hero light system is one WebGL pass (scripts/arc-lightplay.js):
     plasma filaments and caustic shimmer, chromatic fringes, per-pixel
     film grain. It
     composites premultiplied alpha over the page, so the body's own
     --bg-deep is the darkness the light plays in; there is no second
     background to keep in sync. */
  .hero__lightplay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .hero--live .hero__lightplay {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    /* The shader serves a static frame of its own; only the reveal shortens */
    .hero__lightplay {
      transition: opacity 0.6s ease;
    }
  }

  /* ── Wash ──
     The page's own ground, laid softly over the light where people read:
     one broad pool behind the copy. Built
     from --bg-deep at partial strength via color-mix, so it is dark on dark
     and light on light with no second definition. */
  .hero__wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    --wash: color-mix(in oklab, var(--bg-deep) 35%, rgb(0 0 0 / 0));
    --wash-0: color-mix(in oklab, var(--bg-deep) 0%, rgb(0 0 0 / 0));
    background:
      radial-gradient(ellipse 46% 44% at 50% 42%, var(--wash), var(--wash-0) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin-inline: auto;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--space-2xl);
  }

  /* The claim, left-aligned; the proof sits beside it */
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: start;
    gap: var(--space-md);
    min-width: 0;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1;
  }

  .hero__headline-top {
    font-size: clamp(30px, 3.6vw, 50px);
    font-weight: 200;
    letter-spacing: -1px;
    color: var(--text-primary);
  }

  .hero__headline-glow-wrap {
    position: relative;
    display: block;
    padding-bottom: 12px;
  }

  .hero__headline-glow {
    position: relative;
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: 600;
    letter-spacing: -0.035em;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    z-index: 1;
  }

  /* The word the page is named for actually emits: the twin behind it is a
     layered bloom (hot white core, accent halo, wide secondary falloff)
     breathing on the hero's own glow knob so light mode stays calm. */
  .hero__headline-glow-shadow {
    position: absolute;
    inset: 0;
    font-size: clamp(40px, 4.6vw, 64px);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: transparent;
    /* Dialled back now that the tunnel behind it blooms: the word was
       competing with its own backdrop and the two glows summed into haze.
       The falloff shape is unchanged, just quieter. */
    text-shadow:
      0 0 14px rgba(255, 255, 255, calc(0.2 * var(--glow-a, 1))),
      0 0 32px rgba(var(--accent-primary-rgb), calc(0.38 * var(--glow-a, 1))),
      0 0 70px rgba(var(--accent-primary-rgb), calc(0.26 * var(--glow-a, 1))),
      0 0 130px rgba(var(--accent-secondary-rgb), calc(0.22 * var(--glow-a, 1)));
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
    user-select: none;
    animation: hero-glow-breathe 5s ease-in-out infinite alternate;
  }

  @keyframes hero-glow-breathe {
    from { opacity: 0.62; }
    to   { opacity: 0.88; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__headline-glow-shadow {
      animation: none;
    }
  }

  .hero__body {
    color: var(--text-secondary);
    max-width: 48ch;
    text-wrap: pretty;
    font-size: var(--text-md);
    line-height: 1.7;
  }

  /* Over the light a transparent secondary let the plasma run through it,
     its colour fringes tracing the dark outline. Frosted, it sits on the
     page's own ground and takes a faint accent edge instead. */
  .hero__actions arc-button[variant='secondary']::part(button) {
    background: color-mix(in oklab, var(--bg-card) 70%, rgb(0 0 0 / 0));
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-color: rgba(var(--accent-primary-rgb), 0.3);
  }

  .hero__actions arc-button[variant='secondary']:hover::part(button) {
    border-color: var(--interactive);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-sm);
  }

  /* ── Chapter type ──
     Every chapter opens the same way: eyebrow, a two-line statement with one
     lit line, one sentence. The statement is the section header now. There
     are no card grids to carry the argument, the artifact below it does. */
  .statement {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-sm);
    font-size: clamp(44px, 7vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .statement__quiet {
    font-weight: 200;
    color: var(--text-primary);
  }

  .statement__lit {
    font-weight: 600;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 28px rgba(var(--accent-primary-rgb), 0.28));
  }

  /* background-clip: text paints glyphs only where the element's box is;
     any line-height tighter than the glyph extents chops descenders. Every
     clipped element gets its paint box extended in em (so it scales with
     the type) and pulled back with margin so layout doesn't move. */
  .statement__lit,
  .statement__quiet,
  .stat-custom__number,
  .hero__headline-glow {
    padding-block: 0.1em 0.2em;
    margin-block: -0.1em -0.2em;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: var(--text-md);
    max-width: 640px;
    text-wrap: balance;
    line-height: 1.7;
    margin-top: var(--space-md);
  }

  /* One claim per line where the copy is written that way; re-wrap naturally
     once the viewport can't hold a full sentence */
  .section-desc__line {
    display: block;
  }

  @media (max-width: 640px) {
    .section-desc__line {
      display: inline;
    }
  }

  /* These sit inside running text, so color alone can't mark them as links:
     a quiet underline does, and firms up on hover */
  .chapter-link {
    color: var(--interactive);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(var(--interactive-rgb), 0.45);
    transition: text-decoration-color var(--transition-fast);
  }

  .chapter-link:hover {
    text-decoration-color: var(--interactive);
  }

  /* Mock window lights, for the tracker's chrome */
  .window-orbs {
    display: inline-flex;
    gap: 6px;
  }

  .window-orbs i {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--orb-close);
  }

  .window-orbs i:nth-child(2) { background: var(--orb-minimize); }
  .window-orbs i:nth-child(3) { background: var(--orb-maximize); }

  .hero__headline--xl .hero__headline-top {
    font-size: clamp(34px, 5vw, 72px);
    font-weight: 200;
    letter-spacing: -0.03em;
  }

  .hero__headline--xl .hero__headline-glow,
  .hero__headline--xl .hero__headline-glow-shadow {
    font-size: clamp(52px, 8.4vw, 128px);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  /* The hero stacks: the claim, then the mixer under it */
  .hero__copy--center {
    align-items: center;
    text-align: center;
  }

  .hero__copy--center .hero__headline {
    align-items: center;
  }

  .hero__copy--center .hero__body {
    max-width: 58ch;
  }

  .hero__copy--center .hero__actions {
    justify-content: center;
  }

  .mixer {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: min(100%, 980px);
    padding: var(--space-md) var(--space-xl) var(--space-lg);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background:
      radial-gradient(ellipse 60% 120% at 0% 0%, rgba(var(--accent-primary-rgb), 0.1), rgba(var(--accent-primary-rgb), 0) 70%),
      radial-gradient(ellipse 60% 120% at 100% 100%, rgba(var(--accent-secondary-rgb), 0.08), rgba(var(--accent-secondary-rgb), 0) 70%),
      color-mix(in oklab, var(--bg-card) 72%, rgb(0 0 0 / 0));
    backdrop-filter: blur(18px) saturate(1.25);
    -webkit-backdrop-filter: blur(18px) saturate(1.25);
    box-shadow:
      0 30px 70px -30px rgb(0 0 0 / 0.6),
      0 0 70px -20px rgba(var(--accent-primary-rgb), calc(0.3 * var(--glow-a)));
    transition: background var(--transition-base), box-shadow var(--transition-base);
  }

  /* The top edge catches the light, in the accents the panel is setting */
  .mixer::before {
    content: '';
    position: absolute;
    inset: -1px 12% auto;
    height: 1px;
    background: linear-gradient(90deg,
      rgba(var(--accent-primary-rgb), 0),
      rgba(var(--accent-primary-rgb), 0.9) 35%,
      rgba(var(--accent-secondary-rgb), 0.9) 65%,
      rgba(var(--accent-secondary-rgb), 0));
    filter: drop-shadow(0 0 6px rgba(var(--accent-primary-rgb), 0.7));
  }

  .mixer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--divider);
  }

  .mixer__title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
  }

  .mixer__kbd {
    margin-inline-start: var(--space-xs);
  }

  .mixer__row {
    display: grid;
    grid-template-columns: auto auto auto;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-lg);
  }

  @media (max-width: 1100px) {
    .mixer__row {
      grid-template-columns: repeat(auto-fit, minmax(200px, auto));
    }
  }

  .mixer__ctl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .mixer__ctl--hue {
    flex-direction: row;
    align-items: center;
    gap: var(--space-md);
  }

  .mixer__readout {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: var(--space-2xs, 4px) var(--space-sm);
    text-align: start;
  }

  .mixer__readout .mixer__label {
    grid-column: 1 / -1;
  }

  .mixer__pair {
    display: inline-flex;
  }

  .mixer__dot {
    width: 16px;
    height: 16px;
    border-radius: var(--radius-full);
    border: 2px solid var(--bg-card);
    background: var(--accent-primary);
    box-shadow: 0 0 10px rgba(var(--accent-primary-rgb), 0.7);
  }

  .mixer__dot--b {
    margin-inline-start: -6px;
    background: var(--accent-secondary);
    box-shadow: 0 0 10px rgba(var(--accent-secondary-rgb), 0.7);
  }

  .mixer__hex {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    min-width: 16ch;
    white-space: pre;
  }

  /* The proof band: parts that take their color from the accents, so the
     dial visibly moves them */
  .mixer__follow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--divider);
  }

  .mixer__demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
  }

  .mixer__slider {
    width: 160px;
  }

  .mixer__label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ── Intro: the pitch and the rivers ── */
  .intro {
    position: relative;
    padding: var(--space-4xl) 0 var(--space-3xl);
    overflow: clip;
  }

  .intro__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .statement--center {
    align-items: center;
  }

  .intro__blurb {
    margin-top: var(--space-xl);
    max-width: 60ch;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .rivers {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0), rgb(0 0 0) 14%, rgb(0 0 0) 86%, rgb(0 0 0 / 0));
    -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0), rgb(0 0 0) 14%, rgb(0 0 0) 86%, rgb(0 0 0 / 0));
  }

  .river {
    overflow: hidden;
    padding-block: var(--space-md);
  }

  .river__track {
    display: flex;
    width: max-content;
    animation: river-drift 70s linear infinite;
  }

  .river--b .river__track {
    animation-duration: 84s;
    animation-direction: reverse;
  }

  .river:hover .river__track,
  .river:focus-within .river__track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .river__track { animation: none; }
  }

  /* Each track holds its set twice; moving it by exactly one set's width
     lands the second copy where the first began */
  @keyframes river-drift {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .river__set {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding-inline-end: var(--space-lg);
  }

  .spec {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 72px;
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.5), 0 0 40px -18px rgba(var(--accent-primary-rgb), calc(0.35 * var(--glow-a, 1)));
    flex-shrink: 0;
  }

  .spec--wide {
    min-width: 240px;
  }

  .spec--wide > * {
    flex: 1;
  }

  /* ── Prism: source → fan → outputs ──
     The rig is three columns sharing one height: the source window, the
     fan of light, and seven output rows in equal tracks. Equal tracks are
     what let ray i end on row i's center without measuring anything. */
  .prism {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: clip;
    background:
      radial-gradient(ellipse 50% 40% at 50% 46%, rgba(var(--accent-secondary-rgb), 0.07), rgba(var(--accent-secondary-rgb), 0) 70%);
  }

  .prism::before,
  .app::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--glow-line-gradient);
    opacity: 0.4;
  }

  .prism__inner,
  .app__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 var(--space-lg);
  }

  .prism__header,
  .app__header {
    margin-bottom: var(--space-2xl);
  }

  .prism__rig {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(64px, 0.26fr) minmax(0, 1fr);
    align-items: stretch;
  }

  .prism__source {
    margin: 0;
    min-width: 0;
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .prism__caption {
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding-inline: var(--space-xs);
  }

  .prism__fanwrap {
    position: relative;
  }

  .prism__fan {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }

  .prism__stop-a { stop-color: var(--accent-primary); }
  .prism__stop-b { stop-color: var(--accent-secondary); }

  .prism__in,
  .prism__ray {
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .prism__in {
    stroke: var(--accent-primary);
    stroke-width: 2.5;
    filter: drop-shadow(0 0 6px rgba(var(--accent-primary-rgb), 0.8));
  }

  .prism__ray {
    stroke: url(#prism-ray);
    stroke-width: 1.25;
    opacity: 0.32;
    transition: opacity var(--transition-base), stroke-width var(--transition-base);
  }

  .prism__ray.is-hover { opacity: 0.7; }

  .prism__ray.is-on {
    opacity: 1;
    stroke-width: 2.5;
    filter: drop-shadow(0 0 5px rgba(var(--accent-secondary-rgb), 0.9));
  }

  /* One authored moment: the beam arrives, then the rays fan out in order.
     Hidden only once script has confirmed it will play (the rig gets
     .is-lit from an observer), so no-script and reduced motion see it lit. */
  @media (prefers-reduced-motion: no-preference) {
    .prism__rig.is-armed:not(.is-lit) .prism__in,
    .prism__rig.is-armed:not(.is-lit) .prism__ray {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .prism__rig.is-lit .prism__in {
      stroke-dasharray: 1;
      animation: prism-draw 0.5s var(--ease-out, ease-out) both;
    }
    .prism__rig.is-lit .prism__ray {
      stroke-dasharray: 1;
      animation: prism-draw 0.9s var(--ease-out, ease-out) both;
      animation-delay: calc(0.4s + var(--i) * 70ms);
    }
  }

  @keyframes prism-draw {
    from { stroke-dashoffset: 1; }
    to   { stroke-dashoffset: 0; }
  }

  /* The prism itself: a lit point where the beam splits, sized in pixels
     so the stretched SVG can't distort it */
  .prism__node {
    position: absolute;
    top: 50%;
    left: 34%;
    width: 12px;
    height: 12px;
    translate: -50% -50%;
    rotate: 45deg;
    border-radius: 2px;
    background: var(--text-primary);
    box-shadow:
      0 0 10px rgba(var(--accent-primary-rgb), 0.9),
      0 0 28px rgba(var(--accent-secondary-rgb), 0.6);
    pointer-events: none;
  }

  .prism__outs {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    min-width: 0;
  }

  .out {
    display: grid;
    align-content: center;
    gap: 2px;
    min-width: 0;
    padding: var(--space-sm) var(--space-md);
    margin: 0;
    text-align: start;
    background: none;
    border: 1px solid rgba(var(--accent-secondary-rgb), 0);
    border-radius: var(--radius-md);
    cursor: pointer;
    color: inherit;
    transition: background var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .out:hover {
    background: var(--surface-hover, rgba(var(--accent-primary-rgb), 0.04));
  }

  .out.is-on {
    background: rgba(var(--accent-secondary-rgb), 0.07);
    border-color: rgba(var(--accent-secondary-rgb), 0.28);
    box-shadow: 0 0 24px -6px rgba(var(--accent-secondary-rgb), 0.35);
  }

  .out:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .out__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .out__name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .out__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .out__gets {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .out__line {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .out.is-on .out__line {
    color: var(--interactive);
  }

  /* The chosen file, whole. Capped and scrolled inside so a 130-line
     Angular wrapper doesn't push the page a screen further. */
  .prism__files {
    display: grid;
    margin-top: var(--space-xl);
  }

  .prism__file {
    grid-area: 1 / 1;
    min-width: 0;
  }

  /* The cap sits on the code itself, so the title bar and the status bar
     stay put and only the lines scroll */
  .prism__file arc-code-block::part(body) {
    max-height: 420px;
    overflow-y: auto;
    scrollbar-color: var(--border-bright) rgba(0, 0, 0, 0);
  }

  .prism__file[hidden] {
    display: none;
  }

  .prism__note {
    max-width: 72ch;
    margin-top: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* ── App: the issue tracker ── */
  .app {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: clip;
    background:
      radial-gradient(ellipse 60% 40% at 70% 58%, rgba(var(--accent-primary-rgb), 0.07), rgba(var(--accent-primary-rgb), 0) 70%);
  }

  .app__window {
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    overflow: clip;
    position: relative;
    box-shadow:
      0 40px 80px -40px rgb(0 0 0 / 0.6),
      0 0 80px -30px rgba(var(--accent-primary-rgb), calc(0.3 * var(--glow-a, 1)));
  }

  .app__window::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--lobe-line, linear-gradient(90deg, rgba(var(--accent-primary-rgb), 0), rgba(var(--accent-primary-rgb), 0.7), rgba(var(--accent-primary-rgb), 0)));
    z-index: 1;
  }

  .app__chrome {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
  }

  .app__title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .app__frame {
    display: grid;
    grid-template-columns: 236px minmax(0, 1fr);
    min-height: 600px;
  }

  .app__side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-inline-end: 1px solid var(--border-subtle);
    background: var(--bg-deep);
    padding-block: var(--space-sm);
    min-width: 0;
  }

  .app__cycle {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
  }

  .app__cycle-label {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
