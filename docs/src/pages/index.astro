<script>
  import { init as glintInit, arm } from '@arclux/glint/full';
  import '@arclux/glint/glint.css';
  import '@arclux/arc-ui/utilities.css';
  // arc-code-block is opt-in only (it lazy-loads a syntax highlighter), so
  // the register barrel deliberately skips it — without this import the
  // framework switcher's window never upgrades and the FOUC guard hides it.
  import '@arclux/arc-ui/code-block';
  import { initLightplay } from '../scripts/arc-lightplay.js';

  /* ── Lightplay hero ──
     One WebGL pass (scripts/arc-lightplay.js) draws the whole hero light
     system. It owns its own resize, visibility pause, reduced-motion still
     frame, and theme sync — including re-reading the accent tokens when the
     swatch demo writes them onto <html>'s style attribute — so all this page
     does is start it, reveal the hero behind the first frame, and dispose on
     navigation. */
  function initHero() {
    const canvas = document.querySelector('[data-lightplay]') as HTMLCanvasElement | null;
    if (!canvas) return;
    // Guard against double init: on first load both the direct call and
    // astro:page-load fire, and a second context on one canvas is a leak
    if ((canvas as any).__arcLightplay) return;
    (canvas as any).__arcLightplay = true;
    const dispose = initLightplay(canvas);
    const hero = canvas.closest('.hero');
    // Reveal on the frame after the shader's first draw, so load-time jank
    // happens behind the fade instead of in front of the visitor
    requestAnimationFrame(() => hero?.classList.add('hero--live'));
    document.addEventListener('astro:before-swap', () => dispose(), { once: true });

    /* The cluster reveals on its own signal: not when the shader is ready,
       but when the components it is showing have actually upgraded — fading
       in unstyled boxes that then pop into components was the old stream's
       documented failure. The timeout is not a nicety: a component that never
       registers must leave the cluster revealed slightly early, never
       invisible. */
    const cluster = hero?.querySelector('.hero__cluster');
    if (cluster) {
      const tags = [...new Set(
        [...cluster.querySelectorAll('*')]
          .map((el) => el.tagName.toLowerCase())
          .filter((t) => t.includes('-')),
      )];
      let done = false;
      const show = () => {
        if (done) return;
        done = true;
        requestAnimationFrame(() => hero?.classList.add('hero--cluster-live'));
      };
      Promise.all(tags.map((t) => customElements.whenDefined(t))).then(show);
      setTimeout(show, 2500);
    }
  }

  /* ── Reveal on scroll (glint) ──
     The revealed state is the default: glint hides at runtime, so a script
     failure leaves the page readable instead of blank. Reduced motion,
     focus-into-pending, and the forced-reveal ceiling all come with it.
     Durations and easing follow the ARC motion tokens (--duration-enter,
     --ease-out) via glint.css. */
  /* One controller per page view. astro:page-load fires on the initial load
     too, so without the guard this ran twice and the second init re-hid the
     elements the first had just revealed — the CTA banner faded in, blinked
     out, and faded back. The guard clears on before-swap so a soft
     navigation still gets a fresh controller. */
  let glint: ReturnType<typeof glintInit> | null = null;
  function initReveal() {
    if (glint) return;
    glint = glintInit();
    // arm() re-hides before a soft navigation swaps content in, so the page
    // navigated *to* gets the same flash-free entrance as a full load.
    document.addEventListener('astro:before-swap', () => {
      arm();
      glint?.destroy();
      glint = null;
    }, { once: true });
  }

  /* ── Utilities demo: one token moves everything. Spacing and radius scope
     to the stage — a scoped override is exactly how a consumer would use
     them, unlike the accents, whose compounds only recompose at :root ── */
  function initTokensDemo() {
    const stage = document.getElementById('tokens-demo-stage');
    if (!stage) return;
    const wire = (sliderId: string, readoutId: string, prop: string) => {
      const slider = document.getElementById(sliderId) as any;
      const readout = document.getElementById(readoutId);
      if (!slider || slider.dataset.demoInit) return;
      slider.dataset.demoInit = '1';
      slider.addEventListener('arc-input', (e: any) => {
        const v = Math.round(e.detail?.value ?? slider.value);
        stage.style.setProperty(prop, `${v}px`);
        if (readout) readout.textContent = `${v}px`;
      });
    };
    wire('tokens-demo-slider', 'tokens-demo-readout', '--space-md');
    wire('radius-slider', 'radius-readout', '--radius-lg');
  }

  /* ── Stat count-up ── */
  function initStatCountUp() {
    const nums = document.querySelectorAll('arc-animated-number[data-target]');
    if (!nums.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as any;
          const target = el.dataset.target;
          if (prefersReducedMotion) {
            el.value = target;
          } else {
            // Small delay for visual effect
            requestAnimationFrame(() => { el.value = target; });
          }
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.3 });

    nums.forEach(el => observer.observe(el));
  }

  /* ── Framework switcher: auto-advances until the visitor takes over ── */
  function initFwSwitcher() {
    const root = document.getElementById('fw-switcher');
    if (!root || (root as any).dataset.init) return;
    (root as any).dataset.init = '1';

    const btns = Array.from(root.querySelectorAll<HTMLElement>('.fw-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.fw-panel'));
    let idx = 0;
    let timer = 0;
    let userTouched = false;

    const show = (i: number) => {
      idx = i;
      btns.forEach((b, j) => {
        b.classList.toggle('is-active', i === j);
        b.setAttribute('aria-pressed', String(i === j));
      });
      panels.forEach((p, j) => p.toggleAttribute('hidden', i !== j));
    };

    const stop = () => {
      clearInterval(timer);
      timer = 0;
      root!.classList.remove('is-auto');
    };
    const start = () => {
      if (timer || userTouched) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // The class drives the timer bar under the active name, so the
      // auto-advance is visible instead of a surprise. The interval comes
      // from --fw-interval so the bar and the rotation stay one value.
      root!.classList.add('is-auto');
      const interval = (parseFloat(getComputedStyle(root!).getPropertyValue('--fw-interval')) || 6.5) * 1000;
      timer = window.setInterval(() => show((idx + 1) % btns.length), interval);
    };

    btns.forEach((b, i) => b.addEventListener('click', () => {
      userTouched = true;
      stop();
      show(i);
    }));

    const io = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { threshold: 0.3 },
    );
    io.observe(root);

    document.addEventListener('astro:before-swap', () => {
      stop();
      io.disconnect();
    }, { once: true });
  }

  /* ── Accent swatches: the theme.css panel rewrites itself, and the
     override applies at :root — the real consumer recipe, applied for real.
     Compound tokens compose on :root, so a scoped override would recolor
     direct var() uses and quietly skip every gradient, glow and focus ring;
     applying to documentElement is the demo that cannot lie. The lightplay
     shader needs no notifying: it watches <html>'s style attribute and
     re-reads the accent tokens itself. Cleanup on navigation keeps the
     override from following the visitor into docs. ── */
  function initAccentSwatches() {
    const group = document.getElementById('accent-swatches');
    if (!group || (group as any).dataset.init) return;
    (group as any).dataset.init = '1';

    const PROPS = ['--accent-primary', '--accent-primary-rgb', '--accent-secondary', '--accent-secondary-rgb'];
    document.addEventListener('astro:before-swap', () => {
      PROPS.forEach((prop) => document.documentElement.style.removeProperty(prop));
    }, { once: true });

    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.swatch');
      if (!btn) return;
      const { p, prgb, s, srgb } = btn.dataset;
      const root = document.documentElement.style;
      if (btn.dataset.default) {
        // The first swatch is the shipped theme: a real reset, not a repaint
        // that happens to match. Removing the override hands control back to
        // base.css, so light mode, .theme-fixed and future token changes all
        // resolve exactly as if the demo was never touched.
        PROPS.forEach((prop) => root.removeProperty(prop));
      } else {
        root.setProperty('--accent-primary', p!);
        root.setProperty('--accent-primary-rgb', prgb!);
        root.setProperty('--accent-secondary', s!);
        root.setProperty('--accent-secondary-rgb', srgb!);
      }
      const spaced = (rgb: string) => rgb.split(',').map((n) => n.trim()).join(', ');
      const vals: Record<string, string> = { p: p!, prgb: spaced(prgb!), s: s!, srgb: spaced(srgb!) };
      document.querySelectorAll<HTMLElement>('[data-theme-val]').forEach((el) => {
        el.textContent = vals[el.dataset.themeVal!] ?? el.textContent;
      });
      Array.from(group.children).forEach((c) => {
        c.classList.toggle('is-active', c === btn);
        c.setAttribute('aria-pressed', String(c === btn));
      });
    });
  }

  async function initNavigation() {
    // Document-level listener survives soft navigations; without the guard,
    // every astro:page-load stacked another copy and one click navigated N times.
    if ((window as any).__arcNavigate) return;
    (window as any).__arcNavigate = true;
    const { navigate } = await import('astro:transitions/client');
    document.addEventListener('arc-navigate', (e: any) => {
      const href = e.detail?.href;
      if (href) {
        e.preventDefault();
        navigate(href);
      }
    });
  }

  initHero();
  initReveal();
  initStatCountUp();
  initFwSwitcher();
  initTokensDemo();
  initAccentSwatches();
  initNavigation();
  document.addEventListener('astro:page-load', () => {
    initHero();
    initReveal();
    initStatCountUp();
    initFwSwitcher();
    initTokensDemo();
    initAccentSwatches();
    initNavigation();
  });
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: clip;
    padding: calc(var(--space-3xl) + 80px) var(--space-lg) var(--space-2xl);
    min-height: 85vh;
    display: flex;
    align-items: center;
    /* Two theme knobs survive the tunnel's departure: the copy's own glow
       follows --glow-a, and the cluster's components melt into the light via
       --stream-blend on dark (screen lifts their dark surfaces away) while
       light mode composites them normally. The shader handles its own
       light/dark internally. */
    --glow-a: 1;
    --stream-blend: screen;
  }

  :global([data-theme='light']) .hero {
    --glow-a: 0.4;
    --stream-blend: normal;
  }

  @media (prefers-color-scheme: light) {
    :global([data-theme='auto']) .hero {
      --glow-a: 0.4;
      --stream-blend: normal;
    }
  }

  /* ── Lightplay canvas ──
     The whole hero light system is one WebGL pass (scripts/arc-lightplay.js):
     nebula lobes, caustic fields, light shafts, motes, dot grid, grain. It
     composites premultiplied alpha over the page, so the body's own
     --bg-deep is the darkness the light plays in — there is no second
     background to keep in sync. */
  .hero__lightplay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .hero--live .hero__lightplay {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    /* The shader serves a static frame of its own; only the reveal shortens */
    .hero__lightplay {
      transition: opacity 0.6s ease;
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin-inline: auto;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: center;
    gap: var(--space-2xl) var(--space-3xl);
  }

  /* The claim, left-aligned; the proof sits beside it */
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: start;
    gap: var(--space-md);
    min-width: 0;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1;
  }

  .hero__headline-top {
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: 200;
    letter-spacing: -1px;
    color: var(--text-primary);
  }

  .hero__headline-glow-wrap {
    position: relative;
    display: block;
    padding-bottom: 12px;
  }

  .hero__headline-glow {
    position: relative;
    font-size: clamp(52px, 7.5vw, 104px);
    font-weight: 600;
    letter-spacing: -3px;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    z-index: 1;
  }

  /* The word the page is named for actually emits: the twin behind it is a
     layered bloom — hot white core, accent halo, wide secondary falloff —
     breathing on the hero's own glow knob so light mode stays calm. */
  .hero__headline-glow-shadow {
    position: absolute;
    inset: 0;
    font-size: clamp(52px, 7.5vw, 104px);
    font-weight: 600;
    letter-spacing: -3px;
    color: transparent;
    /* Dialled back now that the tunnel behind it blooms: the word was
       competing with its own backdrop and the two glows summed into haze.
       The falloff shape is unchanged, just quieter. */
    text-shadow:
      0 0 14px rgba(255, 255, 255, calc(0.2 * var(--glow-a, 1))),
      0 0 32px rgba(var(--accent-primary-rgb), calc(0.38 * var(--glow-a, 1))),
      0 0 70px rgba(var(--accent-primary-rgb), calc(0.26 * var(--glow-a, 1))),
      0 0 130px rgba(var(--accent-secondary-rgb), calc(0.22 * var(--glow-a, 1)));
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
    user-select: none;
    animation: hero-glow-breathe 5s ease-in-out infinite alternate;
  }

  @keyframes hero-glow-breathe {
    from { opacity: 0.62; }
    to   { opacity: 0.88; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__headline-glow-shadow {
      animation: none;
    }
  }

  .hero__body {
    color: var(--text-secondary);
    max-width: 46ch;
    text-wrap: pretty;
    font-size: var(--text-md);
    line-height: 1.7;
  }

  /* The hand-broken lines were written for a centered full-width hero; in a
     half column they re-wrap naturally, and only the kicker keeps its own
     line. */
  .hero__body-line {
    display: inline;
  }

  .hero__body-line--kicker {
    display: block;
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-sm);
  }

  /* ── Chapter type ──
     Every chapter opens the same way: eyebrow, a two-line statement with one
     lit line, one sentence. The statement is the section header now — there
     are no card grids to carry the argument, the artifact below it does. */
  .section-label {
    font-family: var(--font-accent);
    font-weight: var(--font-label-weight, 600);
    font-size: var(--text-xs);
    letter-spacing: var(--section-title-spacing, 4px);
    text-transform: uppercase;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .statement {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-sm);
    font-size: clamp(44px, 7vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .statement__quiet {
    font-weight: 200;
    color: var(--text-primary);
  }

  .statement__lit {
    font-weight: 600;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 28px rgba(var(--accent-primary-rgb), 0.28));
  }

  /* background-clip: text paints glyphs only where the element's box is —
     any line-height tighter than the glyph extents chops descenders. Every
     clipped element gets its paint box extended in em (so it scales with
     the type) and pulled back with margin so layout doesn't move. */
  .statement__lit,
  .statement__quiet,
  .fw-btn__name,
  .stat-custom__number,
  .hero__headline-glow {
    padding-block: 0.1em 0.2em;
    margin-block: -0.1em -0.2em;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: var(--text-md);
    max-width: 640px;
    text-wrap: balance;
    line-height: 1.7;
    margin-top: var(--space-md);
  }

  /* One claim per line where the copy is written that way; re-wrap naturally
     once the viewport can't hold a full sentence */
  .section-desc__line {
    display: block;
  }

  @media (max-width: 640px) {
    .section-desc__line {
      display: inline;
    }
  }

  .chapter-link {
    color: var(--interactive);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .chapter-link:hover {
    text-decoration: underline;
  }

  /* ── Hero cluster: the headline, demonstrated ──
     Real components floating in the shader's light. Positions are percentages
     of the cluster box, so the constellation compresses with its column.
     screen blend (dark) melts their dark surfaces away — forms made of
     light — and the tinted double drop-shadow is each item's own glow. */
  .hero__cluster {
    position: relative;
    min-height: 440px;
    min-width: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .hero--cluster-live .hero__cluster {
    opacity: 1;
  }

  .cluster-item {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w, auto);
    mix-blend-mode: var(--stream-blend);
    filter:
      saturate(1.3) brightness(1.1)
      drop-shadow(0 0 10px rgba(var(--tint), calc(0.55 * var(--glow-a))))
      drop-shadow(0 0 34px rgba(var(--tint), calc(0.3 * var(--glow-a))));
    animation: cluster-float var(--dur) ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }

  /* Durations share no common factor, so the nine never sync into a pulse */
  @keyframes cluster-float {
    from { transform: translateY(-5px); }
    to   { transform: translateY(6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cluster-item { animation: none; }
  }


  /* ── Native: the framework switcher ──
     Restored as its own full-width chapter — prism is a headline feature, but
     the hero's headline is the components. Ambient accent field, the
     framework names as a display-scale type stack, the code window in its own
     bloom of light. */
  .native {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: clip;
    /* Lobe centers sit far enough inside the box that the 70% fade completes
       before every edge — a radial clipped by the section boundary paints a
       hard seam straight across the page. */
    background:
      radial-gradient(ellipse 55% 45% at 12% 34%, rgba(var(--accent-primary-rgb), 0.08), transparent 70%),
      radial-gradient(ellipse 45% 48% at 92% 58%, rgba(var(--accent-secondary-rgb), 0.07), transparent 70%);
  }

  .native__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 var(--space-lg);
  }

  .native__header {
    margin-bottom: var(--space-2xl);
  }

  .native__grid {
    /* One value drives both the rotation interval (read by the switcher
       script) and the timer-bar animation. Seconds only. */
    --fw-interval: 6.5s;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: var(--space-2xl);
    align-items: center;
  }

  .fw-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

