---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteTopBar from '../components/SiteTopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { components } from '../data/components/index';
import {
  buildSteps, tokenCount, testCount, utilityClassCount, elementCount, version,
  generatedFileCount, generatedLineCount, prismVersion, frameworkCount,
} from '../data/site-stats';
import fs from 'node:fs';
import { anchorFor, compareVersionsDesc } from '../lib/releases';
import { armSnippet } from '@arclux/glint/full';
import { tokens } from '../../../shared/tokens.js';

// The "what changed" chapter is the newest entry in the releases collection,
// the same source /docs/changelog renders, so it can never claim a version
// the changelog doesn't have, and it rewrites itself the moment the next
// release note lands. The lead is the note's own first paragraph with inline
// markdown flattened to prose; the topics are its section headings.
const latestRelease = (await getCollection('releases')).sort((a, b) =>
  compareVersionsDesc(a.data.version, b.data.version),
)[0];
const stripInlineMd = (s: string) =>
  s
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/`([^`]*)`/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
const releaseLead = stripInlineMd(
  latestRelease.body!.trim().split(/\n\s*\n/)[0] ?? '',
);
// The note's own headings carry a "Breaking — " category prefix that earns
// its place in the full notes and only adds a wrapped line here; the digest
// strips it, and drops the catch-all closing section.
const releaseTopics = [...latestRelease.body!.matchAll(/^###\s+(.+)$/gm)]
  .map((m) => stripInlineMd(m[1]))
  .map((t) => t.replace(/^(?:Breaking|Changed|New|Fixed|Removed|Deprecated)\s+—\s+/i, ''))
  .filter((t) => !/^also in this release$/i.test(t));
const releaseHref = `/docs/changelog#${anchorFor(latestRelease.data.version)}`;
const releaseDate = new Date(`${latestRelease.data.date}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// The console's first swatch IS the shipped theme, read from the token source
// so it can never drift from what the page is actually wearing. Clicking it
// removes the override entirely (see initAccentSwatches), a real reset.
const rgbToHex = (rgb: string) =>
  '#' + (rgb.match(/\d+/g) ?? []).map((n) => (+n).toString(16).padStart(2, '0')).join('');
const defaultAccent = {
  p: rgbToHex(tokens.color.accentPrimary),
  prgb: tokens.rgb.accentPrimary,
  s: rgbToHex(tokens.color.accentSecondary),
  srgb: tokens.rgb.accentSecondary,
};

// ── Prism chapter ──
// One real component in, its real generated files out, all read at build
// time. The excerpt is toggle.js's own declaration with the comments
// dropped; each output's highlighted line is found by pattern in the file
// Prism actually wrote, and the build fails if one stops matching, so the
// chapter can never show a line the packages don't contain.
const pkgFile = (p: string) =>
  fs.readFileSync(new URL(`../../../packages/${p}`, import.meta.url), 'utf-8');
const toggleSrc = pkgFile('web-components/src/input/toggle.js');
const toggleFires = toggleSrc.match(/ \* @fires \{.+?\}> ?\} arc-change/)?.[0];
const toggleProps = toggleSrc.match(/  static properties = \{[\s\S]*?\n  \};/)?.[0];
if (!toggleFires || !toggleProps) throw new Error('index.astro: toggle.js excerpt no longer matches');
const prismSource = [
  `/**`,
  ` * @tag arc-toggle`,
  toggleFires,
  ` */`,
  `export class ArcToggle extends`,
  `  DeclaredPropsMixin(FormControlMixin(LitElement)) {`,
  toggleProps
    .split('\n')
    .filter((l) => l.trim() && !l.trim().startsWith('//'))
    .join('\n'),
  `}`,
].join('\n');

const prismOutputs = [
  { id: 'react', name: 'React', path: 'react/src/input/Toggle.ts', lang: 'ts',
    gets: 'Typed props and an onArcChange handler', key: /onArcChange: 'arc-change'[^,\n]*/ },
  { id: 'vue', name: 'Vue', path: 'vue/src/input/Toggle.vue', lang: 'html',
    gets: 'v-model:checked, read from the event’s detail', key: /'update:checked': \[value: boolean\]/ },
  { id: 'svelte', name: 'Svelte', path: 'svelte/src/input/Toggle.svelte', lang: 'html',
    gets: 'bind:checked, as a Svelte 5 rune', key: /checked = \$bindable\(\)/ },
  { id: 'angular', name: 'Angular', path: 'angular/src/input/Toggle.ts', lang: 'ts',
    gets: 'A ControlValueAccessor, so reactive forms just work', key: /class Toggle implements ControlValueAccessor/ },
  { id: 'solid', name: 'Solid', path: 'solid/src/input/Toggle.tsx', lang: 'tsx',
    gets: 'Events bound straight to the element', key: /on:arc-change=\{local\.onArcChange\}/ },
  { id: 'preact', name: 'Preact', path: 'preact/src/input/Toggle.tsx', lang: 'tsx',
    gets: 'A forwardRef that wires the events for you', key: /el\.addEventListener\('arc-change', fn\)/ },
  { id: 'html', name: 'HTML', path: 'web-components/src/input/toggle.register.js', lang: 'js',
    gets: 'No wrapper at all: the element registers itself', key: /customElements\.define\('arc-toggle', ArcToggle\)/ },
].map((o) => {
  const code = pkgFile(o.path).trimEnd();
  const line = code.match(o.key)?.[0];
  if (!line) throw new Error(`index.astro: no ${o.key} in ${o.path}`);
  return { ...o, code, line, lines: code.split('\n').length, file: o.path.split('/').pop()! };
});
const prismDefault = 1; // Vue: the output that shows the most derivation

// ── App chapter ──
// The issue tracker's data. The list is rendered here, on the server; the
// board, the sheet and every change after load are driven from the same
// array in the page script (serialized into #app-data).
const appStatuses = [
  { id: 'todo', label: 'To do', variant: 'default' },
  { id: 'doing', label: 'In progress', variant: 'primary' },
  { id: 'review', label: 'In review', variant: 'secondary' },
  { id: 'done', label: 'Done', variant: 'success' },
];
const appIssues = [
  { id: 'ARC-198', title: 'Sheet snap points jitter on iOS Safari', who: 'Nina Park', status: 'review', priority: 'Urgent', points: 2,
    body: 'Dragging past the middle snap point overshoots by a few pixels and settles back. Only in Safari, only with the toolbar collapsed.' },
  { id: 'ARC-201', title: 'Cache keys drop the locale segment', who: 'Rio Kim', status: 'doing', priority: 'High', points: 3,
    body: 'Two locales of the same page share a cache entry at the edge, so the second visitor gets the first one’s language.' },
  { id: 'ARC-209', title: 'Empty state for the audit log', who: 'Ava Lane', status: 'doing', priority: 'Low', points: 1,
    body: 'A new workspace opens the audit log to a blank table. It should say what will appear there and when.' },
  { id: 'ARC-204', title: 'Contrast of disabled selects in dark mode', who: 'Ava Lane', status: 'todo', priority: 'Medium', points: 1,
    body: 'The disabled trigger falls to 2.9:1 against the card surface. Lift it to the same step the disabled input uses.' },
  { id: 'ARC-207', title: 'Keyboard reordering for pinned tabs', who: 'Nina Park', status: 'todo', priority: 'Low', points: 2,
    body: 'Pinned tabs can be dragged but not moved from the keyboard. Alt and the arrow keys should move the focused tab.' },
  { id: 'ARC-190', title: 'Promote canary builds automatically', who: 'Sam Ortiz', status: 'done', priority: 'High', points: 5,
    body: 'A canary that holds its error budget for thirty minutes is promoted to production without a manual step.' },
  { id: 'ARC-195', title: 'Retry budget for edge deploys', who: 'Rio Kim', status: 'done', priority: 'Medium', points: 3,
    body: 'Failed edge pushes retry with backoff up to a per-deploy budget instead of retrying forever.' },
  { id: 'ARC-188', title: 'Move billing to the v2 API', who: 'Sam Ortiz', status: 'done', priority: 'High', points: 8,
    body: 'Invoices, usage and payment methods all read from v2. The v1 endpoints stay up, read-only, until the cycle ends.' },
];
const statusOf = (id: string) => appStatuses.find((s) => s.id === id)!;
const appPeople = [...new Set(appIssues.map((i) => i.who))];
// Open work per person, for the rail's bar list
const appLoad = appPeople
  .map((who) => ({
    label: who.split(' ')[0],
    value: appIssues.filter((i) => i.who === who && i.status !== 'done').reduce((n, i) => n + i.points, 0),
  }))
  .sort((a, b) => b.value - a.value);
const appDone = appIssues.filter((i) => i.status === 'done').length;
// Each tag links to its component's page, so "built from" is a list of
// places to go, not a boast
const appParts = [
  'sidebar', 'page-header', 'breadcrumb', 'search', 'segmented-control', 'list', 'avatar', 'tag',
  'kanban', 'chart', 'bar-list', 'progress', 'sheet', 'description-list', 'timeline', 'dialog',
  'input', 'select', 'textarea', 'button', 'toast',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ARC UI',
  description: `${components.length} dark-first Lit Web Components, generated natively by Prism for React, Vue, Svelte, Angular, Solid, Preact, and plain HTML.`,
  url: 'https://arcui.dev',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  softwareVersion: version,
  license: 'https://opensource.org/license/mit',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

---

<BaseLayout description={jsonLd.description}>
  {/* Glint's pre-hide, inlined before any data-reveal element is parsed: the
      reveal-on-scroll elements otherwise paint for a frame before the runtime
      hides them, which reads as a blip (worst on reload, where scroll
      restoration can drop the visitor straight onto the CTA banner). The rule
      self-expires, so a failed script leaves the page readable. */}
  <script is:inline set:html={armSnippet()} />
  <!-- Top Bar: shared with DocsLayout via SiteTopBar; immersive makes it
       transparent over the hero and (inside the component) theme-following
       instead of theme-fixed, so light mode stays readable. -->
  <SiteTopBar immersive mobileMenu="nav" />

  <!-- Hero -->
  <header class="hero">
    <!-- The whole light system is one WebGL canvas: plasma filaments and
         caustic shimmer, chromatic fringes, per-pixel film grain, all in
         arc-lightplay.js. It reads the two accent tokens live and re-reads
         them whenever <html>'s data-theme/class/style mutate, so the swatch
         demo and the theme toggle recolor it with zero wiring here. -->
    <canvas class="hero__lightplay" data-lightplay aria-hidden="true"></canvas>
    <!-- A soft wash of the page's own ground behind the copy: the light
         stays loud at the edges and quiet where people read. -->
    <div class="hero__wash" aria-hidden="true"></div>
    <!-- The claim, centered, and a mixer whose three controls are the real
         theming inputs, applied to the whole page -->
    <div class="hero__content">
      <div class="hero__copy hero__copy--center">
        <h1 class="hero__headline hero__headline--xl">
          <span class="hero__headline-top">Light work</span>
          <span class="hero__headline-glow-wrap">
            <span class="hero__headline-glow">for heavy apps.</span>
            <span class="hero__headline-glow-shadow" aria-hidden="true">for heavy apps.</span>
          </span>
        </h1>
        <p class="hero__body">
          {components.length} components for the screens people actually use: tables, forms, settings,
          the fourth modal. {frameworkCount} framework targets, two colors, glow included.
        </p>
        <arc-code-block variant="basic" language="bash" code="npm install @arclux/arc-ui lit"></arc-code-block>
        <div class="hero__actions">
          <arc-button href="/docs/getting-started" variant="primary" size="md">
            Get Started
            <svg slot="suffix" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </arc-button>
          <arc-button href="/docs/components" variant="secondary" size="md">Browse all {components.length}</arc-button>
        </div>
      </div>
      <!-- The mixer: the theme's real inputs, applied to the whole page, the
           light included. Reset (or Esc inside it) puts everything back. -->
      <div class="mixer" id="hero-mixer" role="group" aria-labelledby="mixer-title">
        <div class="mixer__head">
          <span class="mixer__title" id="mixer-title">Take it for a spin</span>
          <arc-button id="mixer-reset" class="mixer__reset" variant="ghost" size="sm" disabled>
            <svg slot="prefix" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9M2.5 2.5v3h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Reset <arc-kbd class="mixer__kbd">Esc</arc-kbd>
          </arc-button>
        </div>
        <div class="mixer__row">
          <div class="mixer__ctl mixer__ctl--hue">
            <arc-knob id="hero-hue" size="sm" min="0" max="359" step="1" value="0" aria-label="Accent hue"></arc-knob>
            <div class="mixer__readout">
              <span class="mixer__label">Accents</span>
              <span class="mixer__pair" aria-hidden="true"><i class="mixer__dot mixer__dot--a"></i><i class="mixer__dot mixer__dot--b"></i></span>
              <code class="mixer__hex" id="mixer-hex" aria-live="polite"></code>
            </div>
          </div>
          <div class="mixer__ctl">
            <span class="mixer__label">Density</span>
            <arc-segmented-control id="hero-density" value="default" aria-label="Density">
              <arc-option value="compact">Compact</arc-option>
              <arc-option value="default">Default</arc-option>
              <arc-option value="comfortable">Roomy</arc-option>
            </arc-segmented-control>
          </div>
          <div class="mixer__ctl">
            <span class="mixer__label">Scheme</span>
            <arc-theme-toggle id="hero-scheme"></arc-theme-toggle>
          </div>
        </div>
        <div class="mixer__follow">
          <span class="mixer__label">Everything follows</span>
          <div class="mixer__demo">
            <arc-toggle checked size="sm" label="Alerts"></arc-toggle>
            <arc-checkbox checked size="sm" label="Auto-deploy"></arc-checkbox>
            <arc-slider class="mixer__slider" aria-label="Rollout" min="0" max="100" value="64"></arc-slider>
            <arc-tag variant="primary" size="sm">Canary</arc-tag>
            <arc-button variant="primary" size="sm">Deploy</arc-button>
          </div>
        </div>
      </div>
    </div>

  </header>

  <main>
    <arc-divider></arc-divider>

    <!-- Intro: the pitch, then the library drifting past as two rivers of
         live components. Each river is its set twice, the second copy inert,
         so the loop is seamless and nothing is focusable twice. Hover or focus
         stops the drift so a control can be used; reduced motion stills it. -->
    <section class="intro">
      <div class="intro__inner" data-reveal="blur-in">
        <h2 class="statement statement--center">
          <span class="statement__quiet">Easy on the eyes.</span>
          <span class="statement__lit">Hard to break.</span>
        </h2>
        <p class="intro__blurb">
          Every component works from the keyboard, renders on the server and follows the same two
          color tokens. There are {testCount.toLocaleString('en-US')} tests, so you don't find out the hard way.
        </p>
      </div>
      <div class="rivers" data-reveal="fade-up">
          <div class="river river--a">
            <div class="river__track">
              <div class="river__set">
<span class="spec"><arc-toggle checked label="Glow"></arc-toggle></span>
<span class="spec spec--wide"><arc-slider aria-label="Intensity" min="0" max="100" value="64"></arc-slider></span>
<span class="spec"><arc-rating value="4" label="Rating"></arc-rating></span>
<span class="spec"><arc-segmented-control value="week" aria-label="Range"><arc-option value="day">Day</arc-option><arc-option value="week">Week</arc-option><arc-option value="month">Month</arc-option></arc-segmented-control></span>
<span class="spec"><arc-avatar-group max="3"><arc-avatar name="Nina Park" size="sm"></arc-avatar><arc-avatar name="Rio Kim" size="sm"></arc-avatar><arc-avatar name="Ava Lane" size="sm"></arc-avatar><arc-avatar name="Sam Ortiz" size="sm"></arc-avatar></arc-avatar-group></span>
<span class="spec"><arc-button variant="primary" size="sm">Deploy</arc-button></span>
<span class="spec spec--wide"><arc-progress value="72" label="Build" show-value></arc-progress></span>
<span class="spec"><arc-badge variant="success">Live</arc-badge><arc-badge variant="primary">Pro</arc-badge><arc-badge variant="warning">Beta</arc-badge></span>
<span class="spec"><arc-knob size="sm" value="40" aria-label="Gain"></arc-knob></span>
              </div>
              <div class="river__set" inert aria-hidden="true">
<span class="spec"><arc-toggle checked label="Glow"></arc-toggle></span>
<span class="spec spec--wide"><arc-slider aria-label="Intensity" min="0" max="100" value="64"></arc-slider></span>
<span class="spec"><arc-rating value="4" label="Rating"></arc-rating></span>
<span class="spec"><arc-segmented-control value="week" aria-label="Range"><arc-option value="day">Day</arc-option><arc-option value="week">Week</arc-option><arc-option value="month">Month</arc-option></arc-segmented-control></span>
<span class="spec"><arc-avatar-group max="3"><arc-avatar name="Nina Park" size="sm"></arc-avatar><arc-avatar name="Rio Kim" size="sm"></arc-avatar><arc-avatar name="Ava Lane" size="sm"></arc-avatar><arc-avatar name="Sam Ortiz" size="sm"></arc-avatar></arc-avatar-group></span>
<span class="spec"><arc-button variant="primary" size="sm">Deploy</arc-button></span>
<span class="spec spec--wide"><arc-progress value="72" label="Build" show-value></arc-progress></span>
<span class="spec"><arc-badge variant="success">Live</arc-badge><arc-badge variant="primary">Pro</arc-badge><arc-badge variant="warning">Beta</arc-badge></span>
<span class="spec"><arc-knob size="sm" value="40" aria-label="Gain"></arc-knob></span>
              </div>
            </div>
          </div>
          <div class="river river--b">
            <div class="river__track">
              <div class="river__set">
<span class="spec"><arc-stat size="sm" value="99.98%" label="Uptime"></arc-stat></span>
<span class="spec"><arc-checkbox checked label="Notify the team"></arc-checkbox></span>
<span class="spec spec--wide"><arc-sparkline data="4,6,5,8,7,11,9,13,12,16,15,19" fill height="40" width="180"></arc-sparkline></span>
<span class="spec"><arc-kbd>⌘</arc-kbd><arc-kbd>K</arc-kbd></span>
<span class="spec"><arc-chip selected>Design</arc-chip><arc-chip>Backend</arc-chip></span>
<span class="spec"><arc-gauge value="72" unit="%" variant="half" label="CPU" low="30" high="85" optimum="50"></arc-gauge></span>
<span class="spec"><arc-tag variant="secondary">v4.8</arc-tag><arc-tag variant="default">MIT</arc-tag></span>
<span class="spec"><arc-spinner size="md"></arc-spinner></span>
<span class="spec"><arc-pagination total="9" current="3" compact></arc-pagination></span>
              </div>
              <div class="river__set" inert aria-hidden="true">
<span class="spec"><arc-stat size="sm" value="99.98%" label="Uptime"></arc-stat></span>
<span class="spec"><arc-checkbox checked label="Notify the team"></arc-checkbox></span>
<span class="spec spec--wide"><arc-sparkline data="4,6,5,8,7,11,9,13,12,16,15,19" fill height="40" width="180"></arc-sparkline></span>
<span class="spec"><arc-kbd>⌘</arc-kbd><arc-kbd>K</arc-kbd></span>
<span class="spec"><arc-chip selected>Design</arc-chip><arc-chip>Backend</arc-chip></span>
<span class="spec"><arc-gauge value="72" unit="%" variant="half" label="CPU" low="30" high="85" optimum="50"></arc-gauge></span>
<span class="spec"><arc-tag variant="secondary">v4.8</arc-tag><arc-tag variant="default">MIT</arc-tag></span>
<span class="spec"><arc-spinner size="md"></arc-spinner></span>
<span class="spec"><arc-pagination total="9" current="3" compact></arc-pagination></span>
              </div>
            </div>
          </div>
      </div>
    </section>

    <!-- Prism: one real source in, its seven real outputs out. Every line of
         code in this chapter is read from the repository at build time. -->
    <section class="prism">
      <div class="prism__inner">
        <div class="prism__header" data-reveal="blur-in">
          <h2 class="statement">
            <span class="statement__quiet">You write the component.</span>
            <span class="statement__lit">Prism writes the rest.</span>
          </h2>
          <p class="section-desc">
            <span class="section-desc__line">Prism imports each Lit class, reads the properties Lit resolved, and writes an idiomatic package for every framework.</span>
            <span class="section-desc__line">Here is one component, and what came out.</span>
          </p>
        </div>

        <div class="prism__rig" id="prism-rig" data-reveal="fade-up">
          <figure class="prism__source">
            <arc-code-block variant="window" filename="toggle.js" language="js" code={prismSource}></arc-code-block>
            <figcaption class="prism__caption">The declaration, as written. Nothing else is.</figcaption>
          </figure>

          <!-- The fan: one beam in, a ray to every output row. The rows share
               the rig's height in equal tracks, so ray i always lands on row
               i's center with no measuring. -->
          <div class="prism__fanwrap">
          <svg class="prism__fan" viewBox="0 0 100 700" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="prism-ray" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" class="prism__stop-a" />
                <stop offset="1" class="prism__stop-b" />
              </linearGradient>
            </defs>
            <path class="prism__in" d="M0 350 H34" pathLength="1" />
            {prismOutputs.map((_, i) => (
              <path
                class:list={['prism__ray', { 'is-on': i === prismDefault }]}
                data-ray={i}
                style={`--i:${i}`}
                d={`M34 350 C 62 350, 64 ${(i + 0.5) * 100}, 100 ${(i + 0.5) * 100}`}
                pathLength="1"
              />
            ))}
          </svg>
          <span class="prism__node" aria-hidden="true"></span>
          </div>

          <div class="prism__outs" role="group" aria-label="Generated output">
            {prismOutputs.map((o, i) => (
              <button
                class:list={['out', { 'is-on': i === prismDefault }]}
                aria-pressed={i === prismDefault ? 'true' : 'false'}
                aria-controls={`prism-file-${o.id}`}
                data-out={i}
              >
                <span class="out__head">
                  <span class="out__name">{o.name}</span>
                  <span class="out__meta">{o.file} · {o.lines} lines</span>
                </span>
                <span class="out__gets">{o.gets}</span>
                <code class="out__line">{o.line}</code>
              </button>
            ))}
          </div>
        </div>

        <div class="prism__files" data-reveal="fade-up">
          {prismOutputs.map((o, i) => (
            <div class="prism__file" id={`prism-file-${o.id}`} data-file={i} hidden={i !== prismDefault}>
              <arc-code-block variant="window" filename={`packages/${o.path}`} language={o.lang} code={o.code}></arc-code-block>
            </div>
          ))}
        </div>

        <p class="prism__note" data-reveal="fade-up">
          Across all {components.length} components that comes to {generatedFileCount.toLocaleString('en-US')} files
          and {generatedLineCount.toLocaleString('en-US')} lines of framework code, written by Prism {prismVersion}.
          CI regenerates every one on each push and fails on a single changed character.
          <a class="chapter-link" href="/docs/frameworks">Framework guides →</a>
        </p>
      </div>
    </section>

    <!-- The app: one full screen of a working product, every part an ARC
         component. The list is server-rendered; the script drives the board,
         the sheet, the dialog and the toast from #app-data. -->
    <section class="app">
      <div class="app__inner">
        <div class="app__header" data-reveal="blur-in">
          <h2 class="statement">
            <span class="statement__quiet">Not a mockup.</span>
            <span class="statement__lit">A working app.</span>
          </h2>
          <p class="section-desc">
