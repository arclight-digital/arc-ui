---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteTopBar from '../components/SiteTopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { components } from '../data/components/index';
import { buildSteps, tokenCount, testCount, utilityClassCount, elementCount, version } from '../data/site-stats';
import { anchorFor, compareVersionsDesc } from '../lib/releases';
import { armSnippet } from '@arclux/glint/full';
import { tokens } from '../../../shared/tokens.js';

// The "what changed" chapter is the newest entry in the releases collection —
// the same source /docs/changelog renders — so it can never claim a version
// the changelog doesn't have, and it rewrites itself the moment the next
// release note lands. The lead is the note's own first paragraph with inline
// markdown flattened to prose; the topics are its section headings.
const latestRelease = (await getCollection('releases')).sort((a, b) =>
  compareVersionsDesc(a.data.version, b.data.version),
)[0];
const stripInlineMd = (s: string) =>
  s
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/`([^`]*)`/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
const releaseLead = stripInlineMd(
  latestRelease.body!.trim().split(/\n\s*\n/)[0] ?? '',
);
// The note's own headings carry a "Breaking — " category prefix that earns
// its place in the full notes and only adds a wrapped line here; the digest
// strips it, and drops the catch-all closing section.
const releaseTopics = [...latestRelease.body!.matchAll(/^###\s+(.+)$/gm)]
  .map((m) => stripInlineMd(m[1]))
  .map((t) => t.replace(/^(?:Breaking|Changed|New|Fixed|Removed|Deprecated)\s+—\s+/i, ''))
  .filter((t) => !/^also in this release$/i.test(t));
const releaseHref = `/docs/changelog#${anchorFor(latestRelease.data.version)}`;
const releaseDate = new Date(`${latestRelease.data.date}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// The console's first swatch IS the shipped theme, read from the token source
// so it can never drift from what the page is actually wearing. Clicking it
// removes the override entirely (see initAccentSwatches) — a real reset.
const rgbToHex = (rgb: string) =>
  '#' + (rgb.match(/\d+/g) ?? []).map((n) => (+n).toString(16).padStart(2, '0')).join('');
const defaultAccent = {
  p: rgbToHex(tokens.color.accentPrimary),
  prgb: tokens.rgb.accentPrimary,
  s: rgbToHex(tokens.color.accentSecondary),
  srgb: tokens.rgb.accentSecondary,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ARC UI',
  description: `${components.length} dark-first Lit Web Components, generated natively by Prism for React, Vue, Svelte, Angular, Solid, Preact, and plain HTML.`,
  url: 'https://arcui.dev',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  softwareVersion: version,
  license: 'https://opensource.org/license/mit',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

// Every line stays under ~56 characters so the window never scrolls or clips
// in its hero column — a cut-off import line reads as a broken site, not as
// "there is more code". The multi-line import is what makes that hold.
const codeExamples = {
  react: `import {
  Button, Card, Input, Toggle,
} from '@arclux/arc-ui-react';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save</Button>
    </Card>
  );
}`,
  vue: `<template>
  <Card>
    <h3>Preferences</h3>
    <Input label="Display name" />
    <Toggle label="Dark mode" :checked="true" />
    <Button variant="primary">Save</Button>
  </Card>
</template>

<script setup>
import {
  Button, Card, Input, Toggle,
} from '@arclux/arc-ui-vue';
</script>`,
  svelte: `<script>
  import {
    Button, Card, Input, Toggle,
  } from '@arclux/arc-ui-svelte';
</script>

<Card>
  <h3>Preferences</h3>
  <Input label="Display name" />
  <Toggle label="Dark mode" checked />
  <Button variant="primary">Save</Button>
</Card>`,
  angular: `import { Component } from '@angular/core';
import {
  Button, Card, Input, Toggle,
} from '@arclux/arc-ui-angular';

@Component({
  selector: 'app-settings',
  imports: [Button, Card, Input, Toggle],
  template: \`
    <arc-card>
      <h3>Preferences</h3>
      <arc-input label="Display name"></arc-input>
      <arc-toggle label="Dark mode" checked></arc-toggle>
      <arc-button variant="primary">Save</arc-button>
    </arc-card>
  \`,
})
export class SettingsComponent {}`,
  solid: `import {
  Button, Card, Input, Toggle,
} from '@arclux/arc-ui-solid';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save</Button>
    </Card>
  );
}`,
  preact: `import {
  Button, Card, Input, Toggle,
} from '@arclux/arc-ui-preact';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save</Button>
    </Card>
  );
}`,
  html: `<arc-card>
  <h3>Preferences</h3>
  <arc-input label="Display name"></arc-input>
  <arc-toggle label="Dark mode" checked></arc-toggle>
  <arc-button variant="primary">Save</arc-button>
</arc-card>

<script type="module">
  import '@arclux/arc-ui/register';
</script>`
};

// The active framework's one-line proof, shown under its lit name in the
// switcher. Raw HTML: the <em> marks the binding syntax itself.
const idioms = {
  react: '<em>onArcInput</em>={e => setV(e.detail.value)}',
  vue: '<em>v-model:value</em>="volume"',
  svelte: '<em>bind:value</em>={volume}',
  angular: '<em>[(value)]</em>="volume"',
  solid: '<em>on:arc-input</em>={handle}',
  preact: '<em>onArcInput</em>={handle}',
  html: 'no build step at all',
} as Record<string, string>;

const fwTabs: Array<[keyof typeof codeExamples, string, string, string]> = [
  ['react', 'React', 'App.jsx', 'jsx'],
  ['vue', 'Vue', 'App.vue', 'html'],
  ['svelte', 'Svelte', 'App.svelte', 'html'],
  ['angular', 'Angular', 'settings.component.ts', 'ts'],
  ['solid', 'Solid', 'Settings.jsx', 'jsx'],
  ['preact', 'Preact', 'Settings.jsx', 'jsx'],
  ['html', 'HTML', 'index.html', 'html'],
];
---

<BaseLayout description={jsonLd.description}>
  {/* Glint's pre-hide, inlined before any data-reveal element is parsed: the
      reveal-on-scroll elements otherwise paint for a frame before the runtime
      hides them, which reads as a blip — worst on reload, where scroll
      restoration can drop the visitor straight onto the CTA banner. The rule
      self-expires, so a failed script leaves the page readable. */}
  <script is:inline set:html={armSnippet()} />
  <!-- Top Bar — shared with DocsLayout via SiteTopBar; immersive makes it
       transparent over the hero and (inside the component) theme-following
       instead of theme-fixed, so light mode stays readable. -->
  <SiteTopBar immersive mobileMenu="nav" />

  <!-- Hero -->
  <header class="hero">
    <!-- The whole light system is one WebGL pass: nebula lobes, caustic
         fields, light shafts, drifting motes, the dot grid, grain — all in
         arc-lightplay.js. It reads the two accent tokens live and re-reads
         them whenever <html>'s data-theme/class/style mutate, so the swatch
         demo and the theme toggle recolor it with zero wiring here. -->
    <canvas class="hero__lightplay" data-lightplay aria-hidden="true"></canvas>
    <div class="hero__content">
      <div class="hero__copy">
        <h1 class="hero__headline">
          <span class="hero__headline-top">Components that</span>
          <span class="hero__headline-glow-wrap">
            <span class="hero__headline-glow">glow.</span>
            <span class="hero__headline-glow-shadow" aria-hidden="true">glow.</span>
          </span>
        </h1>
        <p class="hero__body">
          <span class="hero__body-line">{components.length} dark-first components, written once as standard Web&nbsp;Components</span>
          <span class="hero__body-line">and generated into native packages for seven&nbsp;frameworks.</span>
          <span class="hero__body-line hero__body-line--kicker">Change framework without changing your design&nbsp;system.</span>
        </p>
        <arc-code-block variant="basic" language="bash" code="npm install @arclux/arc-ui"></arc-code-block>
        <div class="hero__actions">
          <arc-button href="/docs/getting-started" variant="primary" size="md">
            Get Started
            <svg slot="suffix" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </arc-button>
          <arc-button href="/docs/components" variant="secondary" size="md">Explore Components</arc-button>
        </div>
      </div>

      <!-- The proof of the headline: real components, live and glowing in
           the shader's light. Interactive for real — the toggle toggles, the
           slider slides. Reveals only once its elements have upgraded (see
           initHero): fading in unstyled boxes was the old stream's
           documented failure, and the same rule holds here. -->
      <div class="hero__cluster">
        <div class="cluster-item" style="--x:38%; --y:0%;  --dur:12.5s; --delay:-4s;   --tint:var(--accent-primary-rgb)">
          <arc-badge variant="success">Stable</arc-badge>
        </div>
        <div class="cluster-item" style="--x:60%; --y:8%;  --dur:9s;    --delay:-2s;   --tint:var(--accent-primary-rgb)">
          <arc-stat value={String(components.length)} label="Components" trend="up" change="+7"></arc-stat>
        </div>
        <div class="cluster-item" style="--x:4%;  --y:14%; --dur:10.5s; --delay:-7s;   --tint:var(--accent-secondary-rgb)">
          <arc-toggle checked label="Dark mode"></arc-toggle>
        </div>
        <div class="cluster-item" style="--x:26%; --y:36%; --dur:11s;   --delay:-9s;   --z:1; --w:200px; --tint:var(--accent-primary-rgb)">
          <arc-slider value="64" label="Glow"></arc-slider>
        </div>
        <div class="cluster-item" style="--x:83%; --y:48%; --dur:7.5s;  --delay:-1s;   --tint:var(--accent-secondary-rgb)">
          <arc-avatar name="Arc Light" status="online"></arc-avatar>
        </div>
        <div class="cluster-item" style="--x:2%;  --y:48%; --dur:8s;    --delay:-4.5s; --tint:var(--accent-primary-rgb)">
          <arc-rating value="5" readonly></arc-rating>
        </div>
        <div class="cluster-item" style="--x:10%; --y:70%; --dur:13s;   --delay:-6s;   --tint:var(--accent-secondary-rgb)">
          <arc-chip selected>Web Components</arc-chip>
        </div>
        <div class="cluster-item" style="--x:58%; --y:60%; --dur:9.5s;  --delay:-5.5s; --w:150px; --tint:var(--accent-primary-rgb)">
          <arc-sparkline data="4,9,6,12,9,16,13,20" fill></arc-sparkline>
        </div>
        <div class="cluster-item" style="--x:34%; --y:84%; --dur:11.5s; --delay:-8s;   --w:200px; --tint:var(--accent-secondary-rgb)">
          <arc-progress value="72" label="Deploying"></arc-progress>
        </div>
      </div>
      </div>
    </div>
  </header>

  <main>
    <arc-divider></arc-divider>

    <!-- One component, seven dialects: idioms, code and Prism in a single chapter -->
    <section class="native">
      <div class="native__inner">
        <div class="native__header" data-reveal="blur-in">
          <span class="section-label">Not a wrapper</span>
          <h2 class="statement">
            <span class="statement__quiet">One component.</span>
            <span class="statement__lit">Seven dialects.</span>
          </h2>
          <p class="section-desc">
            <span class="section-desc__line">Prism generates a real, typed package per framework from one Lit source.</span>
            <span class="section-desc__line">Hand-written wrappers: zero.</span>
          </p>
        </div>

        <div class="native__grid" id="fw-switcher" data-reveal="fade-up">
          <div class="fw-list" aria-label="Pick a framework">
            {fwTabs.map(([id, name], i) => (
              <button class:list={['fw-btn', { 'is-active': i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-fw={id}>
                <span class="fw-btn__name">{name}</span>
                <code class="fw-btn__idiom" set:html={idioms[id]} />
              </button>
            ))}
          </div>
          <div class="fw-panels">
            {fwTabs.map(([id, , filename, language], i) => (
              <div class="fw-panel" data-fw={id} hidden={i !== 0}>
                <arc-code-block variant="window" filename={filename} language={language} code={codeExamples[id]}></arc-code-block>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- What changed: the newest release note, derived at build time from the
         same collection /docs/changelog renders — when the next release note
         lands this chapter rewrites itself. -->
    <section class="changed">
      <div class="changed__inner">
        <div class="changed__main" data-reveal="blur-in">
          <span class="section-label">Changelog</span>
          <h2 class="statement">
            <span class="statement__quiet">What changed</span>
            <span class="statement__lit">in v{latestRelease.data.version}.</span>
          </h2>
          <p class="section-desc">
            <span class="section-desc__line">{latestRelease.data.title}.</span>
            <span class="section-desc__line changed__date">Published {releaseDate}. All packages version together.</span>
          </p>
          <p class="changed__lead">{releaseLead}</p>
        </div>
        <div class="changed__topics" data-reveal="fade-up">
          {releaseTopics.length > 0 && (
            <ul class="changed__topic-list">
              {releaseTopics.map((topic) => (
                <li class="changed__topic">
                  <span class="changed__topic-mark" aria-hidden="true"></span>
                  <span class="changed__topic-name">{topic}</span>
                </li>
              ))}
            </ul>
          )}
          <a class="chapter-link" href={releaseHref}>Read the full release notes →</a>
        </div>
      </div>
    </section>

    <!-- Yours: the server's render and your tokens, both live -->
    <section class="yours">
      <div class="yours__inner">
        <div class="yours__header" data-reveal="blur-in">
          <span class="section-label">Yours, not ours</span>
          <h2 class="statement">
            <span class="statement__quiet">Yours,</span>
            <span class="statement__lit">all the way down.</span>
          </h2>
          <p class="section-desc">
            <span class="section-desc__line">Override four tokens and every gradient, glow and focus ring follows.</span>
            <span class="section-desc__line">The utility classes read the same tokens, so your layout moves with them.</span>
          </p>
        </div>
        <div class="yours__console" data-reveal="fade-up">
          <div class="console__controls">
            <div class="ctl">
              <span class="ctl__label" id="accent-label">Accent</span>
              <div class="swatches" id="accent-swatches" role="group" aria-labelledby="accent-label">
                <button class="swatch is-active" aria-label="Arc default" aria-pressed="true" data-default="true" data-p={defaultAccent.p} data-prgb={defaultAccent.prgb} data-s={defaultAccent.s} data-srgb={defaultAccent.srgb} style={`--sw-a:${defaultAccent.p}; --sw-b:${defaultAccent.s}`}></button>
                <button class="swatch" aria-label="Emerald and cyan" aria-pressed="false" data-p="#10b981" data-prgb="16,185,129" data-s="#22d3ee" data-srgb="34,211,238" style="--sw-a:#10b981; --sw-b:#22d3ee"></button>
                <button class="swatch" aria-label="Amber and red" aria-pressed="false" data-p="#f59e0b" data-prgb="245,158,11" data-s="#ef4444" data-srgb="239,68,68" style="--sw-a:#f59e0b; --sw-b:#ef4444"></button>
                <button class="swatch" aria-label="Magenta and purple" aria-pressed="false" data-p="#ec4899" data-prgb="236,72,153" data-s="#a855f7" data-srgb="168,85,247" style="--sw-a:#ec4899; --sw-b:#a855f7"></button>
              </div>
            </div>
            <div class="ctl ctl--slider">
              <span class="ctl__label">Spacing</span>
              <arc-slider id="tokens-demo-slider" aria-label="--space-md" min="8" max="32" value="16"></arc-slider>
              <code class="ctl__readout">--space-md: <em id="tokens-demo-readout">16px</em></code>
            </div>
            <div class="ctl ctl--slider">
              <span class="ctl__label">Radius</span>
              <arc-slider id="radius-slider" aria-label="--radius-lg" min="2" max="28" value="14"></arc-slider>
              <code class="ctl__readout">--radius-lg: <em id="radius-readout">14px</em></code>
            </div>
          </div>
          <div class="console__outputs">
            <figure class="theme-file">
              <figcaption class="theme-file__chrome">
                <span class="theme-file__name">theme.css</span>
                <span class="theme-file__meta">live</span>
              </figcaption>
              <pre class="theme-file__code"><code><span class="theme-file__line"><span class="tk-t">:root</span> <span class="tk-p">&#123;</span></span><span class="theme-file__line">  <span class="tk-a">--accent-primary</span><span class="tk-p">:</span> <span class="tk-s" data-theme-val="p">{defaultAccent.p}</span><span class="tk-p">;</span></span><span class="theme-file__line">  <span class="tk-a">--accent-primary-rgb</span><span class="tk-p">:</span> <span class="tk-s" data-theme-val="prgb">{defaultAccent.prgb}</span><span class="tk-p">;</span></span><span class="theme-file__line">  <span class="tk-a">--accent-secondary</span><span class="tk-p">:</span> <span class="tk-s" data-theme-val="s">{defaultAccent.s}</span><span class="tk-p">;</span></span><span class="theme-file__line">  <span class="tk-a">--accent-secondary-rgb</span><span class="tk-p">:</span> <span class="tk-s" data-theme-val="srgb">{defaultAccent.srgb}</span><span class="tk-p">;</span></span><span class="theme-file__line"><span class="tk-p">&#125;</span></span></code></pre>
              <p class="theme-file__caption">
                That file is the entire theme, applied to this page for real — compound tokens
                reference these four, so every gradient, glow and focus ring follows.
                <a class="chapter-link" href="/synth">Build yours →</a>
              </p>
            </figure>
            <div class="tokens-demo">
              <div class="tokens-demo__stage" id="tokens-demo-stage">
                <div class="arc-flex arc-flex-col arc-gap-md arc-p-md arc-bg-card arc-border arc-rounded-lg">
                  <div class="arc-flex arc-items-center arc-justify-between">
                    <span class="tokens-demo__title">Workspace</span>
                    <arc-badge variant="primary">Pro</arc-badge>
                  </div>
                  <div class="arc-flex arc-items-center arc-gap-md">
                    <arc-avatar name="Ava Lane" size="sm"></arc-avatar>
                    <arc-avatar name="Rio Kim" size="sm"></arc-avatar>
                    <arc-button variant="secondary" size="sm">Invite</arc-button>
                  </div>
                  <arc-progress value="64" label="Storage"></arc-progress>
                </div>
              </div>
              <p class="tokens-demo__caption">
                {utilityClassCount} utility classes and every component read the same tokens —
                spacing and radius here move only this card, exactly the way a scoped override
                would in your app. <a class="chapter-link" href="/docs/utilities">Utilities →</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Rigor — the actual CI pipeline, under its real gate names -->
    <section class="gauntlet">
      <div class="gauntlet__inner">
        <div class="gauntlet__header" data-reveal="blur-in">
          <span class="section-label">Rigor</span>
          <h2 class="statement">
            <span class="statement__quiet">Every push</span>
            <span class="statement__lit">runs the gauntlet.</span>
          </h2>
          <p class="section-desc">
            The real CI gates on this repository, under their real names.
          </p>
        </div>
        <div class="gauntlet__stats" data-reveal-stagger="80">
          <div class="stat-custom" data-reveal="fade-up">
            <arc-animated-number class="stat-custom__number" value="0" data-target={`${components.length}`}>{components.length}</arc-animated-number>
            <div class="stat-custom__rule"></div>
            <span class="stat-custom__label">Components</span>
          </div>
          <div class="stat-custom" data-reveal="fade-up">
            <arc-animated-number class="stat-custom__number" value="0" data-target={`${testCount}`}>{testCount}</arc-animated-number>
            <div class="stat-custom__rule"></div>
            <span class="stat-custom__label">Tests</span>
          </div>
          <div class="stat-custom" data-reveal="fade-up">
            <arc-animated-number class="stat-custom__number" value="0" data-target={`${tokenCount}`}>{tokenCount}</arc-animated-number>
            <div class="stat-custom__rule"></div>
            <span class="stat-custom__label">Design Tokens</span>
          </div>
          <div class="stat-custom" data-reveal="fade-up">
            <arc-animated-number class="stat-custom__number" value="0" data-target={`${buildSteps}`}>{buildSteps}</arc-animated-number>
            <div class="stat-custom__rule"></div>
            <span class="stat-custom__label">Build Steps</span>
          </div>
        </div>
        <ul class="gates" data-reveal-stagger="70">
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">Generated files match source</span>
            <span class="gate__metric">0 diffs</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">Component tests</span>
            <span class="gate__metric">{testCount} tests</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">SSR render check</span>
            <span class="gate__metric">{elementCount}/{elementCount}</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">axe-core audit</span>
            <span class="gate__metric">0 serious</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">Typecheck generated declarations</span>
            <span class="gate__metric">every subpath</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">Smoke-test packed tarballs</span>
            <span class="gate__metric">every package</span>
