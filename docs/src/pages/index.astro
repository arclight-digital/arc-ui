---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteTopBar from '../components/SiteTopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { components } from '../data/components/index';
import { buildSteps, tokenCount, testCount, utilityClassCount, elementCount, version, versionShort } from '../data/site-stats';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ARC UI',
  description: `${components.length} dark-first Lit Web Components, generated natively by Prism for React, Vue, Svelte, Angular, Solid, Preact, and plain HTML.`,
  url: 'https://arcui.dev',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  softwareVersion: version,
  license: 'https://opensource.org/license/mit',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const codeExamples = {
  react: `import { Button, Card, Input, Toggle } from '@arclux/arc-ui-react';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" placeholder="Your name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save Changes</Button>
    </Card>
  );
}`,
  vue: `<template>
  <Card>
    <h3>Preferences</h3>
    <Input label="Display name" placeholder="Your name" />
    <Toggle label="Dark mode" :checked="true" />
    <Button variant="primary">Save Changes</Button>
  </Card>
</template>

<script setup>
import { Button, Card, Input, Toggle } from '@arclux/arc-ui-vue';
</script>`,
  svelte: `<script>
  import { Button, Card, Input, Toggle } from '@arclux/arc-ui-svelte';
</script>

<Card>
  <h3>Preferences</h3>
  <Input label="Display name" placeholder="Your name" />
  <Toggle label="Dark mode" checked />
  <Button variant="primary">Save Changes</Button>
</Card>`,
  angular: `import { Component } from '@angular/core';
import { Button, Card, Input, Toggle } from '@arclux/arc-ui-angular';

@Component({
  selector: 'app-settings',
  imports: [Button, Card, Input, Toggle],
  template: \`
    <arc-card>
      <h3>Preferences</h3>
      <arc-input label="Display name" placeholder="Your name"></arc-input>
      <arc-toggle label="Dark mode" checked></arc-toggle>
      <arc-button variant="primary">Save Changes</arc-button>
    </arc-card>
  \`,
})
export class SettingsComponent {}`,
  solid: `import { Button, Card, Input, Toggle } from '@arclux/arc-ui-solid';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" placeholder="Your name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save Changes</Button>
    </Card>
  );
}`,
  preact: `import { Button, Card, Input, Toggle } from '@arclux/arc-ui-preact';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" placeholder="Your name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save Changes</Button>
    </Card>
  );
}`,
  html: `<arc-card>
  <h3>Preferences</h3>
  <arc-input label="Display name" placeholder="Your name"></arc-input>
  <arc-toggle label="Dark mode" checked></arc-toggle>
  <arc-button variant="primary">Save Changes</arc-button>
</arc-card>

<script type="module">
  import '@arclux/arc-ui/register';
</script>`
};
---

<BaseLayout description={jsonLd.description}>
  <!-- Top Bar — shared with DocsLayout via SiteTopBar; immersive makes it
       transparent over the hero and (inside the component) theme-following
       instead of theme-fixed, so light mode stays readable. -->
  <SiteTopBar immersive mobileMenu="nav" />

  <!-- Hero -->
  <header class="hero">
    <canvas class="hero__canvas" id="hero-canvas"></canvas>
    <div class="hero__stream" aria-hidden="true" inert>
      <div class="stream-item" style="--lxr:-30; --ly:-4vh;  --dur:12s;   --delay:-2s;   --z0:-520px; --angle:4deg;    --trail:170px; --tint:var(--accent-primary-rgb)">
        <arc-button variant="primary" size="sm">Get started</arc-button>
      </div>
      <div class="stream-item" style="--lxr:-23; --ly:15vh;  --dur:10s;   --delay:-7s;   --z0:-780px; --angle:-19deg;  --trail:150px; --tint:var(--accent-secondary-rgb)">
        <arc-toggle checked label="Dark mode"></arc-toggle>
      </div>
      <div class="stream-item" style="--lxr:-35; --ly:7vh;   --dur:9s;    --delay:-4.5s; --z0:-380px; --angle:-6deg;   --trail:130px; --tint:var(--accent-primary-rgb)">
        <arc-badge variant="success">Stable</arc-badge>
      </div>
      <div class="stream-item" style="--lxr:-20; --ly:-17vh; --dur:11s;   --delay:-9s;   --z0:-900px; --angle:24deg;   --trail:160px; --tint:var(--accent-secondary-rgb)">
        <arc-rating value="5" readonly></arc-rating>
      </div>
      <div class="stream-item" style="--lxr:-33; --ly:-15vh; --dur:13s;   --delay:-6s;   --z0:-640px; --angle:14deg;   --trail:180px; --tint:var(--accent-primary-rgb)">
        <arc-stat value={String(components.length)} label="Components" trend="up" change="+7"></arc-stat>
      </div>
      <div class="stream-item" style="--lxr:-26; --ly:25vh;  --dur:10.5s; --delay:-1s;   --z0:-450px; --angle:-27deg;  --trail:150px; --tint:var(--accent-primary-rgb)">
        <arc-checkbox checked label="Ship it"></arc-checkbox>
      </div>
      <div class="stream-item" style="--lxr:28;  --ly:-7vh;  --dur:10s;   --delay:-3s;   --z0:-560px; --angle:172deg;  --trail:160px; --tint:var(--accent-secondary-rgb)">
        <arc-avatar name="Arc Light" status="online"></arc-avatar>
      </div>
      <div class="stream-item" style="--lxr:31;  --ly:11vh;  --dur:12.5s; --delay:-8s;   --z0:-700px; --angle:-169deg; --trail:180px; --w:180px; --tint:var(--accent-primary-rgb)">
        <arc-progress value="72" label="Deploying"></arc-progress>
      </div>
      <div class="stream-item" style="--lxr:22;  --ly:-19vh; --dur:9.5s;  --delay:-5.5s; --z0:-820px; --angle:155deg;  --trail:150px; --tint:var(--accent-primary-rgb)">
        <arc-chip selected>Web Components</arc-chip>
      </div>
      <div class="stream-item" style="--lxr:35;  --ly:-12vh; --dur:11.5s; --delay:-0.5s; --z0:-360px; --angle:170deg;  --trail:130px; --tint:var(--accent-secondary-rgb)">
        <arc-tag>Lit 3</arc-tag>
      </div>
      <div class="stream-item" style="--lxr:25;  --ly:21vh;  --dur:13.5s; --delay:-10s;  --z0:-880px; --angle:-156deg; --trail:170px; --w:160px; --tint:var(--accent-secondary-rgb)">
        <arc-slider value="64" label="Glow"></arc-slider>
      </div>
      <div class="stream-item" style="--lxr:34;  --ly:2vh;   --dur:10.8s; --delay:-6.8s; --z0:-600px; --angle:-178deg; --trail:160px; --tint:var(--accent-primary-rgb)">
        <arc-sparkline data="4,9,6,12,9,16,13,20" fill></arc-sparkline>
      </div>
    </div>
    <div class="hero__ambient"></div>
    <div class="hero__dots"></div>
    <div class="hero__vignette"></div>
    <div class="hero__content">
      <a href="/docs/changelog" class="hero__announcement">
        <span class="hero__announcement-badge">{versionShort}</span>
        <span class="hero__announcement-text">Server rendering for every component, and utilities that read your tokens</span>
        <svg class="hero__announcement-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <h1 class="hero__headline">
        <span class="hero__headline-top">Components that</span>
        <span class="hero__headline-glow-wrap">
          <span class="hero__headline-glow">glow.</span>
          <span class="hero__headline-glow-shadow" aria-hidden="true">glow.</span>
        </span>
      </h1>
      <p class="hero__body">
        <span class="hero__body-line">{components.length} dark-first components, written once as standard Web Components and</span>
        <span class="hero__body-line">generated into native packages for React, Vue, Svelte, Angular, Solid, Preact and HTML.</span>
        <span class="hero__body-line hero__body-line--kicker">Change framework without changing your design system.</span>
      </p>
      <arc-code-block variant="basic" language="bash" code="npm install @arclux/arc-ui"></arc-code-block>
      <div class="hero__actions">
        <arc-button href="/docs/getting-started" variant="primary" size="md">
          Get Started
          <svg slot="suffix" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </arc-button>
        <arc-button href="/docs/components" variant="secondary" size="md">Explore Components</arc-button>
      </div>
      <div class="hero__accent-line"></div>
    </div>
  </header>

  <main>
    <arc-divider></arc-divider>

    <!-- One component, seven dialects: idioms, code and Prism in a single chapter -->
    <section class="native">
      <div class="native__inner">
        <div class="native__header" data-reveal="blur-in">
          <span class="section-label">Not a wrapper</span>
          <h2 class="statement">
            <span class="statement__quiet">One component.</span>
            <span class="statement__lit">Seven dialects.</span>
          </h2>
          <p class="section-desc">
            <span class="section-desc__line">Prism generates a real, typed package per framework from one Lit source.</span>
            <span class="section-desc__line">Hand-written wrappers: zero.</span>
          </p>
        </div>

        <div class="native__grid" id="fw-switcher" data-reveal="fade-up">
          <div class="fw-list" aria-label="Pick a framework">
            <button class="fw-btn is-active" aria-pressed="true" data-fw="react">
              <span class="fw-btn__name">React</span>
              <code class="fw-btn__idiom"><em>onArcInput</em>=&#123;e =&gt; setV(e.detail.value)&#125;</code>
            </button>
            <button class="fw-btn" aria-pressed="false" data-fw="vue">
              <span class="fw-btn__name">Vue</span>
              <code class="fw-btn__idiom"><em>v-model:value</em>="volume"</code>
            </button>
            <button class="fw-btn" aria-pressed="false" data-fw="svelte">
              <span class="fw-btn__name">Svelte</span>
              <code class="fw-btn__idiom"><em>bind:value</em>=&#123;volume&#125;</code>
            </button>
            <button class="fw-btn" aria-pressed="false" data-fw="angular">
              <span class="fw-btn__name">Angular</span>
              <code class="fw-btn__idiom"><em>[(value)]</em>="volume"</code>
            </button>
            <button class="fw-btn" aria-pressed="false" data-fw="solid">
              <span class="fw-btn__name">Solid</span>
              <code class="fw-btn__idiom"><em>onArcInput</em>=&#123;handle&#125;</code>
            </button>
            <button class="fw-btn" aria-pressed="false" data-fw="preact">
              <span class="fw-btn__name">Preact</span>
              <code class="fw-btn__idiom"><em>onArcInput</em>=&#123;handle&#125;</code>
            </button>
            <button class="fw-btn" aria-pressed="false" data-fw="html">
              <span class="fw-btn__name">HTML</span>
              <code class="fw-btn__idiom">no build step at all</code>
            </button>
          </div>
          <div class="fw-panels">
            <div class="fw-panel" data-fw="react">
              <arc-code-block variant="window" filename="App.jsx" language="jsx" code={codeExamples.react}></arc-code-block>
            </div>
            <div class="fw-panel" data-fw="vue" hidden>
              <arc-code-block variant="window" filename="App.vue" language="html" code={codeExamples.vue}></arc-code-block>
            </div>
            <div class="fw-panel" data-fw="svelte" hidden>
              <arc-code-block variant="window" filename="App.svelte" language="html" code={codeExamples.svelte}></arc-code-block>
            </div>
            <div class="fw-panel" data-fw="angular" hidden>
              <arc-code-block variant="window" filename="settings.component.ts" language="ts" code={codeExamples.angular}></arc-code-block>
            </div>
            <div class="fw-panel" data-fw="solid" hidden>
              <arc-code-block variant="window" filename="Settings.jsx" language="jsx" code={codeExamples.solid}></arc-code-block>
            </div>
            <div class="fw-panel" data-fw="preact" hidden>
              <arc-code-block variant="window" filename="Settings.jsx" language="jsx" code={codeExamples.preact}></arc-code-block>
            </div>
            <div class="fw-panel" data-fw="html" hidden>
              <arc-code-block variant="window" filename="index.html" language="html" code={codeExamples.html}></arc-code-block>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Yours: the server's render and your tokens, both live -->
    <section class="yours">
      <div class="yours__inner">
        <div class="yours__header" data-reveal="blur-in">
          <span class="section-label">Yours, not ours</span>
          <h2 class="statement">
            <span class="statement__quiet">Yours,</span>
            <span class="statement__lit">all the way down.</span>
          </h2>
          <p class="section-desc">
            <span class="section-desc__line">Rendered on your server before the bundle loads.</span>
            <span class="section-desc__line">Restyled by overriding a token.</span>
          </p>
        </div>
        <div class="yours__grid">
          <figure class="payload" data-reveal="fade-up">
            <figcaption class="payload__chrome">
              <span class="payload__method">GET</span>
              <span class="payload__url">/pricing</span>
              <span class="payload__meta">200 · text/html</span>
            </figcaption>
            <pre class="payload__code"><code><span class="payload__line"><span class="tk-p">&lt;</span><span class="tk-t">arc-feature-card</span> <span class="tk-a">heading</span><span class="tk-p">=</span><span class="tk-s">"Fast by default"</span><span class="tk-p">&gt;</span></span><span class="payload__line payload__line--hot">  <span class="tk-p">&lt;</span><span class="tk-t">template</span> <span class="tk-a">shadowrootmode</span><span class="tk-p">=</span><span class="tk-s">"open"</span><span class="tk-p">&gt;</span></span><span class="payload__line">    <span class="tk-p">&lt;</span><span class="tk-t">style</span><span class="tk-p">&gt;</span><span class="tk-c">…</span><span class="tk-p">&lt;/</span><span class="tk-t">style</span><span class="tk-p">&gt;</span></span><span class="payload__line">    <span class="tk-p">&lt;</span><span class="tk-t">div</span> <span class="tk-a">class</span><span class="tk-p">=</span><span class="tk-s">"card"</span> <span class="tk-a">part</span><span class="tk-p">=</span><span class="tk-s">"card"</span><span class="tk-p">&gt;</span></span><span class="payload__line">      <span class="tk-p">&lt;</span><span class="tk-t">h3</span> <span class="tk-a">class</span><span class="tk-p">=</span><span class="tk-s">"card__title"</span><span class="tk-p">&gt;</span>Fast by default<span class="tk-p">&lt;/</span><span class="tk-t">h3</span><span class="tk-p">&gt;</span></span><span class="payload__line">      <span class="tk-p">&lt;</span><span class="tk-t">p</span> <span class="tk-a">class</span><span class="tk-p">=</span><span class="tk-s">"card__desc"</span><span class="tk-p">&gt;</span>Ships 40% less JavaScript<span class="tk-p">&lt;/</span><span class="tk-t">p</span><span class="tk-p">&gt;</span></span><span class="payload__line">    <span class="tk-p">&lt;/</span><span class="tk-t">div</span><span class="tk-p">&gt;</span></span><span class="payload__line payload__line--hot">  <span class="tk-p">&lt;/</span><span class="tk-t">template</span><span class="tk-p">&gt;</span></span><span class="payload__line"><span class="tk-p">&lt;/</span><span class="tk-t">arc-feature-card</span><span class="tk-p">&gt;</span></span></code></pre>
            <p class="payload__caption">
              All {components.length} components ship their shadow DOM in the HTML, parsed before
              any JavaScript runs. <a class="chapter-link" href="/docs/server-rendering">Server rendering →</a>
            </p>
          </figure>
          <div class="tokens-demo" data-reveal="fade-up">
            <div class="tokens-demo__head">
              <div class="swatches" id="accent-swatches" role="group" aria-label="Accent token pair">
                <button class="swatch is-active" aria-label="Arc blue and violet" aria-pressed="true" data-p="#4d7ef7" data-prgb="77,126,247" data-s="#8b5cf6" data-srgb="139,92,246" style="--sw-a:#4d7ef7; --sw-b:#8b5cf6"></button>
                <button class="swatch" aria-label="Emerald and cyan" aria-pressed="false" data-p="#10b981" data-prgb="16,185,129" data-s="#22d3ee" data-srgb="34,211,238" style="--sw-a:#10b981; --sw-b:#22d3ee"></button>
                <button class="swatch" aria-label="Amber and red" aria-pressed="false" data-p="#f59e0b" data-prgb="245,158,11" data-s="#ef4444" data-srgb="239,68,68" style="--sw-a:#f59e0b; --sw-b:#ef4444"></button>
                <button class="swatch" aria-label="Magenta and purple" aria-pressed="false" data-p="#ec4899" data-prgb="236,72,153" data-s="#a855f7" data-srgb="168,85,247" style="--sw-a:#ec4899; --sw-b:#a855f7"></button>
              </div>
              <code class="tokens-demo__readout">--space-md: <em id="tokens-demo-readout">16px</em></code>
            </div>
            <div class="tokens-demo__stage" id="tokens-demo-stage">
              <div class="arc-flex arc-flex-col arc-gap-md arc-p-md arc-bg-card arc-border arc-rounded-lg">
                <div class="arc-flex arc-items-center arc-justify-between">
                  <span class="tokens-demo__title">Workspace</span>
                  <arc-badge variant="primary">Pro</arc-badge>
                </div>
                <div class="arc-flex arc-items-center arc-gap-md">
                  <arc-avatar name="Ava Lane" size="sm"></arc-avatar>
                  <arc-avatar name="Rio Kim" size="sm"></arc-avatar>
                  <arc-button variant="secondary" size="sm">Invite</arc-button>
                </div>
                <arc-progress value="64" label="Storage"></arc-progress>
              </div>
            </div>
            <div class="tokens-demo__controls">
              <arc-slider id="tokens-demo-slider" label="--space-md" min="8" max="32" value="16"></arc-slider>
            </div>
            <p class="tokens-demo__caption">
              {utilityClassCount} utility classes and every component read the same tokens — one
              override moves them all. <a class="chapter-link" href="/docs/utilities">Utilities →</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Rigor — the actual CI pipeline, under its real gate names -->
    <section class="gauntlet">
      <div class="gauntlet__inner">
        <div class="gauntlet__header" data-reveal="blur-in">
          <span class="section-label">Rigor</span>
          <h2 class="statement">
            <span class="statement__quiet">Every push</span>
            <span class="statement__lit">runs the gauntlet.</span>
          </h2>
          <p class="section-desc">
            The real CI gates on this repository, under their real names.
          </p>
        </div>
        <div class="gauntlet__stats" data-reveal-stagger="80">
          <div class="stat-custom" data-reveal="fade-up">
            <arc-animated-number class="stat-custom__number" value="0" data-target={`${components.length}`}>{components.length}</arc-animated-number>
            <div class="stat-custom__rule"></div>
            <span class="stat-custom__label">Components</span>
          </div>
          <div class="stat-custom" data-reveal="fade-up">
            <arc-animated-number class="stat-custom__number" value="0" data-target={`${testCount}`}>{testCount}</arc-animated-number>
            <div class="stat-custom__rule"></div>
            <span class="stat-custom__label">Tests</span>
          </div>
          <div class="stat-custom" data-reveal="fade-up">
            <arc-animated-number class="stat-custom__number" value="0" data-target={`${tokenCount}`}>{tokenCount}</arc-animated-number>
            <div class="stat-custom__rule"></div>
            <span class="stat-custom__label">Design Tokens</span>
          </div>
          <div class="stat-custom" data-reveal="fade-up">
            <arc-animated-number class="stat-custom__number" value="0" data-target={`${buildSteps}`}>{buildSteps}</arc-animated-number>
            <div class="stat-custom__rule"></div>
            <span class="stat-custom__label">Build Steps</span>
          </div>
        </div>
        <ul class="gates" data-reveal-stagger="70">
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">Generated files match source</span>
            <span class="gate__metric">0 diffs</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">Component tests</span>
            <span class="gate__metric">{testCount} tests</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">SSR render check</span>
            <span class="gate__metric">{elementCount}/{elementCount}</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">axe-core audit</span>
            <span class="gate__metric">0 serious</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">Typecheck generated declarations</span>
            <span class="gate__metric">every subpath</span>
          </li>
          <li class="gate" data-reveal="fade-up">
            <span class="gate__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13.5 4.5L6 12 2.5 8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="gate__name">Smoke-test packed tarballs</span>
            <span class="gate__metric">every package</span>
          </li>
        </ul>
        <p class="gauntlet__note" data-reveal="fade-up">
          APG patterns, focus management and reduced motion are built per component.
          <a class="chapter-link" href="/docs/accessibility">Accessibility →</a>
        </p>
      </div>
    </section>

    <!-- CTA -->
    <arc-cta-banner eyebrow="Ready to build?" headline="Start shipping with ARC UI." data-reveal="fade-up">
      <p>
        Install in seconds. Build in minutes. Ship production-ready interfaces that look
        incredible out of the box.
      </p>
      <arc-button slot="actions" href="/docs/getting-started" variant="primary" size="md">
        Get Started
        <svg slot="suffix" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </arc-button>
      <arc-button slot="actions" href="https://github.com/Arclight-Digital/arc-ui" variant="secondary" size="md">
        <svg slot="prefix" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        View on GitHub
      </arc-button>
    </arc-cta-banner>

    <SiteFooter />
  </main>
  <arc-scroll-to-top></arc-scroll-to-top>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<script>
  import { init as glintInit } from '@arclux/glint/full';
  import '@arclux/glint/glint.css';
  import '@arclux/arc-ui/utilities.css';
  // arc-code-block is opt-in only (it lazy-loads a syntax highlighter), so
  // the register barrel deliberately skips it — without this import the
  // framework switcher's window never upgrades and the FOUC guard hides it.
  import '@arclux/arc-ui/code-block';

  /* ── Light-Tunnel Canvas ──
     A tube of light beams the camera flies through: the core stays dark
     (that's where the headline lives), the walls stream with accent-colored
     streaks. The DOM component stream (.hero__stream) shares this camera:
     perspective 900px, vanishing point at 50% 40%. */
  function initCanvas() {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    // Guard against double init: on first load both the direct call and
    // astro:page-load fire, and two rAF loops fighting over one canvas
    // makes the opening seconds stutter
    if ((canvas as any).__arcTunnel) return;
    (canvas as any).__arcTunnel = true;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const rootStyles = getComputedStyle(document.documentElement);
    const BLUE = rootStyles.getPropertyValue('--accent-primary-rgb').trim() || '77,126,247';
    const PURPLE = rootStyles.getPropertyValue('--accent-secondary-rgb').trim() || '139,92,246';

    // Live theme check: additive glow works on dark; on light backgrounds
    // beams switch to multiply so they read as tinted streaks, not fog
    const lightMql = window.matchMedia('(prefers-color-scheme: light)');
    function isLight() {
      const t = document.documentElement.getAttribute('data-theme');
      return t === 'light' || (t !== 'dark' && lightMql.matches);
    }

    const P = 900;        // must match .hero__stream's CSS perspective
    const Z_SPAWN = 3600; // beams are born deep in the tube
    const Z_KILL = 120;   // and die just before they'd hit the camera

    let width = 0;
    let height = 0;
    let animId = 0;
    let last = 0;
    let time = 0;
    let lastW = 0;
    let lastH = 0;
    let resizeRaf = 0;

    // Warp model: boost decays toward cruise and is fed only by
    // scrolling. warp = 1 + boost. The tunnel starts AT cruise — no
    // arrival deceleration, nothing to visibly settle.
    let boost = 0;
    let lastScrollY = window.scrollY;
    let streamAnims: Animation[] = [];
    let lastRate = 1;
    let lastPx = 0;
    let lastPy = 0;

    interface Beam {
      theta: number;  // angle around the tube wall
      z: number;      // depth, world units in front of the camera
      len: number;    // beam length along the tube
      speed: number;  // world units per second toward the camera
      color: string;
      girth: number;
      phase: number;  // flicker phase
      freq: number;   // flicker frequency
    }
    interface Mote {
      theta: number;
      rad: number;    // fraction of the tube radius, keeps the core clear
      z: number;
      speed: number;
      color: string;
    }
    const beams: Beam[] = [];
    const motes: Mote[] = [];

    function beamColor() {
      const r = Math.random();
      return r < 0.68 ? BLUE : r < 0.94 ? PURPLE : '255,255,255';
    }

    function spawnBeam(b: Beam, anywhere = false) {
      b.theta = Math.random() * Math.PI * 2;
      b.z = anywhere
        ? Z_KILL + Math.random() * (Z_SPAWN - Z_KILL)
        : Z_SPAWN - Math.random() * 700;
      b.len = 280 + Math.random() * 520;
      b.speed = 450 + Math.random() * 550;
      b.color = beamColor();
      b.girth = 0.6 + Math.random() * 0.9;
      b.phase = Math.random() * Math.PI * 2;
      b.freq = 4 + Math.random() * 6;
    }

    function spawnMote(m: Mote, anywhere = false) {
      m.theta = Math.random() * Math.PI * 2;
      m.rad = 0.35 + Math.random() * 0.75;
      m.z = anywhere
        ? Z_KILL + Math.random() * (Z_SPAWN - Z_KILL)
        : Z_SPAWN - Math.random() * 600;
      m.speed = 480 + Math.random() * 420;
      const r = Math.random();
      m.color = r < 0.5 ? '255,255,255' : r < 0.85 ? BLUE : PURPLE;
    }

    function resize() {
      const rect = canvas.parentElement!.getBoundingClientRect();
      // Sub-native backing resolution: the upscale is free bloom
      const dpr = Math.min(window.devicePixelRatio, 2) * 0.7;
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      lastW = width;
      lastH = height;

      // The area formula already scales down, but the floors were written for
      // desktop and a phone lands on them — so a 390px screen was paying the
      // same particle cost as a laptop. Lower floors below 640px.
      const small = width < 640;
      const beamTarget = Math.max(small ? 16 : 30, Math.min(56, Math.round((width * height) / 28000)));
      while (beams.length < beamTarget) {
        const b = {} as Beam;
        spawnBeam(b, true);
        beams.push(b);
      }
      beams.length = beamTarget;

      const moteTarget = Math.max(small ? 22 : 40, Math.min(70, Math.round((width * height) / 24000)));
      while (motes.length < moteTarget) {
        const m = {} as Mote;
        spawnMote(m, true);
        motes.push(m);
      }
      motes.length = moteTarget;
    }

    // Cursor parallax: the vanishing point drifts a little, in canvas and
    // CSS together so beams and components stay on the same tube
    let mx = 0, my = 0;   // smoothed offset, -1..1
    let tmx = 0, tmy = 0; // targets
    const stream = document.querySelector('.hero__stream') as HTMLElement | null;

    function drawFrame(dt: number) {
      time += dt;

      // Boost decays smoothly back to cruise
      boost *= Math.exp(-dt * 1.15);
      const warp = 1 + boost;

      // Camera: mouse parallax + a slow ambient sway (canvas only — the
      // DOM layer is touched solely when the parallax actually moves)
      mx += (tmx - mx) * Math.min(1, dt * 3);
      my += (tmy - my) * Math.min(1, dt * 3);
      const px = mx * 16;
      const py = my * 12;
      const cx = width * 0.5 + px + Math.sin(time * 0.32) * 6;
      const cy = height * 0.4 + py + Math.cos(time * 0.21) * 5;
      if (stream && (Math.abs(px - lastPx) > 0.5 || Math.abs(py - lastPy) > 0.5)) {
        lastPx = px;
        lastPy = py;
        stream.style.perspectiveOrigin =
          `calc(50% + ${px.toFixed(1)}px) calc(40% + ${py.toFixed(1)}px)`;
      }

      const light = isLight();
      const aScale = light ? 0.5 : 1;

      // Components ride the same surges: their CSS animations take the
      // warp factor as a playback rate
      if (!streamAnims.length && stream && time < 3) {
        streamAnims = stream.getAnimations({ subtree: true });
      }
      const rate = 1 + boost * 0.7;
      if (Math.abs(rate - lastRate) > 0.04) {
        lastRate = rate;
        for (const anim of streamAnims) anim.playbackRate = rate;
      }

      const rx = width * 0.62;  // tube wall radii — outside the headline
      const ry = height * 0.62;

      ctx!.clearRect(0, 0, width, height);
      ctx!.globalCompositeOperation = light ? 'multiply' : 'lighter';
      ctx!.lineCap = 'round';

      // Wall beams: white-hot tip, flicker, stretched by warp speed
      for (const b of beams) {
        b.z -= b.speed * warp * dt;
        if (b.z < Z_KILL) spawnBeam(b);

        const ux = Math.cos(b.theta);
        const uy = Math.sin(b.theta);
        const lenEff = b.len * (1 + boost * 1.2);
        const s1 = P / b.z;             // near end of the beam
        const s2 = P / (b.z + lenEff);  // far end
        const x1 = cx + rx * ux * s1;
        const y1 = cy + ry * uy * s1;
        const x2 = cx + rx * ux * s2;
        const y2 = cy + ry * uy * s2;

        // Fade in as the beam approaches; deep beams stay dark so the
        // tunnel core reads as black
        const flick = 0.8 + 0.2 * Math.sin(time * b.freq + b.phase);
        const a = Math.min(1, (Z_SPAWN - b.z) / 1400) * 0.55 * flick * aScale;
        if (a <= 0.01) continue;
        if (
          (x1 < -60 && x2 < -60) || (x1 > width + 60 && x2 > width + 60) ||
          (y1 < -60 && y2 < -60) || (y1 > height + 60 && y2 > height + 60)
        ) continue;

        // White-hot tips glow on dark; on light the tip stays tinted
        // (white multiplies to nothing)
        const tip = light
          ? `rgba(${b.color},${Math.min(1, a * 1.4)})`
          : `rgba(255,255,255,${Math.min(1, a * 0.7)})`;
        const grad = ctx!.createLinearGradient(x1, y1, x2, y2);
        grad.addColorStop(0, tip);
        grad.addColorStop(0.18, `rgba(${b.color},${a})`);
        grad.addColorStop(1, `rgba(${b.color},0)`);
        ctx!.strokeStyle = grad;

        // Two soft passes, no hard core — the canvas blur does the rest
        ctx!.lineWidth = Math.min(16, 2 + 9 * s1) * b.girth;
        ctx!.globalAlpha = 0.28;
        ctx!.beginPath();
        ctx!.moveTo(x1, y1);
        ctx!.lineTo(x2, y2);
        ctx!.stroke();
        ctx!.lineWidth = Math.min(3.5, 0.8 + 2 * s1) * b.girth;
        ctx!.globalAlpha = 0.5;
        ctx!.stroke();
      }

      // Depth dust between the walls; streaks hard when the tunnel surges
      for (const m of motes) {
        m.z -= m.speed * warp * dt;
        if (m.z < Z_KILL) spawnMote(m);
        const ux = Math.cos(m.theta);
        const uy = Math.sin(m.theta);
        const s1 = P / m.z;
        const s2 = P / (m.z + 50 + 500 * boost);
        const x1 = cx + rx * m.rad * ux * s1;
        const y1 = cy + ry * m.rad * uy * s1;
        const a = Math.min(1, (Z_SPAWN - m.z) / 1600) * 0.22 * aScale;
        if (a <= 0.01) continue;
        if (x1 < -40 || x1 > width + 40 || y1 < -40 || y1 > height + 40) continue;
        const x2 = cx + rx * m.rad * ux * s2;
        const y2 = cy + ry * m.rad * uy * s2;
        // White dust vanishes under multiply — tint it on light themes
        const mc = light && m.color === '255,255,255' ? BLUE : m.color;
        ctx!.strokeStyle = `rgba(${mc},${a})`;
        ctx!.lineWidth = 2;
        ctx!.beginPath();
        ctx!.moveTo(x1, y1);
        ctx!.lineTo(x2, y2);
        ctx!.stroke();
      }

      ctx!.globalAlpha = 1;
      ctx!.globalCompositeOperation = 'source-over';
    }

    function frame(now: number) {
      // Tight dt cap: heavy frames during page load advance the world
      // gently instead of visibly jumping
      const dt = Math.min((now - last) / 1000, 0.033);
      last = now;
      drawFrame(dt);
      animId = requestAnimationFrame(frame);
    }

    resize();

    const hero = canvas.parentElement!;

    // Grab the stream animations up front so their playback rate is set
    // before anything is visible — no mid-flight speed snap
    if (stream) streamAnims = stream.getAnimations({ subtree: true });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      // One still frame at cruise speed: the tube is visible, nothing moves
      drawFrame(0);
      hero.classList.add('hero--live');
      const redraw = () => {
        resize();
        drawFrame(0);
      };
      window.addEventListener('resize', redraw);
      document.addEventListener('astro:before-swap', () => {
        window.removeEventListener('resize', redraw);
      }, { once: true });
      return;
    }

    function onMouseMove(e: MouseEvent) {
      tmx = (e.clientX / window.innerWidth) * 2 - 1;
      tmy = (e.clientY / window.innerHeight) * 2 - 1;
    }

    function onMouseOut(e: MouseEvent) {
      if (!e.relatedTarget) {
        tmx = 0;
        tmy = 0;
      }
    }

    // Scrolling feeds the warp: leaving the hero feels like launching
    function onScroll() {
      const y = window.scrollY;
      const dy = Math.abs(y - lastScrollY);
      lastScrollY = y;
      boost = Math.min(3, boost + Math.min(0.5, dy * 0.0035));
    }

    // iOS fires resize when the URL bar collapses. The hero is sized in vh, so
    // its box is unchanged — but resize() reallocates the canvas backing store
    // and rebuilds both particle arrays regardless, on every scroll direction
    // change. Measure first, and do nothing if nothing actually moved.
    function onResize() {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(() => {
        resizeRaf = 0;
        const rect = canvas.parentElement!.getBoundingClientRect();
        if (Math.abs(rect.width - lastW) < 1 && Math.abs(rect.height - lastH) < 1) return;
        resize();
      });
    }

    window.addEventListener('resize', onResize);
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('mouseout', onMouseOut);
    window.addEventListener('scroll', onScroll, { passive: true });

    // The hero is 85vh, so on a phone it leaves the screen in one swipe — and
    // the loop kept drawing beams, motes and gradients for a canvas nobody
    // could see, for as long as the tab stayed open. rAF already yields when
    // the tab is hidden; this covers the far more common case of the tab being
    // visible but the hero not.
    let running = false;
    function start() {
      if (running) return;
      running = true;
      animId = requestAnimationFrame((t) => {
        last = t;
        animId = requestAnimationFrame(frame);
        // Reveal only after the first frame is painted: load-time jank
        // happens behind a fade instead of in front of the visitor
        hero.classList.add('hero--live');
      });
    }
    function stop() {
      if (!running) return;
      running = false;
      cancelAnimationFrame(animId);
      animId = 0;
    }

    const io = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { threshold: 0 },
    );
    io.observe(hero);
    start();

    document.addEventListener('astro:before-swap', () => {
      stop();
      io.disconnect();
      if (resizeRaf) cancelAnimationFrame(resizeRaf);
      window.removeEventListener('resize', onResize);
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseout', onMouseOut);
      window.removeEventListener('scroll', onScroll);
      if (stream) stream.style.perspectiveOrigin = '';
    }, { once: true });
  }

  /* ── Reveal on scroll (glint) ──
     The revealed state is the default: glint hides at runtime, so a script
     failure leaves the page readable instead of blank. Reduced motion,
     focus-into-pending, and the forced-reveal ceiling all come with it.
     Durations and easing follow the ARC motion tokens (--duration-enter,
     --ease-out) via glint.css. */
  function initReveal() {
    const glint = glintInit();
    document.addEventListener('astro:before-swap', () => glint.destroy(), { once: true });
  }

  /* ── Utilities demo: one token moves everything ── */
  function initTokensDemo() {
    const stage = document.getElementById('tokens-demo-stage');
    const slider = document.getElementById('tokens-demo-slider') as any;
    const readout = document.getElementById('tokens-demo-readout');
    if (!stage || !slider || slider.dataset.demoInit) return;
    slider.dataset.demoInit = '1';
    slider.addEventListener('arc-input', (e: any) => {
      const v = Math.round(e.detail?.value ?? slider.value);
      stage.style.setProperty('--space-md', `${v}px`);
      if (readout) readout.textContent = `${v}px`;
    });
  }

  /* ── Stat count-up ── */
  function initStatCountUp() {
    const nums = document.querySelectorAll('arc-animated-number[data-target]');
    if (!nums.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as any;
          const target = el.dataset.target;
          if (prefersReducedMotion) {
            el.value = target;
          } else {
            // Small delay for visual effect
            requestAnimationFrame(() => { el.value = target; });
          }
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.3 });

    nums.forEach(el => observer.observe(el));
  }

  /* ── Framework switcher: auto-advances until the visitor takes over ── */
  function initFwSwitcher() {
    const root = document.getElementById('fw-switcher');
    if (!root || (root as any).dataset.init) return;
    (root as any).dataset.init = '1';

    const btns = Array.from(root.querySelectorAll<HTMLElement>('.fw-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.fw-panel'));
    let idx = 0;
    let timer = 0;
    let userTouched = false;

    const show = (i: number) => {
      idx = i;
      btns.forEach((b, j) => {
        b.classList.toggle('is-active', i === j);
        b.setAttribute('aria-pressed', String(i === j));
      });
      panels.forEach((p, j) => p.toggleAttribute('hidden', i !== j));
    };

    const stop = () => {
      clearInterval(timer);
      timer = 0;
      root!.classList.remove('is-auto');
    };
    const start = () => {
      if (timer || userTouched) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // The class drives the timer bar under the active name, so the
      // auto-advance is visible instead of a surprise. The interval comes
      // from --fw-interval so the bar and the rotation stay one value.
      root!.classList.add('is-auto');
      const interval = (parseFloat(getComputedStyle(root!).getPropertyValue('--fw-interval')) || 6.5) * 1000;
      timer = window.setInterval(() => show((idx + 1) % btns.length), interval);
    };

    btns.forEach((b, i) => b.addEventListener('click', () => {
      userTouched = true;
      stop();
      show(i);
    }));

    const io = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { threshold: 0.3 },
    );
    io.observe(root);

    document.addEventListener('astro:before-swap', () => {
      stop();
      io.disconnect();
    }, { once: true });
  }

  /* ── Accent swatches: four data attributes repaint the whole stage ── */
  function initAccentSwatches() {
    const stage = document.getElementById('tokens-demo-stage');
    const group = document.getElementById('accent-swatches');
    if (!stage || !group || (group as any).dataset.init) return;
    (group as any).dataset.init = '1';

    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.swatch');
      if (!btn) return;
      const { p, prgb, s, srgb } = btn.dataset;
      stage.style.setProperty('--accent-primary', p!);
      stage.style.setProperty('--accent-primary-rgb', prgb!);
      stage.style.setProperty('--accent-secondary', s!);
      stage.style.setProperty('--accent-secondary-rgb', srgb!);
      Array.from(group.children).forEach((c) => {
        c.classList.toggle('is-active', c === btn);
        c.setAttribute('aria-pressed', String(c === btn));
      });
    });
  }

  async function initNavigation() {
    const { navigate } = await import('astro:transitions/client');
    document.addEventListener('arc-navigate', (e: any) => {
      const href = e.detail?.href;
      if (href) {
        e.preventDefault();
        navigate(href);
      }
    });
  }

  initCanvas();
  initReveal();
  initStatCountUp();
  initFwSwitcher();
  initTokensDemo();
  initAccentSwatches();
  initNavigation();
  document.addEventListener('astro:page-load', () => {
    initCanvas();
    initReveal();
    initStatCountUp();
    initFwSwitcher();
    initTokensDemo();
    initAccentSwatches();
    initNavigation();
  });
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: clip;
    padding: calc(var(--space-3xl) + 80px) var(--space-lg) var(--space-2xl);
    min-height: 85vh;
    display: flex;
    align-items: center;
    /* Theme knobs for the tunnel: dark is the native habitat; light mode
       swaps the dark core for haze, drops the screen blend, and halves glow */
    --hero-core: rgba(3,3,7,0.6);
    --hero-rim: rgba(3,3,7,0.55);
    --hero-dot: rgba(255,255,255,0.12);
    --stream-blend: screen;
    --glow-a: 1;
    --peak: 0.9;
  }

  :global([data-theme='light']) .hero {
    --hero-core: rgba(255,255,255,0.65);
    --hero-rim: rgba(255,255,255,0.6);
    --hero-dot: rgba(10,10,25,0.16);
    --stream-blend: normal;
    --glow-a: 0.4;
    --peak: 0.55;
  }

  @media (prefers-color-scheme: light) {
    :global([data-theme='auto']) .hero {
      --hero-core: rgba(255,255,255,0.65);
      --hero-rim: rgba(255,255,255,0.6);
      --hero-dot: rgba(10,10,25,0.16);
      --stream-blend: normal;
      --glow-a: 0.4;
      --peak: 0.55;
    }
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    /* everything the tunnel draws melts into bloom */
    filter: blur(1.2px) saturate(1.15);
  }

  /* The tunnel fades in once its first frame has painted, so load-time
     hitching never shows */
  .hero__canvas,
  .hero__stream {
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .hero--live .hero__canvas,
  .hero--live .hero__stream {
    opacity: 1;
  }

  .hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--hero-dot) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 1;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 70%);
  }

  /* Vignette blur: two masked backdrop-filter layers make the tunnel
     progressively hazier toward the hero's edges — sharp at the core,
     frosted at the rim, with no visible seam */
  .hero__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    mask-image: radial-gradient(ellipse 78% 74% at 50% 40%, transparent 48%, black 88%);
    -webkit-mask-image: radial-gradient(ellipse 78% 74% at 50% 40%, transparent 48%, black 88%);
  }

  .hero__ambient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 52% 46% at 50% 42%, var(--hero-core), transparent 68%),
      radial-gradient(ellipse 80% 60% at 20% 40%, rgba(var(--accent-primary-rgb),0.12), transparent 70%),
      radial-gradient(ellipse 60% 80% at 80% 60%, rgba(var(--accent-secondary-rgb),0.1), transparent 70%),
      radial-gradient(circle at 50% 100%, rgba(var(--accent-primary-rgb),0.08), transparent 40%);
    pointer-events: none;
    z-index: 1;
  }

  /* ── Component Stream (light-tunnel walls) ──
     Shares the canvas tunnel's camera: perspective 900px, origin 50% 40%.
     Items fly from deep in the tube (-2100px) past the viewer (+470px). */
  .hero__stream {
    position: absolute;
    inset: 0;
    z-index: 1;
    perspective: 900px;
    perspective-origin: 50% 40%;
    pointer-events: none;
  }

  .stream-item {
    --lx: calc(var(--lxr) * 1vw);
    position: absolute;
    left: 50%;
    top: 40%;
    width: var(--w, auto);
    transform: translate(-50%, -50%) translate3d(var(--lx), var(--ly), var(--z0, -600px));
    opacity: 0;
    /* screen blend (dark theme) melts dark surfaces away — components read
       as forms made of light; light theme falls back to normal blending */
    mix-blend-mode: var(--stream-blend);
    filter:
      saturate(1.4) brightness(1.15)
      drop-shadow(0 0 8px rgba(var(--tint), calc(0.6 * var(--glow-a))))
      drop-shadow(0 0 32px rgba(var(--tint), calc(0.35 * var(--glow-a))));
    animation: stream-fly var(--dur) linear infinite;
    animation-delay: var(--delay);
    will-change: transform, opacity;
  }

  /* Comet trail: a soft smear of light lagging behind, aimed back at the
     vanishing point */
  .stream-item::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--trail, 160px);
    height: 6px;
    z-index: -1;
    transform-origin: left center;
    transform: translateY(-50%) rotate(var(--angle, 0deg));
    background: linear-gradient(90deg,
      rgba(var(--tint), calc(0.45 * var(--glow-a))),
      rgba(var(--tint), calc(0.1 * var(--glow-a))) 55%,
      transparent);
    border-radius: 3px;
    filter: blur(2px);
  }

  @keyframes stream-fly {
    0%   { transform: translate(-50%, -50%) translate3d(var(--lx), var(--ly), -2100px); opacity: 0; }
    16%  { opacity: var(--peak, 0.9); }
    80%  { opacity: var(--peak, 0.9); }
    100% { transform: translate(-50%, -50%) translate3d(var(--lx), var(--ly), 470px); opacity: 0; }
  }

  @media (max-width: 768px) {
    .stream-item { --lx: calc(var(--lxr) * 1.7vw); }
    .stream-item:nth-child(even) { display: none; }

    /* A full-viewport backdrop-filter re-samples everything beneath it every
       frame, and beneath it is an animating canvas — the most expensive thing
       on this page for a mobile GPU, to soften edges on the smallest screen.
       A painted rim reads the same and costs one composited layer. */
    .hero__vignette {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: radial-gradient(ellipse 78% 74% at 50% 40%, transparent 46%, var(--hero-rim) 92%);
      mask-image: none;
      -webkit-mask-image: none;
    }

    /* Two drop-shadows per item, over a blend mode, on elements already
       carrying a blurred trail. One glow is enough at this size. */
    .stream-item {
      filter:
        saturate(1.4) brightness(1.15)
        drop-shadow(0 0 10px rgba(var(--tint), calc(0.5 * var(--glow-a))));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stream-item {
      animation: none;
      opacity: 0.3;
    }
    .stream-item::before {
      display: none;
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin-inline: auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
  }

  /* ── Announcement Pill ── */
  .hero__announcement {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 4px 14px 4px 4px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(var(--accent-primary-rgb), 0.3);
    background: rgba(var(--accent-primary-rgb), 0.08);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .hero__announcement::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(var(--accent-primary-rgb), 0.12) 40%,
      rgba(var(--accent-secondary-rgb), 0.12) 60%,
      transparent 80%
    );
    background-size: 200% 100%;
    animation: announcement-shimmer 5s ease-in-out infinite;
  }

  @keyframes announcement-shimmer {
    0%, 100% { background-position: 200% 0; }
    50% { background-position: -200% 0; }
  }

  .hero__announcement:hover {
    border-color: rgba(var(--accent-primary-rgb), 0.5);
    background: rgba(var(--accent-primary-rgb), 0.12);
    box-shadow: 0 0 20px rgba(var(--accent-primary-rgb), 0.15), 0 0 40px rgba(var(--accent-secondary-rgb), 0.08);
  }

  .hero__announcement-badge {
    position: relative;
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--gradient-accent-text);
    color: white;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: 1.4;
  }

  .hero__announcement-text {
    position: relative;
    /* Matches the badge's box height exactly: 16px × 1.3 = 20.8px, which is
       12px × 1.4 + 4px of padding. Without it the text is the tallest child, so
       it — not the badge — sets the container height, and centring the shorter
       badge in it added 3.2px above and below. The badge then sat 5px from the
       left and 8.2px from the top, which is what read as off. Equal gaps also
       keep the two pills concentric, since a pill's radius is half its height. */
    line-height: 1.3;
  }

  .hero__announcement-arrow {
    position: relative;
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .hero__announcement:hover .hero__announcement-arrow {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__announcement::before {
      animation: none;
    }
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1;
  }

  .hero__headline-top {
    font-size: clamp(36px, 6vw, 60px);
    font-weight: 200;
    letter-spacing: -1px;
    color: var(--text-primary);
  }

  .hero__headline-glow-wrap {
    position: relative;
    display: block;
    padding-bottom: 12px;
  }

  .hero__headline-glow {
    position: relative;
    font-size: clamp(60px, 10.5vw, 120px);
    font-weight: 600;
    letter-spacing: -3px;
    background: linear-gradient(135deg, rgb(255,255,255) 0%, var(--accent-primary) 50%, var(--accent-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    z-index: 1;
  }

  /* The word the page is named for actually emits: the twin behind it is a
     layered bloom — hot white core, accent halo, wide secondary falloff —
     breathing on the hero's own glow knob so light mode stays calm. */
  .hero__headline-glow-shadow {
    position: absolute;
    inset: 0;
    font-size: clamp(60px, 10.5vw, 120px);
    font-weight: 600;
    letter-spacing: -3px;
    color: transparent;
    text-shadow:
      0 0 14px rgba(255, 255, 255, calc(0.35 * var(--glow-a, 1))),
      0 0 32px rgba(var(--accent-primary-rgb), calc(0.65 * var(--glow-a, 1))),
      0 0 70px rgba(var(--accent-primary-rgb), calc(0.45 * var(--glow-a, 1))),
      0 0 130px rgba(var(--accent-secondary-rgb), calc(0.4 * var(--glow-a, 1)));
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
    user-select: none;
    animation: hero-glow-breathe 5s ease-in-out infinite alternate;
  }

  @keyframes hero-glow-breathe {
    from { opacity: 0.7; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__headline-glow-shadow {
      animation: none;
    }
  }

  .hero__body {
    color: var(--text-secondary);
    max-width: 700px;
    text-align: center;
    text-wrap: balance;
    font-size: var(--text-md);
    line-height: 1.7;
  }

  .hero__body-line {
    display: block;
  }

  .hero__body-line--kicker {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Let the deliberate lines re-wrap naturally on narrow screens */
  @media (max-width: 640px) {
    .hero__body-line {
      display: inline;
    }
    .hero__body-line--kicker {
      display: block;
      margin-top: var(--space-sm);
    }
  }

  .hero__actions {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-sm);
  }

  .hero__accent-line {
    width: 280px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-primary), var(--accent-secondary), transparent);
    margin-top: var(--space-md);
    filter: drop-shadow(0 0 8px rgba(var(--accent-primary-rgb),0.4));
  }

  /* ── Chapter type ──
     Every chapter opens the same way: eyebrow, a two-line statement with one
     lit line, one sentence. The statement is the section header now — there
     are no card grids to carry the argument, the artifact below it does. */
  .section-label {
    font-family: var(--font-accent);
    font-weight: var(--font-label-weight, 600);
    font-size: var(--text-xs);
    letter-spacing: var(--section-title-spacing, 4px);
    text-transform: uppercase;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .statement {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-sm);
    font-size: clamp(44px, 7vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .statement__quiet {
    font-weight: 200;
    color: var(--text-primary);
  }

  .statement__lit {
    font-weight: 600;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 28px rgba(var(--accent-primary-rgb), 0.28));
  }

  /* background-clip: text paints glyphs only where the element's box is —
     any line-height tighter than the glyph extents chops descenders. Every
     clipped element gets its paint box extended in em (so it scales with
     the type) and pulled back with margin so layout doesn't move. */
  .statement__lit,
  .statement__quiet,
  .fw-btn__name,
  .stat-custom__number,
  .hero__headline-glow {
    padding-block: 0.1em 0.2em;
    margin-block: -0.1em -0.2em;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: var(--text-md);
    max-width: 640px;
    text-wrap: balance;
    line-height: 1.7;
    margin-top: var(--space-md);
  }

  /* One claim per line where the copy is written that way; re-wrap naturally
     once the viewport can't hold a full sentence */
  .section-desc__line {
    display: block;
  }

  @media (max-width: 640px) {
    .section-desc__line {
      display: inline;
    }
  }

  .chapter-link {
    color: var(--interactive);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .chapter-link:hover {
    text-decoration: underline;
  }

  /* ── Native: the framework switcher ──
     The first thing after the hero, so it keeps the hero's atmosphere: an
     ambient accent field, the framework names as a display-scale type stack,
     and the code window sitting in its own bloom of light. */
  .native {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: clip;
    background:
      radial-gradient(ellipse 55% 45% at 12% 15%, rgba(var(--accent-primary-rgb), 0.08), transparent 70%),
      radial-gradient(ellipse 45% 55% at 92% 75%, rgba(var(--accent-secondary-rgb), 0.07), transparent 70%);
  }

  .native__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 var(--space-lg);
  }

  .native__header {
    margin-bottom: var(--space-2xl);
  }

  .native__grid {
    /* One value drives both the rotation interval (read by the switcher
       script) and the timer-bar animation. Seconds only. */
    --fw-interval: 6.5s;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: var(--space-2xl);
    align-items: center;
  }

  .fw-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .fw-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: flex-start;
    text-align: start;
    padding: 7px 12px;
    margin: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .fw-btn:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .fw-btn__name {
    font-size: clamp(28px, 3.6vw, 52px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text-ghost);
    transition: color var(--transition-fast);
  }

  .fw-btn:hover .fw-btn__name {
    color: var(--text-secondary);
  }

  .fw-btn.is-active .fw-btn__name {
    font-weight: 600;
    color: transparent;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 18px rgba(var(--accent-primary-rgb), 0.4));
  }

  .fw-btn__idiom {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .fw-btn.is-active .fw-btn__idiom {
    display: block;
  }

  .fw-btn__idiom em {
    font-style: normal;
    color: var(--interactive);
  }

  /* The auto-advance made visible: a timer bar fills under the active name,
     so the rotation reads as a countdown instead of a surprise */
  .fw-btn.is-active::after {
    content: '';
    display: block;
    width: 100%;
    height: 2px;
    margin-top: 4px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    filter: drop-shadow(0 0 6px rgba(var(--accent-primary-rgb), 0.5));
    transform-origin: left center;
  }

  .native__grid.is-auto .fw-btn.is-active::after {
    animation: fw-timer var(--fw-interval) linear;
  }

  @keyframes fw-timer {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .native__grid.is-auto .fw-btn.is-active::after {
      animation: none;
    }
  }

  /* The code window floats in its own light */
  .fw-panels {
    position: relative;
    min-width: 0;
  }

  .fw-panels::before {
    content: '';
    position: absolute;
    inset: -10% -8%;
    background:
      radial-gradient(ellipse 60% 55% at 30% 40%, rgba(var(--accent-primary-rgb), 0.18), transparent 70%),
      radial-gradient(ellipse 50% 60% at 75% 65%, rgba(var(--accent-secondary-rgb), 0.14), transparent 70%);
    filter: blur(28px);
    pointer-events: none;
  }

  .fw-panel {
    position: relative;
  }

  .fw-panel[hidden] {
    display: none;
  }

  /* ── Yours: the response and the tokens, both live ── */
  .yours {
    position: relative;
    padding: var(--space-4xl) 0;
  }

  .yours::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--glow-line-gradient);
    opacity: 0.4;
  }

  .yours__inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0 var(--space-lg);
  }

  .yours__header {
    margin-bottom: var(--space-2xl);
  }

  .yours__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  /* The response pane: what the server actually sends */
  .payload {
    margin: 0;
    min-width: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    overflow: hidden;
  }

  .payload__chrome {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: 10px var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .payload__method {
    font-weight: 700;
    color: var(--accent-primary);
  }

  .payload__url {
    color: var(--text-secondary);
  }

  .payload__meta {
    margin-left: auto;
    color: var(--text-muted);
  }

  .payload__code {
    margin: 0;
    padding: var(--space-lg) 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.8;
    overflow-x: auto;
  }

  .payload__line {
    display: block;
    padding: 0 var(--space-lg);
    white-space: pre;
    color: var(--text-secondary);
  }

  /* The two lines that carry the whole argument glow; a tint, not a border */
  .payload__line--hot {
    background: linear-gradient(90deg,
      rgba(var(--accent-primary-rgb), 0.14),
      rgba(var(--accent-secondary-rgb), 0.05) 70%,
      transparent);
  }

  .payload__line--hot .tk-t,
  .payload__line--hot .tk-a {
    text-shadow: 0 0 12px rgba(var(--accent-primary-rgb), 0.5);
  }

  .tk-p { color: var(--text-muted); }
  .tk-t { color: var(--accent-primary); }
  .tk-a { color: var(--accent-secondary); }
  .tk-s { color: var(--color-success, #7bd88f); }
  .tk-c { color: var(--text-ghost); }

  .payload__caption {
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── Token stage ── */
  .tokens-demo {
    min-width: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
    overflow: hidden;
  }

  .tokens-demo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 10px var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
  }

  .swatches {
    display: flex;
    gap: var(--space-xs);
  }

  .swatch {
    width: 22px;
    height: 22px;
    padding: 0;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    background: linear-gradient(135deg, var(--sw-a), var(--sw-b));
    cursor: pointer;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .swatch:hover {
    transform: scale(1.12);
  }

  .swatch.is-active,
  .swatch:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--bg-card), 0 0 0 4px var(--sw-a), 0 0 14px rgba(var(--accent-primary-rgb), 0.35);
  }

  .tokens-demo__readout {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .tokens-demo__readout em {
    font-style: normal;
    color: var(--accent-primary);
    text-shadow: 0 0 10px rgba(var(--accent-primary-rgb), 0.4);
  }

  .tokens-demo__stage {
    padding: var(--space-xl) var(--space-lg);
    background: radial-gradient(ellipse at center, rgba(var(--accent-primary-rgb), 0.05), transparent 70%);
  }

  .tokens-demo__title {
    font-weight: 600;
    color: var(--text-primary);
  }

  .tokens-demo__controls {
    padding: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--border-subtle);
  }

  .tokens-demo__caption {
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .tokens-demo__caption code {
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  /* ── Gauntlet (CI gates) ── */
  .gauntlet {
    position: relative;
    padding: var(--space-4xl) 0;
  }

  .gauntlet::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--glow-line-gradient);
    opacity: 0.4;
  }

