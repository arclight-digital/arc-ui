---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/Wordmark.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { components } from '../data/components/index';
import { frameworkCount, buildSteps, tokenCount, version, versionShort } from '../data/site-stats';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ARC UI',
  description: `${components.length} dark-first Lit Web Components, generated natively by Prism for React, Vue, Svelte, Angular, Solid, Preact, and plain HTML.`,
  url: 'https://arcui.dev',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  softwareVersion: version,
  license: 'https://opensource.org/license/mit',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const codeExamples = {
  react: `import { Button, Card, Input, Toggle } from '@arclux/arc-ui-react';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" placeholder="Your name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save Changes</Button>
    </Card>
  );
}`,
  vue: `<template>
  <Card>
    <h3>Preferences</h3>
    <Input label="Display name" placeholder="Your name" />
    <Toggle label="Dark mode" :checked="true" />
    <Button variant="primary">Save Changes</Button>
  </Card>
</template>

<script setup>
import { Button, Card, Input, Toggle } from '@arclux/arc-ui-vue';
</script>`,
  svelte: `<script>
  import { Button, Card, Input, Toggle } from '@arclux/arc-ui-svelte';
</script>

<Card>
  <h3>Preferences</h3>
  <Input label="Display name" placeholder="Your name" />
  <Toggle label="Dark mode" checked />
  <Button variant="primary">Save Changes</Button>
</Card>`,
  angular: `import { Component } from '@angular/core';
import { Button, Card, Input, Toggle } from '@arclux/arc-ui-angular';

@Component({
  selector: 'app-settings',
  imports: [Button, Card, Input, Toggle],
  template: \`
    <arc-card>
      <h3>Preferences</h3>
      <arc-input label="Display name" placeholder="Your name"></arc-input>
      <arc-toggle label="Dark mode" checked></arc-toggle>
      <arc-button variant="primary">Save Changes</arc-button>
    </arc-card>
  \`,
})
export class SettingsComponent {}`,
  solid: `import { Button, Card, Input, Toggle } from '@arclux/arc-ui-solid';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" placeholder="Your name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save Changes</Button>
    </Card>
  );
}`,
  preact: `import { Button, Card, Input, Toggle } from '@arclux/arc-ui-preact';

function Settings() {
  return (
    <Card>
      <h3>Preferences</h3>
      <Input label="Display name" placeholder="Your name" />
      <Toggle label="Dark mode" checked />
      <Button variant="primary">Save Changes</Button>
    </Card>
  );
}`,
  html: `<arc-card>
  <h3>Preferences</h3>
  <arc-input label="Display name" placeholder="Your name"></arc-input>
  <arc-toggle label="Dark mode" checked></arc-toggle>
  <arc-button variant="primary">Save Changes</arc-button>
</arc-card>

<script type="module">
  import '@arclux/arc-ui/register';
</script>`
};
---

<BaseLayout description={jsonLd.description}>
  <!-- Top Bar -->
  <div class="theme-fixed">
    <arc-top-bar fixed nav-align="left" mobile-menu="nav">
      <div slot="logo">
        <Wordmark />
      </div>
      <arc-navigation-menu slot="center">
        <arc-nav-item href="/docs/getting-started">Docs</arc-nav-item>
        <arc-nav-item href="/docs/components">Components</arc-nav-item>
        <arc-nav-item href="/docs/tokens">Tokens</arc-nav-item>
        <arc-nav-item href="/docs/theme-synthesizer">Synthesizer</arc-nav-item>
      </arc-navigation-menu>
      <div slot="actions" class="topbar-actions">
        <arc-badge variant="primary" class="topbar-version">{versionShort}</arc-badge>
        <arc-theme-toggle icon-only></arc-theme-toggle>
        <arc-icon-button href="https://github.com/Arclight-Digital/arc-ui" name="github-logo" label="GitHub" variant="ghost" size="sm"></arc-icon-button>
      </div>
    </arc-top-bar>
  </div>

  <!-- Hero -->
  <header class="hero">
    <canvas class="hero__canvas" id="hero-canvas"></canvas>
    <div class="hero__stream" aria-hidden="true" inert>
      <div class="stream-item" style="--lxr:-30; --ly:-4vh;  --dur:12s;   --delay:-2s;   --z0:-520px; --angle:4deg;    --trail:170px; --tint:var(--accent-primary-rgb)">
        <arc-button variant="primary" size="sm">Get started</arc-button>
      </div>
      <div class="stream-item" style="--lxr:-23; --ly:15vh;  --dur:10s;   --delay:-7s;   --z0:-780px; --angle:-19deg;  --trail:150px; --tint:var(--accent-secondary-rgb)">
        <arc-toggle checked label="Dark mode"></arc-toggle>
      </div>
      <div class="stream-item" style="--lxr:-35; --ly:7vh;   --dur:9s;    --delay:-4.5s; --z0:-380px; --angle:-6deg;   --trail:130px; --tint:var(--accent-primary-rgb)">
        <arc-badge variant="success">Stable</arc-badge>
      </div>
      <div class="stream-item" style="--lxr:-20; --ly:-17vh; --dur:11s;   --delay:-9s;   --z0:-900px; --angle:24deg;   --trail:160px; --tint:var(--accent-secondary-rgb)">
        <arc-rating value="5" readonly></arc-rating>
      </div>
      <div class="stream-item" style="--lxr:-33; --ly:-15vh; --dur:13s;   --delay:-6s;   --z0:-640px; --angle:14deg;   --trail:180px; --tint:var(--accent-primary-rgb)">
        <arc-stat value={String(components.length)} label="Components" trend="up" change="+7"></arc-stat>
      </div>
      <div class="stream-item" style="--lxr:-26; --ly:25vh;  --dur:10.5s; --delay:-1s;   --z0:-450px; --angle:-27deg;  --trail:150px; --tint:var(--accent-primary-rgb)">
        <arc-checkbox checked label="Ship it"></arc-checkbox>
      </div>
      <div class="stream-item" style="--lxr:28;  --ly:-7vh;  --dur:10s;   --delay:-3s;   --z0:-560px; --angle:172deg;  --trail:160px; --tint:var(--accent-secondary-rgb)">
        <arc-avatar name="Arc Light" status="online"></arc-avatar>
      </div>
      <div class="stream-item" style="--lxr:31;  --ly:11vh;  --dur:12.5s; --delay:-8s;   --z0:-700px; --angle:-169deg; --trail:180px; --w:180px; --tint:var(--accent-primary-rgb)">
        <arc-progress value="72" label="Deploying"></arc-progress>
      </div>
      <div class="stream-item" style="--lxr:22;  --ly:-19vh; --dur:9.5s;  --delay:-5.5s; --z0:-820px; --angle:155deg;  --trail:150px; --tint:var(--accent-primary-rgb)">
        <arc-chip selected>Web Components</arc-chip>
      </div>
      <div class="stream-item" style="--lxr:35;  --ly:-12vh; --dur:11.5s; --delay:-0.5s; --z0:-360px; --angle:170deg;  --trail:130px; --tint:var(--accent-secondary-rgb)">
        <arc-tag>Lit 3</arc-tag>
      </div>
      <div class="stream-item" style="--lxr:25;  --ly:21vh;  --dur:13.5s; --delay:-10s;  --z0:-880px; --angle:-156deg; --trail:170px; --w:160px; --tint:var(--accent-secondary-rgb)">
        <arc-slider value="64" label="Glow"></arc-slider>
      </div>
      <div class="stream-item" style="--lxr:34;  --ly:2vh;   --dur:10.8s; --delay:-6.8s; --z0:-600px; --angle:-178deg; --trail:160px; --tint:var(--accent-primary-rgb)">
        <arc-sparkline data="4,9,6,12,9,16,13,20" fill></arc-sparkline>
      </div>
    </div>
    <div class="hero__ambient"></div>
    <div class="hero__dots"></div>
    <div class="hero__vignette"></div>
    <div class="hero__content">
      <a href="/docs/changelog" class="hero__announcement">
        <span class="hero__announcement-badge">{versionShort}</span>
        <span class="hero__announcement-text">Every import typed to the leaf, and typography you assign</span>
        <svg class="hero__announcement-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <h1 class="hero__headline">
        <span class="hero__headline-top">Components that</span>
        <span class="hero__headline-glow-wrap">
          <span class="hero__headline-glow">glow.</span>
          <span class="hero__headline-glow-shadow" aria-hidden="true">glow.</span>
        </span>
      </h1>
      <p class="hero__body">
        <span class="hero__body-line">{components.length} dark-first components, written once as standard Web Components and</span>
        <span class="hero__body-line">generated into native packages for React, Vue, Svelte, Angular, Solid, Preact and HTML.</span>
        <span class="hero__body-line hero__body-line--kicker">Change framework without changing your design system.</span>
      </p>
      <arc-code-block variant="basic" language="bash" code="npm install @arclux/arc-ui"></arc-code-block>
      <div class="hero__actions">
        <arc-button href="/docs/getting-started" variant="primary" size="md">
          Get Started
          <svg slot="suffix" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </arc-button>
        <arc-button href="/docs/components" variant="secondary" size="md">Explore Components</arc-button>
      </div>
      <div class="hero__accent-line"></div>
    </div>
  </header>

  <main>
    <arc-divider></arc-divider>

    <!-- The multi-framework argument: same component, each framework's own idiom -->
    <section class="idioms">
      <div class="idioms__inner">
        <div class="idioms__header reveal">
          <span class="section-label">Not a wrapper</span>
          <h2 class="section-title">Native in every framework.</h2>
          <p class="section-desc">
            Most libraries make you pick a framework, and that choice outlives its usefulness.
            Prism reads each Lit component and generates a real package per target — so every
            one speaks its own language rather than making you speak the library's.
          </p>
        </div>

        <div class="idiom-groups">
          <div class="idiom-group reveal">
            <div class="idiom-group__head">
              <span class="idiom-group__name">Two-way bound</span>
              <span class="idiom-group__note">The binding your framework already has</span>
            </div>
            <ul class="idiom-list">
              <li class="idiom">
                <span class="idiom__fw">Svelte</span>
                <code class="idiom__code">&lt;Slider <em>bind:value</em>=&#123;volume&#125; /&gt;</code>
              </li>
              <li class="idiom">
                <span class="idiom__fw">Vue</span>
                <code class="idiom__code">&lt;Slider <em>v-model:value</em>="volume" /&gt;</code>
              </li>
              <li class="idiom">
                <span class="idiom__fw">Angular</span>
                <code class="idiom__code">&lt;arc-slider <em>[(value)]</em>="volume"&gt;</code>
              </li>
            </ul>
          </div>

          <div class="idiom-group reveal">
            <div class="idiom-group__head">
              <span class="idiom-group__name">Controlled</span>
              <span class="idiom-group__note">Typed events, no <code>useRef</code> dance</span>
            </div>
            <ul class="idiom-list">
              <li class="idiom">
                <span class="idiom__fw">React</span>
                <code class="idiom__code">&lt;Slider value=&#123;v&#125; <em>onArcInput</em>=&#123;e =&gt; setV(e.detail.value)&#125; /&gt;</code>
              </li>
              <li class="idiom">
                <span class="idiom__fw">Solid</span>
                <code class="idiom__code">&lt;Slider value=&#123;v()&#125; <em>onArcInput</em>=&#123;handle&#125; /&gt;</code>
              </li>
              <li class="idiom">
                <span class="idiom__fw">Preact</span>
                <code class="idiom__code">&lt;Slider value=&#123;v&#125; <em>onArcInput</em>=&#123;handle&#125; /&gt;</code>
              </li>
            </ul>
          </div>

          <div class="idiom-group reveal">
            <div class="idiom-group__head">
              <span class="idiom-group__name">No build step</span>
              <span class="idiom-group__note">A script tag and an attribute</span>
            </div>
            <ul class="idiom-list">
              <li class="idiom">
                <span class="idiom__fw">HTML</span>
                <code class="idiom__code">&lt;arc-slider <em>value</em>="64"&gt;&lt;/arc-slider&gt;</code>
              </li>
            </ul>
          </div>
        </div>

        <p class="idioms__footnote reveal">
          Same component, same tokens, same accessibility — in every one. Forms submit through
          <code>ElementInternals</code>, so <code>form.reset()</code> and validation work natively
          rather than being reimplemented per framework.
        </p>
      </div>
    </section>

    <arc-divider></arc-divider>

    <!-- Editor integration — a standing capability, not a release note -->
    <section class="whats-new">
      <div class="whats-new__inner">
        <div class="whats-new__header reveal">
          <span class="section-label">Editor integration</span>
          <h2 class="section-title">Your editor already knows.</h2>
          <p class="section-desc">
            Every component documents its full API in <code>custom-elements.json</code>, which
            becomes autocomplete in your editor, typed events in TypeScript, and warnings in your
            console — including on the deep imports, which all publish types.
          </p>
        </div>
        <div class="whats-new__grid">
          <div class="editor-demo reveal" id="editor-demo">
            <p class="sr-only">
              Animated demo: an editor autocompletes the variant attribute of an
              arc-button with the values primary, secondary, and ghost, showing hover
              documentation, and the live button below updates as each value is accepted.
            </p>
            <div class="editor-demo__window" aria-hidden="true">
              <div class="editor-demo__chrome">
                <span class="editor-demo__dot"></span>
                <span class="editor-demo__dot"></span>
                <span class="editor-demo__dot"></span>
                <span class="editor-demo__filename">index.html</span>
              </div>
              <div class="editor-demo__code">
                <span class="editor-demo__punct">&lt;</span><span class="editor-demo__tag">arc-button</span>&nbsp;<span class="editor-demo__attr">variant</span><span class="editor-demo__punct">=</span><span class="editor-demo__str">"<span id="editor-demo-typed"></span></span><span class="editor-demo__caret"></span>
                <div class="editor-demo__suggest" id="editor-demo-suggest">
                  <div class="editor-demo__rows">
                    <div class="editor-demo__row is-active" data-value="primary"><span class="editor-demo__row-icon">□</span>primary</div>
                    <div class="editor-demo__row" data-value="secondary"><span class="editor-demo__row-icon">□</span>secondary</div>
                    <div class="editor-demo__row" data-value="ghost"><span class="editor-demo__row-icon">□</span>ghost</div>
                  </div>
                  <div class="editor-demo__doc">
                    <span class="editor-demo__doc-title">variant</span>
                    Controls the visual weight and emphasis. Primary is a filled button
                    with a neon glow hover suited for the top-level CTA.
                  </div>
                </div>
              </div>
            </div>
            <div class="editor-demo__stage">
              <span class="editor-demo__stage-label">Live component</span>
              <arc-button variant="primary" size="md" id="editor-demo-btn">Launch</arc-button>
            </div>
          </div>
          <div class="whats-new__list">
            <div class="whats-new__item reveal">
              <div class="whats-new__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M8 4c-2 0-2 2-2 3v2c0 1-1 2-2 2 1 0 2 1 2 2v3c0 1 0 3 2 3M16 4c2 0 2 2 2 3v2c0 1 1 2 2 2-1 0-2 1-2 2v3c0 1 0 3-2 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </div>
              <div>
                <h3 class="whats-new__title">Autocomplete everywhere</h3>
                <p class="whats-new__desc">Tags, attributes, and allowed values complete in VS Code and JetBrains, hover docs included. One settings line to enable — or none.</p>
              </div>
            </div>
            <div class="whats-new__item reveal">
              <div class="whats-new__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 7V5h10v2M9 5v14M7 19h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 13c0-1 1-2 2.5-2s2.5.8 2.5 2c0 2-5 2-5 4 0 1.2 1 2 2.5 2s2.5-1 2.5-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </div>
              <div>
                <h3 class="whats-new__title">Typed to the detail</h3>
                <p class="whats-new__desc">Every arc-* event carries a typed payload in TypeScript, and React 19 JSX type-checks each tag — no wrapper required.</p>
              </div>
            </div>
            <div class="whats-new__item reveal">
              <div class="whats-new__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 6l6 6-6 6M12 18h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div>
                <h3 class="whats-new__title">A console that coaches</h3>
                <p class="whats-new__desc">Import <code>@arclux/arc-ui/dev</code> and invalid values, attribute typos, and camelCase slips get flagged — each with a link to the right docs page.</p>
              </div>
            </div>
            <div class="whats-new__cta reveal">
              <arc-button href="/docs/changelog" variant="ghost" size="sm">
                Full changelog
                <svg slot="suffix" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </arc-button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <arc-divider variant="glow"></arc-divider>
    <section class="stats">
      <div class="stats__ambient"></div>
      <div class="stats__grid">
        <div class="stat-custom reveal">
          <arc-animated-number class="stat-custom__number" value="0" data-target={`${components.length}`}>{components.length}</arc-animated-number>
          <div class="stat-custom__rule"></div>
          <span class="stat-custom__label">Components</span>
        </div>
        <div class="stat-custom reveal">
          <arc-animated-number class="stat-custom__number" value="0" data-target={`${frameworkCount}`}>{frameworkCount}</arc-animated-number>
          <div class="stat-custom__rule"></div>
          <span class="stat-custom__label">Frameworks</span>
        </div>
        <div class="stat-custom reveal">
          <arc-animated-number class="stat-custom__number" value="0" data-target={`${buildSteps}`}>{buildSteps}</arc-animated-number>
          <div class="stat-custom__rule"></div>
          <span class="stat-custom__label">Build Steps</span>
        </div>
        <div class="stat-custom reveal">
          <arc-animated-number class="stat-custom__number" value="0" data-target={`${tokenCount}`}>{tokenCount}</arc-animated-number>
          <div class="stat-custom__rule"></div>
          <span class="stat-custom__label">Design Tokens</span>
        </div>
      </div>
    </section>
    <arc-divider variant="glow"></arc-divider>

    <!-- Features -->
    <section class="features">
      <div class="features__inner">
        <div class="features__header reveal">
          <span class="section-label">Why ARC UI</span>
          <h2 class="section-title">Standards, not a stack.</h2>
          <p class="section-desc">
            The core is custom elements — a browser feature, not a dependency. That is what lets
            one component serve seven targets, survive a framework migration, and still render
            when the JavaScript never arrives.
          </p>
        </div>

        <div class="features__grid">
          <arc-feature-card heading="Web Components First" description="Built on Lit, running on web standards. No proprietary abstractions — just custom elements that work everywhere." class="reveal">
            <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </arc-feature-card>

          <arc-feature-card heading="Typed to the leaf" description="Every subpath publishes types, not just the root — so a deep import is checked, not implicitly any. Object props carry their real shape, and each arc-* event a typed payload." class="reveal">
            <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><line x1="4" y1="22" x2="4" y2="15" stroke="currentColor" stroke-width="1.5"/></svg>
          </arc-feature-card>

          <arc-feature-card heading="Yours, not ours" description="Override 2–4 base tokens and every gradient, glow and focus ring cascades. Typography is role slots, not bundled fonts — assign your own typefaces and the whole system follows." class="reveal">
            <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </arc-feature-card>

          <arc-feature-card heading="Lean by Design" description="One runtime: Lit. Heavier extras — syntax highlighting, QR encoding — load only with the components that use them, and per-component imports keep the rest out of your bundle." class="reveal">
            <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </arc-feature-card>

          <arc-feature-card heading="Works before JavaScript" description="Links navigate and forms submit without the bundle. A standalone CSS package renders class-based components with no JS at all — server-rendered pages stay usable while everything else loads." class="reveal">
            <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </arc-feature-card>

          <arc-feature-card heading="Accessible" description="WAI-ARIA APG patterns component by component — focus traps, roving tabindex, live regions, reduced motion. Keyboard-first, not keyboard-eventually." class="reveal">
            <svg slot="icon" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </arc-feature-card>
        </div>
      </div>
    </section>

    <!-- Live Showcase -->
    <section class="showcase-section">
      <div class="showcase-section__inner">
        <div class="showcase-section__header reveal">
          <span class="section-label">Live Demo</span>
          <h2 class="section-title">See it in action.</h2>
          <p class="section-desc">Nothing below is a screenshot — every widget is a real ARC UI component running live on this page. Click around.</p>
        </div>

        <div class="showcase-grid">
          <!-- 1. Buttons -->
          <div class="showcase-card reveal">
