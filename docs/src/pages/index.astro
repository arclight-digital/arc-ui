<script>
  /* ── Light-Tunnel Canvas ──
     A tube of light beams the camera flies through: the core stays dark
     (that's where the headline lives), the walls stream with accent-colored
     streaks. The DOM component stream (.hero__stream) shares this camera:
     perspective 900px, vanishing point at 50% 40%. */
  function initCanvas() {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    // Guard against double init: on first load both the direct call and
    // astro:page-load fire, and two rAF loops fighting over one canvas
    // makes the opening seconds stutter
    if ((canvas as any).__arcTunnel) return;
    (canvas as any).__arcTunnel = true;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const rootStyles = getComputedStyle(document.documentElement);
    const BLUE = rootStyles.getPropertyValue('--accent-primary-rgb').trim() || '77,126,247';
    const PURPLE = rootStyles.getPropertyValue('--accent-secondary-rgb').trim() || '139,92,246';

    // Live theme check: additive glow works on dark; on light backgrounds
    // beams switch to multiply so they read as tinted streaks, not fog
    const lightMql = window.matchMedia('(prefers-color-scheme: light)');
    function isLight() {
      const t = document.documentElement.getAttribute('data-theme');
      return t === 'light' || (t !== 'dark' && lightMql.matches);
    }

    const P = 900;        // must match .hero__stream's CSS perspective
    const Z_SPAWN = 3600; // beams are born deep in the tube
    const Z_KILL = 120;   // and die just before they'd hit the camera

    let width = 0;
    let height = 0;
    let animId = 0;
    let last = 0;
    let time = 0;

    // Warp model: boost decays toward cruise and is fed only by
    // scrolling. warp = 1 + boost. The tunnel starts AT cruise — no
    // arrival deceleration, nothing to visibly settle.
    let boost = 0;
    let lastScrollY = window.scrollY;
    let streamAnims: Animation[] = [];
    let lastRate = 1;
    let lastPx = 0;
    let lastPy = 0;

    interface Beam {
      theta: number;  // angle around the tube wall
      z: number;      // depth, world units in front of the camera
      len: number;    // beam length along the tube
      speed: number;  // world units per second toward the camera
      color: string;
      girth: number;
      phase: number;  // flicker phase
      freq: number;   // flicker frequency
    }
    interface Mote {
      theta: number;
      rad: number;    // fraction of the tube radius, keeps the core clear
      z: number;
      speed: number;
      color: string;
    }
    const beams: Beam[] = [];
    const motes: Mote[] = [];

    function beamColor() {
      const r = Math.random();
      return r < 0.68 ? BLUE : r < 0.94 ? PURPLE : '255,255,255';
    }

    function spawnBeam(b: Beam, anywhere = false) {
      b.theta = Math.random() * Math.PI * 2;
      b.z = anywhere
        ? Z_KILL + Math.random() * (Z_SPAWN - Z_KILL)
        : Z_SPAWN - Math.random() * 700;
      b.len = 280 + Math.random() * 520;
      b.speed = 450 + Math.random() * 550;
      b.color = beamColor();
      b.girth = 0.6 + Math.random() * 0.9;
      b.phase = Math.random() * Math.PI * 2;
      b.freq = 4 + Math.random() * 6;
    }

    function spawnMote(m: Mote, anywhere = false) {
      m.theta = Math.random() * Math.PI * 2;
      m.rad = 0.35 + Math.random() * 0.75;
      m.z = anywhere
        ? Z_KILL + Math.random() * (Z_SPAWN - Z_KILL)
        : Z_SPAWN - Math.random() * 600;
      m.speed = 480 + Math.random() * 420;
      const r = Math.random();
      m.color = r < 0.5 ? '255,255,255' : r < 0.85 ? BLUE : PURPLE;
    }

    function resize() {
      const rect = canvas.parentElement!.getBoundingClientRect();
      // Sub-native backing resolution: the upscale is free bloom
      const dpr = Math.min(window.devicePixelRatio, 2) * 0.7;
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const beamTarget = Math.max(30, Math.min(56, Math.round((width * height) / 28000)));
      while (beams.length < beamTarget) {
        const b = {} as Beam;
        spawnBeam(b, true);
        beams.push(b);
      }
      beams.length = beamTarget;

      const moteTarget = Math.max(40, Math.min(70, Math.round((width * height) / 24000)));
      while (motes.length < moteTarget) {
        const m = {} as Mote;
        spawnMote(m, true);
        motes.push(m);
      }
      motes.length = moteTarget;
    }

    // Cursor parallax: the vanishing point drifts a little, in canvas and
    // CSS together so beams and components stay on the same tube
    let mx = 0, my = 0;   // smoothed offset, -1..1
    let tmx = 0, tmy = 0; // targets
    const stream = document.querySelector('.hero__stream') as HTMLElement | null;

    function drawFrame(dt: number) {
      time += dt;

      // Boost decays smoothly back to cruise
      boost *= Math.exp(-dt * 1.15);
      const warp = 1 + boost;

      // Camera: mouse parallax + a slow ambient sway (canvas only — the
      // DOM layer is touched solely when the parallax actually moves)
      mx += (tmx - mx) * Math.min(1, dt * 3);
      my += (tmy - my) * Math.min(1, dt * 3);
      const px = mx * 16;
      const py = my * 12;
      const cx = width * 0.5 + px + Math.sin(time * 0.32) * 6;
      const cy = height * 0.4 + py + Math.cos(time * 0.21) * 5;
      if (stream && (Math.abs(px - lastPx) > 0.5 || Math.abs(py - lastPy) > 0.5)) {
        lastPx = px;
        lastPy = py;
        stream.style.perspectiveOrigin =
          `calc(50% + ${px.toFixed(1)}px) calc(40% + ${py.toFixed(1)}px)`;
      }

      const light = isLight();
      const aScale = light ? 0.5 : 1;

      // Components ride the same surges: their CSS animations take the
      // warp factor as a playback rate
      if (!streamAnims.length && stream && time < 3) {
        streamAnims = stream.getAnimations({ subtree: true });
      }
      const rate = 1 + boost * 0.7;
      if (Math.abs(rate - lastRate) > 0.04) {
        lastRate = rate;
        for (const anim of streamAnims) anim.playbackRate = rate;
      }

      const rx = width * 0.62;  // tube wall radii — outside the headline
      const ry = height * 0.62;

      ctx!.clearRect(0, 0, width, height);
      ctx!.globalCompositeOperation = light ? 'multiply' : 'lighter';
      ctx!.lineCap = 'round';

      // Wall beams: white-hot tip, flicker, stretched by warp speed
      for (const b of beams) {
        b.z -= b.speed * warp * dt;
        if (b.z < Z_KILL) spawnBeam(b);

        const ux = Math.cos(b.theta);
        const uy = Math.sin(b.theta);
        const lenEff = b.len * (1 + boost * 1.2);
        const s1 = P / b.z;             // near end of the beam
        const s2 = P / (b.z + lenEff);  // far end
        const x1 = cx + rx * ux * s1;
        const y1 = cy + ry * uy * s1;
        const x2 = cx + rx * ux * s2;
        const y2 = cy + ry * uy * s2;

        // Fade in as the beam approaches; deep beams stay dark so the
        // tunnel core reads as black
        const flick = 0.8 + 0.2 * Math.sin(time * b.freq + b.phase);
        const a = Math.min(1, (Z_SPAWN - b.z) / 1400) * 0.55 * flick * aScale;
        if (a <= 0.01) continue;
        if (
          (x1 < -60 && x2 < -60) || (x1 > width + 60 && x2 > width + 60) ||
          (y1 < -60 && y2 < -60) || (y1 > height + 60 && y2 > height + 60)
        ) continue;

        // White-hot tips glow on dark; on light the tip stays tinted
        // (white multiplies to nothing)
        const tip = light
          ? `rgba(${b.color},${Math.min(1, a * 1.4)})`
          : `rgba(255,255,255,${Math.min(1, a * 0.7)})`;
        const grad = ctx!.createLinearGradient(x1, y1, x2, y2);
        grad.addColorStop(0, tip);
        grad.addColorStop(0.18, `rgba(${b.color},${a})`);
        grad.addColorStop(1, `rgba(${b.color},0)`);
        ctx!.strokeStyle = grad;

        // Two soft passes, no hard core — the canvas blur does the rest
        ctx!.lineWidth = Math.min(16, 2 + 9 * s1) * b.girth;
        ctx!.globalAlpha = 0.28;
        ctx!.beginPath();
        ctx!.moveTo(x1, y1);
        ctx!.lineTo(x2, y2);
        ctx!.stroke();
        ctx!.lineWidth = Math.min(3.5, 0.8 + 2 * s1) * b.girth;
        ctx!.globalAlpha = 0.5;
        ctx!.stroke();
      }

      // Depth dust between the walls; streaks hard when the tunnel surges
      for (const m of motes) {
        m.z -= m.speed * warp * dt;
        if (m.z < Z_KILL) spawnMote(m);
        const ux = Math.cos(m.theta);
        const uy = Math.sin(m.theta);
        const s1 = P / m.z;
        const s2 = P / (m.z + 50 + 500 * boost);
        const x1 = cx + rx * m.rad * ux * s1;
        const y1 = cy + ry * m.rad * uy * s1;
        const a = Math.min(1, (Z_SPAWN - m.z) / 1600) * 0.22 * aScale;
        if (a <= 0.01) continue;
        if (x1 < -40 || x1 > width + 40 || y1 < -40 || y1 > height + 40) continue;
        const x2 = cx + rx * m.rad * ux * s2;
        const y2 = cy + ry * m.rad * uy * s2;
        // White dust vanishes under multiply — tint it on light themes
        const mc = light && m.color === '255,255,255' ? BLUE : m.color;
        ctx!.strokeStyle = `rgba(${mc},${a})`;
        ctx!.lineWidth = 2;
        ctx!.beginPath();
        ctx!.moveTo(x1, y1);
        ctx!.lineTo(x2, y2);
        ctx!.stroke();
      }

      ctx!.globalAlpha = 1;
      ctx!.globalCompositeOperation = 'source-over';
    }

    function frame(now: number) {
      // Tight dt cap: heavy frames during page load advance the world
      // gently instead of visibly jumping
      const dt = Math.min((now - last) / 1000, 0.033);
      last = now;
      drawFrame(dt);
      animId = requestAnimationFrame(frame);
    }

    resize();

    const hero = canvas.parentElement!;

    // Grab the stream animations up front so their playback rate is set
    // before anything is visible — no mid-flight speed snap
    if (stream) streamAnims = stream.getAnimations({ subtree: true });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      // One still frame at cruise speed: the tube is visible, nothing moves
      drawFrame(0);
      hero.classList.add('hero--live');
      const redraw = () => {
        resize();
        drawFrame(0);
      };
      window.addEventListener('resize', redraw);
      document.addEventListener('astro:before-swap', () => {
        window.removeEventListener('resize', redraw);
      }, { once: true });
      return;
    }

    function onMouseMove(e: MouseEvent) {
      tmx = (e.clientX / window.innerWidth) * 2 - 1;
      tmy = (e.clientY / window.innerHeight) * 2 - 1;
    }

    function onMouseOut(e: MouseEvent) {
      if (!e.relatedTarget) {
        tmx = 0;
        tmy = 0;
      }
    }

    // Scrolling feeds the warp: leaving the hero feels like launching
    function onScroll() {
      const y = window.scrollY;
      const dy = Math.abs(y - lastScrollY);
      lastScrollY = y;
      boost = Math.min(3, boost + Math.min(0.5, dy * 0.0035));
    }

    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('mouseout', onMouseOut);
    window.addEventListener('scroll', onScroll, { passive: true });

    animId = requestAnimationFrame((t) => {
      last = t;
      animId = requestAnimationFrame(frame);
      // Reveal only after the first frame is painted: load-time jank
      // happens behind a fade instead of in front of the visitor
      hero.classList.add('hero--live');
    });

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animId);
      window.removeEventListener('resize', resize);
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseout', onMouseOut);
      window.removeEventListener('scroll', onScroll);
      if (stream) stream.style.perspectiveOrigin = '';
    }, { once: true });
  }

  /* ── Reveal on scroll ── */
  function initReveal() {
    const els = document.querySelectorAll('.reveal');
    if (!els.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    els.forEach(el => observer.observe(el));
  }

  /* ── Stat count-up ── */
  function initStatCountUp() {
    const nums = document.querySelectorAll('arc-animated-number[data-target]');
    if (!nums.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as any;
          const target = el.dataset.target;
          if (prefersReducedMotion) {
            el.value = target;
          } else {
            // Small delay for visual effect
            requestAnimationFrame(() => { el.value = target; });
          }
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.3 });

    nums.forEach(el => observer.observe(el));
  }

  /* ── Editor autocomplete demo ── */
  function initEditorDemo() {
    const demo = document.getElementById('editor-demo');
    if (!demo || (demo as any).dataset.demoInit) return;
    (demo as any).dataset.demoInit = '1';

    const typed = document.getElementById('editor-demo-typed')!;
    const suggest = document.getElementById('editor-demo-suggest')!;
    const btn = document.getElementById('editor-demo-btn')!;
    const rows = Array.from(suggest.querySelectorAll<HTMLElement>('.editor-demo__row'));
    const values = rows.map((r) => r.dataset.value!);

    const setActive = (i: number) => rows.forEach((r, j) => r.classList.toggle('is-active', i === j));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Static tableau: dropdown open on the first value, docs visible.
      suggest.classList.add('is-open');
      return;
    }

    let stopped = false;
    document.addEventListener('astro:before-swap', () => { stopped = true; }, { once: true });
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function run() {
      let target = 0;
      for (;;) {
        typed.textContent = '';
        setActive(0);
        await sleep(700);
        if (stopped) return;
        suggest.classList.add('is-open');
        await sleep(900);
        // Arrow down to the target value.
        for (let i = 1; i <= target; i++) {
          if (stopped) return;
          setActive(i);
          await sleep(420);
        }
        await sleep(650);
        if (stopped) return;
        // Accept: complete the attribute, close the dropdown, morph the button.
        typed.textContent = `${values[target]}"`;
        suggest.classList.remove('is-open');
        btn.setAttribute('variant', values[target]);
        await sleep(2400);
        if (stopped) return;
        target = (target + 1) % values.length;
      }
    }

    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        run();
      }
    }, { threshold: 0.4 });
    io.observe(demo);
  }

  async function initNavigation() {
    const { navigate } = await import('astro:transitions/client');
    document.addEventListener('arc-navigate', (e: any) => {
      const href = e.detail?.href;
      if (href) {
        e.preventDefault();
        navigate(href);
      }
    });
  }

  initCanvas();
  initReveal();
  initStatCountUp();
  initEditorDemo();
  initNavigation();
  document.addEventListener('astro:page-load', () => {
    initCanvas();
    initReveal();
    initStatCountUp();
    initEditorDemo();
    initNavigation();
  });
</script>

