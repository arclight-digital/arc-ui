---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { version } from '../../data/site-stats';

const headings = [
  { id: 'overview', label: 'Overview' },
  { id: 'react', label: 'React' },
  { id: 'vue', label: 'Vue' },
  { id: 'svelte', label: 'Svelte' },
  { id: 'angular', label: 'Angular' },
  { id: 'solid', label: 'Solid' },
  { id: 'preact', label: 'Preact' },
  { id: 'no-wrapper', label: 'Without a wrapper' },
  { id: 'vanilla', label: 'Vanilla JS / CDN' },
];
---

<DocsLayout
  title="Frameworks"
  description="Use ARC UI with React, Vue, Svelte, Angular, Solid, Preact, or vanilla JS."
  activeSlug="frameworks"
  headings={headings}
  breadcrumbs={[{ label: 'Frameworks' }]}
>
  <div class="frameworks-page">
    <h1 class="page-title">Frameworks</h1>
    <p class="page-desc">
      Install and use ARC UI in React, Vue, Svelte, Angular, Solid and Preact, or with no
      framework.
    </p>

    <section id="overview">
      <h2 class="docs-heading">Overview</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        The core <code>@arclux/arc-ui</code> package is Lit custom elements, which work with any
        framework or none. <strong>Prism</strong>, the project's code generator, reads the Lit
        source and writes a wrapper package for each of the six frameworks below. A wrapper
        adds:
      </p>
      <ul class="docs-list">
        <li>Events bound the framework's way, such as React's <code>onClick</code> and Vue's <code>@click</code></li>
        <li>TypeScript types for every prop</li>
        <li>Named imports per component, such as <code>{'{'} Button, Card {'}'}</code></li>
      </ul>
    </section>

    <section id="react">
      <h2 class="docs-heading">React</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">Published as <arc-badge variant="primary">@arclux/arc-ui-react</arc-badge>. Install it with the core package and Lit:</p>
      <div class="docs-code"><arc-code-block language="bash" code="npm install @arclux/arc-ui-react @arclux/arc-ui lit"></arc-code-block></div>
      <div class="docs-code"><arc-code-block language="jsx" code={`import '@arclux/arc-ui/base.css';
import { Button, Card, Input } from '@arclux/arc-ui-react';

function App() {
  return (
    <Card>
      <h3>Sign In</h3>
      <Input label="Email" placeholder="you@example.com" />
      <Button variant="primary" onClick={() => console.log('clicked')}>
        Submit
      </Button>
    </Card>
  );
}`}></arc-code-block></div>
      <p class="docs-text">
        The React wrappers are built with <code>@lit/react</code>'s <code>createComponent</code>,
        which handles event binding and ref forwarding.
      </p>
    </section>

    <section id="vue">
      <h2 class="docs-heading">Vue</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">Published as <arc-badge variant="primary">@arclux/arc-ui-vue</arc-badge>. Install it with the core package and Lit:</p>
      <div class="docs-code"><arc-code-block language="bash" code="npm install @arclux/arc-ui-vue @arclux/arc-ui lit"></arc-code-block></div>
      <div class="docs-code"><arc-code-block language="vue" code={`<script setup>
import '@arclux/arc-ui/base.css';
import { Button, Card } from '@arclux/arc-ui-vue';
</script>

<template>
  <Card>
    <h3>Hello Vue</h3>
    <Button variant="primary" @click="handleClick">
      Click Me
    </Button>
  </Card>
</template>`}></arc-code-block></div>
    </section>

    <section id="svelte">
      <h2 class="docs-heading">Svelte</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">Published as <arc-badge variant="primary">@arclux/arc-ui-svelte</arc-badge>. Install it with the core package and Lit:</p>
      <div class="docs-code"><arc-code-block language="bash" code="npm install @arclux/arc-ui-svelte @arclux/arc-ui lit"></arc-code-block></div>
      <div class="docs-code"><arc-code-block language="svelte" code={`<script>
  import '@arclux/arc-ui/base.css';
  import { Button, Card } from '@arclux/arc-ui-svelte';
</script>

<Card>
  <h3>Hello Svelte</h3>
  <Button variant="primary" on:click={() => console.log('clicked')}>
    Click Me
  </Button>
</Card>`}></arc-code-block></div>
    </section>

    <section id="angular">
      <h2 class="docs-heading">Angular</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">Published as <arc-badge variant="primary">@arclux/arc-ui-angular</arc-badge>. Install it with the core package and Lit:</p>
      <div class="docs-code"><arc-code-block language="bash" code="npm install @arclux/arc-ui-angular @arclux/arc-ui lit"></arc-code-block></div>
      <p class="docs-text">Add the stylesheet to your global styles, then import the standalone components:</p>
      <div class="docs-code"><arc-code-block language="css" code={`/* styles.css */
@import '@arclux/arc-ui/base.css';`}></arc-code-block></div>
      <div class="docs-code"><arc-code-block language="typescript" code={`import { Component } from '@angular/core';
import { Button, Card } from '@arclux/arc-ui-angular';

@Component({
  selector: 'app-hello',
  imports: [Button, Card],
  template: \`
    <arc-card>
      <h3>Hello Angular</h3>
      <arc-button variant="primary" (click)="handleClick()">
        Click Me
      </arc-button>
    </arc-card>
  \`,
})
export class HelloComponent {
  handleClick() {
    console.log('clicked');
  }
}`}></arc-code-block></div>
    </section>

    <section id="solid">
      <h2 class="docs-heading">Solid</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">Published as <arc-badge variant="primary">@arclux/arc-ui-solid</arc-badge>. Install it with the core package and Lit:</p>
      <div class="docs-code"><arc-code-block language="bash" code="npm install @arclux/arc-ui-solid @arclux/arc-ui lit"></arc-code-block></div>
      <div class="docs-code"><arc-code-block language="jsx" code={`import '@arclux/arc-ui/base.css';
import { Button, Card } from '@arclux/arc-ui-solid';

function App() {
  return (
    <Card>
      <h3>Hello Solid</h3>
      <Button variant="primary" onClick={() => console.log('clicked')}>
        Click Me
      </Button>
    </Card>
  );
}`}></arc-code-block></div>
    </section>

    <section id="preact">
      <h2 class="docs-heading">Preact</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">Published as <arc-badge variant="primary">@arclux/arc-ui-preact</arc-badge>. Install it with the core package and Lit:</p>
      <div class="docs-code"><arc-code-block language="bash" code="npm install @arclux/arc-ui-preact @arclux/arc-ui lit"></arc-code-block></div>
      <div class="docs-code"><arc-code-block language="jsx" code={`import '@arclux/arc-ui/base.css';
import { Button, Card } from '@arclux/arc-ui-preact';

function App() {
  return (
    <Card>
      <h3>Hello Preact</h3>
      <Button variant="primary" onClick={() => console.log('clicked')}>
        Click Me
      </Button>
    </Card>
  );
}`}></arc-code-block></div>
    </section>

    <section id="no-wrapper">
      <h2 class="docs-heading">Without a wrapper</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        You don't need a wrapper. Every component is a standard custom element, so
        <code>&lt;arc-button&gt;</code> works in a framework template as soon as the element is
        registered. Use this path if you'd rather not add a dependency, or if you already write
        custom elements elsewhere in the app.
      </p>
      <p class="docs-text">Register what you use, with a side-effect import per component or the whole catalog at once:</p>
      <div class="docs-code"><arc-code-block language="js" code={`import '@arclux/arc-ui/base.css';
import '@arclux/arc-ui/button';   // just this element
import '@arclux/arc-ui/register'; // or every element`}></arc-code-block></div>

      <h3 class="docs-subheading">Telling your framework the tag is real</h3>
      <p class="docs-text">
        Vue and Angular need one setting so the compiler doesn't treat an unknown tag as a
        mistake or as one of its own components. Svelte and Solid need nothing.
      </p>
      <div class="docs-code"><arc-code-block language="js" code={`// Vue — vite.config.js
export default {
  plugins: [vue({
    template: { compilerOptions: { isCustomElement: (tag) => tag.startsWith('arc-') } },
  })],
};`}></arc-code-block></div>
      <div class="docs-code"><arc-code-block language="typescript" code={`// Angular — on the component or module that uses the tags
import { CUSTOM_ELEMENTS_SCHEMA } from '@angular/core';

@Component({
  // …
  schemas: [CUSTOM_ELEMENTS_SCHEMA],
})
export class AppComponent {}`}></arc-code-block></div>

      <h3 class="docs-subheading">Typed tags in JSX</h3>
      <p class="docs-text">
        React, Preact and Solid each get a generated declaration file that types every
        ARC UI tag, with the same props and enum unions as the wrapper packages.
        <strong>Add it to your program as a file.</strong> A <code>types</code> entry in
        <code>compilerOptions</code> does nothing here. TypeScript resolves <code>types</code>
        as a package name and doesn't follow an export subpath, so the tags stay untyped and
        nothing reports an error.
      </p>
      <div class="docs-code"><arc-code-block language="json" code={`{
  "include": [
    "src",
    "node_modules/@arclux/arc-ui/types/react-jsx.d.ts"
  ]
}`}></arc-code-block></div>
      <p class="docs-text">
        Swap in <code>preact-jsx.d.ts</code> or <code>solid-jsx.d.ts</code> as needed, or
        reference the file from one module instead:
        <code>/// &lt;reference path="./node_modules/@arclux/arc-ui/types/solid-jsx.d.ts" /&gt;</code>
      </p>

      <h3 class="docs-subheading">What you give up</h3>
      <p class="docs-text">
        The difference is custom events. Solid binds them with
        <code>on:arc-change=&#123;handler&#125;</code>, and its declaration file types it.
        React 19 and Preact 10 attach a function prop whose name starts with <code>on</code> as a
        listener for the rest of the name, as written, so <code>onarc-change=&#123;handler&#125;</code>
        listens for <code>arc-change</code>. Their declaration files accept any <code>on*</code>
        prop, so a misspelled event name compiles and never fires.
        <strong>The wrapper packages give each event a typed handler prop</strong>, such as
        <code>onArcChange</code>.
      </p>
    </section>

    <section id="vanilla">
      <h2 class="docs-heading">Vanilla JS / CDN</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">Install the core package and import components directly:</p>
      <div class="docs-code"><arc-code-block language="bash" code="npm install @arclux/arc-ui lit"></arc-code-block></div>
      <div class="docs-code"><arc-code-block language="js" code={`import '@arclux/arc-ui/button';
import '@arclux/arc-ui/card';`}></arc-code-block></div>
      <p class="docs-text">Or load it from a CDN. TODO(copy): the components import <code>lit</code> by its bare name, which a browser can't resolve without an import map, and this snippet has none. Fix the snippet or drop it?</p>
      <div class="docs-code"><arc-code-block language="html" code={`<link rel="stylesheet"
  href="https://unpkg.com/@arclux/arc-ui@${version}/base.css">
<script type="module"
  src="https://unpkg.com/@arclux/arc-ui@${version}/register">
</script>

<arc-button variant="primary">Click Me</arc-button>
<arc-card>
  <h3>Hello World</h3>
  <p>Pure HTML, no framework needed.</p>
</arc-card>`}></arc-code-block></div>
      <arc-alert variant="tip">For pages that can't run JavaScript, <code>@arclux/arc-ui-html</code> has CSS-only versions of many components. They style plain HTML by class name and <code>data-*</code> attribute, and the package's <code>examples/</code> folder has the markup for each.</arc-alert>
      <div class="docs-code"><arc-code-block language="html" code={`<!-- Full bundle -->
<link rel="stylesheet" href="https://unpkg.com/@arclux/arc-ui-html@${version}/css/arc-ui.css">

<!-- Individual component -->
<link rel="stylesheet" href="https://unpkg.com/@arclux/arc-ui-html@${version}/css/button.css">

<button class="arc-button arc-button--primary">Click Me</button>`}></arc-code-block></div>
    </section>

    <section class="see-also">
      <h2 class="docs-heading">See also</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <ul class="see-also__list">
        <li><a href="/docs/getting-started">Getting started</a>: install ARC UI and render a first component</li>
        <li><a href="/docs/theming">Theming</a>: dark, light and auto modes, and custom themes</li>
        <li><a href="/docs/browser-support">Browser support</a>: supported browsers and polyfills</li>
      </ul>
    </section>
  </div>
</DocsLayout>

<style></style>
