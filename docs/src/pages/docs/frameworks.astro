---
import { Code } from 'astro:components';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { version } from '../../data/site-stats';

const headings = [
  { id: 'overview', label: 'Overview' },
  { id: 'react', label: 'React' },
  { id: 'vue', label: 'Vue' },
  { id: 'svelte', label: 'Svelte' },
  { id: 'angular', label: 'Angular' },
  { id: 'solid', label: 'Solid' },
  { id: 'preact', label: 'Preact' },
  { id: 'vanilla', label: 'Vanilla JS / CDN' },
];
---

<DocsLayout
  title="Frameworks"
  description="Use ARC UI with React, Vue, Svelte, Angular, Solid, Preact, or vanilla JS."
  activeSlug="frameworks"
  headings={headings}
  breadcrumbs={[{ label: 'Frameworks' }]}
>
  <div class="frameworks-page">
    <h1 class="page-title">Frameworks</h1>
    <p class="page-desc">
      Use ARC UI in React, Vue, Svelte, Angular, Solid, Preact — or no framework at all.
    </p>

    <section id="overview">
      <h2 class="docs-heading">Overview</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        The core <code>@arclux/arc-ui</code> package contains Lit-based custom elements
        that work in any environment. Our code generator, <strong>Prism</strong>, parses
        the Lit source and produces a framework-native wrapper package for each framework:
      </p>
      <ul class="docs-list">
        <li>Proper event binding (e.g. React's synthetic events)</li>
        <li>TypeScript type definitions</li>
        <li>Idiomatic imports for each framework</li>
        <li>SSR compatibility where supported</li>
      </ul>
    </section>

    <section id="react">
      <h2 class="docs-heading">React</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <arc-badge variant="primary">@arclux/arc-ui-react</arc-badge>
      <div class="docs-code"><Code code="npm install @arclux/arc-ui-react" lang="bash" theme="css-variables" /></div>
      <div class="docs-code"><Code code={`import '@arclux/arc-ui/base.css';
import { Button, Card, Input } from '@arclux/arc-ui-react';

function App() {
  return (
    <Card>
      <h3>Sign In</h3>
      <Input label="Email" placeholder="you@example.com" />
      <Button variant="primary" onClick={() => console.log('clicked')}>
        Submit
      </Button>
    </Card>
  );
}`} lang="jsx" theme="css-variables" /></div>
      <p class="docs-text">
        React wrappers use <code>@lit/react</code> <code>createComponent</code> under the hood,
        which handles event binding and ref forwarding automatically.
      </p>
    </section>

    <section id="vue">
      <h2 class="docs-heading">Vue</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <arc-badge variant="primary">@arclux/arc-ui-vue</arc-badge>
      <div class="docs-code"><Code code="npm install @arclux/arc-ui-vue" lang="bash" theme="css-variables" /></div>
      <div class="docs-code"><Code code={`<script setup>
import '@arclux/arc-ui/base.css';
import { Button, Card } from '@arclux/arc-ui-vue';
</script>

<template>
  <Card>
    <h3>Hello Vue</h3>
    <Button variant="primary" @click="handleClick">
      Click Me
    </Button>
  </Card>
</template>`} lang="vue" theme="css-variables" /></div>
    </section>

    <section id="svelte">
      <h2 class="docs-heading">Svelte</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <arc-badge variant="primary">@arclux/arc-ui-svelte</arc-badge>
      <div class="docs-code"><Code code="npm install @arclux/arc-ui-svelte" lang="bash" theme="css-variables" /></div>
      <div class="docs-code"><Code code={`<script>
  import '@arclux/arc-ui/base.css';
  import { Button, Card } from '@arclux/arc-ui-svelte';
</script>

<Card>
  <h3>Hello Svelte</h3>
  <Button variant="primary" on:click={() => console.log('clicked')}>
    Click Me
  </Button>
</Card>`} lang="svelte" theme="css-variables" /></div>
    </section>

    <section id="angular">
      <h2 class="docs-heading">Angular</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <arc-badge variant="primary">@arclux/arc-ui-angular</arc-badge>
      <div class="docs-code"><Code code="npm install @arclux/arc-ui-angular" lang="bash" theme="css-variables" /></div>
      <p class="docs-text">Add the stylesheet to your global styles, then import the standalone components:</p>
      <div class="docs-code"><Code code={`/* styles.css */
@import '@arclux/arc-ui/base.css';`} lang="css" theme="css-variables" /></div>
      <div class="docs-code"><Code code={`import { Component } from '@angular/core';
import { Button, Card } from '@arclux/arc-ui-angular';

@Component({
  selector: 'app-hello',
  imports: [Button, Card],
  template: \`
    <arc-card>
      <h3>Hello Angular</h3>
      <arc-button variant="primary" (click)="handleClick()">
        Click Me
      </arc-button>
    </arc-card>
  \`,
})
export class HelloComponent {
  handleClick() {
    console.log('clicked');
  }
}`} lang="typescript" theme="css-variables" /></div>
    </section>

    <section id="solid">
      <h2 class="docs-heading">Solid</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <arc-badge variant="primary">@arclux/arc-ui-solid</arc-badge>
      <div class="docs-code"><Code code="npm install @arclux/arc-ui-solid" lang="bash" theme="css-variables" /></div>
      <div class="docs-code"><Code code={`import '@arclux/arc-ui/base.css';
import { Button, Card } from '@arclux/arc-ui-solid';

function App() {
  return (
    <Card>
      <h3>Hello Solid</h3>
      <Button variant="primary" onClick={() => console.log('clicked')}>
        Click Me
      </Button>
    </Card>
  );
}`} lang="jsx" theme="css-variables" /></div>
    </section>

    <section id="preact">
      <h2 class="docs-heading">Preact</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <arc-badge variant="primary">@arclux/arc-ui-preact</arc-badge>
      <div class="docs-code"><Code code="npm install @arclux/arc-ui-preact" lang="bash" theme="css-variables" /></div>
      <div class="docs-code"><Code code={`import '@arclux/arc-ui/base.css';
import { Button, Card } from '@arclux/arc-ui-preact';

function App() {
  return (
    <Card>
      <h3>Hello Preact</h3>
      <Button variant="primary" onClick={() => console.log('clicked')}>
        Click Me
      </Button>
    </Card>
  );
}`} lang="jsx" theme="css-variables" /></div>
    </section>

    <section id="vanilla">
      <h2 class="docs-heading">Vanilla JS / CDN</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">No framework needed — use the core Web Component package directly:</p>
      <div class="docs-code"><Code code="npm install @arclux/arc-ui" lang="bash" theme="css-variables" /></div>
      <div class="docs-code"><Code code={`import '@arclux/arc-ui/button';
import '@arclux/arc-ui/card';`} lang="js" theme="css-variables" /></div>
      <p class="docs-text">Or via CDN with no build step:</p>
      <div class="docs-code"><Code code={`<link rel="stylesheet"
  href="https://unpkg.com/@arclux/arc-ui@${version}/base.css">
<script type="module"
  src="https://unpkg.com/@arclux/arc-ui@${version}/register">
</script>

<arc-button variant="primary">Click Me</arc-button>
<arc-card>
  <h3>Hello World</h3>
  <p>Pure HTML, no framework needed.</p>
</arc-card>`} lang="html" theme="css-variables" /></div>
      <arc-callout variant="tip">For projects that can't use JavaScript, ARC UI also provides standalone CSS files.</arc-callout>
      <div class="docs-code"><Code code={`<!-- Full bundle -->
<link rel="stylesheet" href="https://unpkg.com/@arclux/arc-ui-html@${version}/css/arc-ui.css">

<!-- Individual component -->
<link rel="stylesheet" href="https://unpkg.com/@arclux/arc-ui-html@${version}/css/button.css">

<button class="arc-button arc-button--primary">Click Me</button>`} lang="html" theme="css-variables" /></div>
    </section>

    <section class="see-also">
      <h2 class="docs-heading">See Also</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <ul class="see-also__list">
        <li><a href="/docs/getting-started">Getting Started</a> — installation and setup</li>
        <li><a href="/docs/theming">Theming</a> — dark/light mode and custom themes</li>
        <li><a href="/docs/browser-support">Browser Support</a> — supported browsers and polyfills</li>
      </ul>
    </section>
  </div>
</DocsLayout>

<style></style>
