---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection, render } from 'astro:content';
import { anchorFor, compareVersionsDesc, majorOf } from '../../lib/releases';

// One markdown file per release in src/content/releases/ — frontmatter carries
// version/date/title, the body carries plain-markdown notes. The chrome (h2,
// divider, body styling) all comes from this template.
const sorted = (await getCollection('releases')).sort((a, b) =>
  compareVersionsDesc(a.data.version, b.data.version)
);

const withContent = await Promise.all(
  sorted.map(async (entry) => ({
    version: entry.data.version,
    title: entry.data.title,
    Content: (await render(entry)).Content,
  }))
);

// The newest major renders inline; every older major collapses into an
// archive block. When a new major's first release lands, the previous major
// archives itself with zero edits here.
const majors = [...new Set(withContent.map((r) => majorOf(r.version)))];
const [currentMajor, ...archivedMajors] = majors;

const inline = withContent.filter((r) => majorOf(r.version) === currentMajor);
const archives = archivedMajors.map((major) => {
  const entries = withContent.filter((r) => majorOf(r.version) === major);
  return {
    major,
    entries,
    id: `v${major}-archive`,
    summary: `v${major}.x archive — ${entries.length} releases, v${entries[entries.length - 1].version} through v${entries[0].version}`,
  };
});

const headings = [
  ...inline.map((r) => ({ id: anchorFor(r.version), label: `v${r.version}` })),
  ...archives.map((a) => ({ id: a.id, label: `v${a.major}.x archive` })),
];
---

<DocsLayout
  title="Changelog"
  description="ARC UI release history and version notes."
  activeSlug="changelog"
  headings={headings}
  breadcrumbs={[{ label: 'Changelog' }]}
>
  <div class="changelog-page">
    <h1 class="page-title">Changelog</h1>
    <p class="page-desc">
      Release history for ARC UI. All packages are versioned together.
    </p>

    {inline.map(({ version, title, Content }) => (
      <section id={anchorFor(version)} class="release-body">
        <h2 class="docs-heading">v{version} — {title}</h2>
        <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <Content />
      </section>
    ))}

    {archives.map((archive) => (
      <details class="changelog-archive" id={archive.id}>
        <summary>{archive.summary}</summary>

        {archive.entries.map(({ version, title, Content }) => (
          <section id={anchorFor(version)} class="release-body">
            <h2 class="docs-heading">v{version} — {title}</h2>
            <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
            <Content />
          </section>
        ))}
      </details>
    ))}
  </div>
</DocsLayout>

<style>
  /* House styling for the rendered markdown bodies. The release files are
     plain markdown — these rules map their output onto the same look the
     hand-written sections had (docs-heading/docs-text/docs-list/tier-heading
     in docs.css), so the files themselves stay free of house markup. */

  /* Releases are the page's top-level unit, so they get the page's largest
     gap. Each already opens with the house h2 + arc-divider; separation is
     whitespace's job, not a second rule's. */
  /* The generic docs chrome gives adjacent sections a hairline ::before and
     24px of padding — a second rule on a page whose own comment above says the
     release divider stays the only one. Strip it, and count the docs column's
     40px flex gap toward the break: 3xl + that gap lands the visual distance
     at the 4xl this declared before the strays were noticed. */
  .release-body + .release-body {
    margin-top: var(--space-3xl);
    padding-top: 0;
  }

  .release-body + .release-body::before {
    content: none;
  }

  /* Fenced code blocks. The global reset zeroes the UA's pre margins, and
     nothing here restored them — prose sat flush against the block's border.
     Wider than the 640px prose measure on purpose: code wraps badly. */
  .release-body :global(pre) {
    margin-block: var(--space-sm) var(--space-lg);
    overflow-x: auto;
  }

  /* h3 → a section heading inside a release.
     These carried the tier-heading eyebrow: --text-xs at --text-muted, with no
     top margin. Both parts worked against it. Muted sits *below* the
     --text-secondary body it introduces, so the heading read as the quietest
     thing in its own section — hierarchy inverted rather than established. And
     with no top margin, a release of eight sections arrived as one unbroken
     column. Lifting to --text-primary is the house move (hierarchy comes from
     lifting, not from stepping down the gray ramp), and the gap does the
     breaking — the release's own divider stays the only rule on the page.
     Uppercase at the label role is kept: it's what distinguishes this level
     from the sentence-case h2 above it now that both sit at primary. */
  .release-body :global(h3) {
    font-family: var(--font-label);
    font-size: var(--text-sm);
    font-weight: var(--font-label-weight, 600);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-primary);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    max-width: 640px;
  }

  /* The first section already has the release divider above it. */
  .release-body :global(h3:first-of-type) {
    margin-top: var(--space-lg);
  }

  /* p → docs-text */
  .release-body :global(p) {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
    max-width: 640px;
  }

  .release-body :global(p a) {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .release-body :global(p a:hover) {
    text-decoration: underline;
  }

  .release-body :global(p code) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    background: var(--bg-surface);
    padding: var(--space-xs);
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-default);
  }

  .release-body :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* ul → docs-list (after the p rules so list styling wins inside loose
     list items, where markdown wraps li content in a p) */
  .release-body :global(ul) {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
    margin-bottom: var(--space-sm);
    max-width: 640px;
    padding-inline-start: var(--space-lg);
  }

  .release-body :global(ul code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--bg-surface);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  /* Nested lists match the old inline margin-top:var(--space-xs) */
  .release-body :global(li > ul) {
    margin-top: var(--space-xs);
  }

  /* Loose list items wrap their text in <p>; keep them reading as plain
     list items rather than stacked paragraphs. */
  .release-body :global(li > p) {
    margin-bottom: 0;
    font-size: inherit;
    line-height: inherit;
  }

  .changelog-archive {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0 var(--space-lg);
    /* No margin of its own: .changelog-page is a flex column with a 40px gap,
       where margins don't collapse — a vertical margin here triple-counted
       the separation (gap + two margins = 120px between closed archives). */
    margin: 0;
  }

  .changelog-archive summary {
    cursor: pointer;
    padding: var(--space-md) 0;
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: 2px;
    text-transform: uppercase;
    /* Secondary, not muted: these rows are the only interactive thing in
       view once a major archives, and the muted step doesn't read on the
       deep ground. The lift to primary stays the hover/open state. */
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .changelog-archive summary:hover {
    color: var(--text-primary);
  }

  .changelog-archive[open] summary {
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--space-lg);
  }
</style>

<script is:inline>
  (function () {
    // RSS items and old links target #v1-* anchors that now live inside the
    // collapsed archive — open it before the browser scrolls to them.
    var openArchiveForHash = function () {
      var hash = location.hash;
      if (!hash) return;
      var target = document.getElementById(hash.slice(1));
      if (!target) return;
      var details = target.closest('details');
      if (details && !details.open) {
        details.open = true;
        requestAnimationFrame(function () { target.scrollIntoView(); });
      }
    };
    openArchiveForHash();
    window.addEventListener('hashchange', openArchiveForHash);
    document.addEventListener('astro:page-load', openArchiveForHash);
  })();
</script>
