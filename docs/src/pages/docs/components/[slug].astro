---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import ComponentShowcase from '../../../components/ComponentShowcase.astro';
import ApiList from '../../../components/ApiList.astro';
import { components } from '../../../data/components/index';
import { getApi } from '../../../data/manifest';
import { removedComponents, type RemovedComponent } from '../../../data/removed';

/**
 * Live components and tombstones share this route because they share the URL —
 * a cut component keeps `/docs/components/<slug>` and renders an explanation of
 * where it went, rather than 404ing at a link that is already in bookmarks and
 * search indexes. See data/removed.ts.
 */
export function getStaticPaths() {
  return [
    ...components.map((c) => ({
      params: { slug: c.slug },
      props: { component: c, removed: null },
    })),
    ...removedComponents.map((r) => ({
      params: { slug: r.slug },
      props: {
        // Enough of a ComponentDef for the header, the breadcrumb and the page
        // metadata. Everything below the header is behind `removed`.
        component: {
          name: r.name,
          slug: r.slug,
          tag: r.tag,
          tier: r.tier,
          interactivity: 'interactive' as const,
          description: r.was,
          tabs: [],
        },
        removed: r,
      },
    })),
  ];
}

const { component, removed } = Astro.props as { component: any; removed: RemovedComponent | null };

// API surface from custom-elements.json (single source of truth) — the docs
// data layer only carries prose, examples, and page metadata.
//
// A removed component is not in the manifest, and `getApi` throws on an unknown
// tag on purpose (that throw is what keeps a stale docs page from rendering an
// empty API table as if it were the truth). So tombstones get an explicitly
// empty surface here rather than a weakened `getApi`.
const EMPTY_API = { tag: component.tag, description: '', group: null, props: [], events: [], slots: [], cssParts: [] };
const api = removed ? EMPTY_API : getApi(component.tag);
const subComponents = (component.subComponents ?? []).map((sub: any) => ({
  ...sub,
  api: getApi(sub.tag),
}));

const tierColors: Record<string, string> = {
  layout: '100, 180, 120',
  navigation: '77, 126, 247',
  content: '140, 140, 150',
  input: '180, 90, 255',
  feedback: '247, 170, 50',
};

const interactivityColors: Record<string, string> = {
  static: '140, 140, 150',
  hybrid: '77, 126, 247',
  interactive: '180, 90, 255',
};

const interactivityNotes: Record<string, string> = {
  interactive: 'This component requires JavaScript. No pure HTML/CSS version is available — use the Web Component directly or a framework wrapper.',
  hybrid: 'Layout and styling work without JavaScript via the HTML/CSS versions. Interactive features like events and state management require the Web Component or a framework wrapper.',
};

// Resolve seeAlso slugs to component data or guide links
const seeAlsoItems = (component.seeAlso ?? []).map((ref: string) => {
  if (ref.startsWith('/')) {
    // Guide path — extract label from last segment
    const label = ref.split('/').pop()!.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
    return { type: 'guide' as const, href: ref, label };
  }
  const match = components.find((c) => c.slug === ref);
  if (match) return { type: 'component' as const, href: `/docs/components/${match.slug}`, label: match.name, description: match.description };
  return { type: 'component' as const, href: `/docs/components/${ref}`, label: ref.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()), description: '' };
});

// Prev/next in sidebar order: fixed tier order, alphabetical within tier
const tierOrder = ['layout', 'navigation', 'content', 'data', 'typography', 'input', 'feedback'];
const ordered = tierOrder.flatMap((t) =>
  components.filter((c) => c.tier === t).sort((a, b) => a.name.localeCompare(b.name)),
);
// A tombstone is in no sidebar order, so it gets no prev/next. Guarded on the
// index rather than on `removed`, because `findIndex` returning -1 would
// otherwise make `nextComponent` the *first* component of the whole catalog.
const orderedIndex = ordered.findIndex((c) => c.slug === component.slug);
const prevComponent = orderedIndex > 0 ? ordered[orderedIndex - 1] : null;
const nextComponent =
  orderedIndex >= 0 && orderedIndex < ordered.length - 1 ? ordered[orderedIndex + 1] : null;

// BreadcrumbList comes from DocsLayout (via the breadcrumbs prop); this page
// only adds its component-specific TechArticle.
const pageUrl = new URL(`/docs/components/${component.slug}`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${component.name} — ARC UI`,
  name: component.name,
  description: component.description,
  url: pageUrl,
  // `ogPathFor` only emits a component card for a slug that is in `components`,
  // so a tombstone has no card and must not claim one here either.
  ...(removed ? {} : { image: new URL(`/og/${component.slug}.png`, Astro.site).href }),
  proficiencyLevel: 'Beginner',
  author: { '@id': 'https://arcui.dev/#org' },
  publisher: { '@id': 'https://arcui.dev/#org' },
  isPartOf: { '@id': 'https://arcui.dev/#website' },
};

const headings = removed
  ? [{ id: 'removed', label: 'Removed' }]
  : [
  ...(component.overview ? [{ id: 'overview', label: 'Overview' }] : []),
  ...(component.guidelines ? [{ id: 'guidelines', label: 'Guidelines' }] : []),
  ...(component.features ? [{ id: 'features', label: 'Features' }] : []),
  { id: 'preview', label: 'Preview' },
  { id: 'usage', label: 'Usage' },
  ...(api.props.length > 0 ? [{ id: 'api', label: 'API' }] : []),
  ...(api.events.length > 0 ? [{ id: 'events', label: 'Events' }] : []),
  ...subComponents.map((sub: any) => ({
    id: sub.tag,
    label: sub.name,
  })),
];
---

<DocsLayout
  title={component.name}
  htmlTitle={`${component.name} — Web Component | ARC UI`}
  description={component.description}
  activeSlug={component.slug}
  headings={headings}
  breadcrumbs={[{ label: 'Components', href: '/docs/components' }, { label: component.name }]}
  articleSchema={false}
>
  <div class="component-page">
    <!-- Header -->
    <arc-page-header>
      <h1 slot="heading">{component.name}</h1>
      <p slot="description">{component.description}</p>
      <arc-breadcrumb slot="above">
        <arc-breadcrumb-item href="/docs/components">Components</arc-breadcrumb-item>
        <arc-breadcrumb-item>{component.name}</arc-breadcrumb-item>
      </arc-breadcrumb>
      <div slot="aside" class="component-page__badges">
        <arc-tag color={tierColors[component.tier]}>{component.tier}</arc-tag>
        {removed ? (
          <arc-badge variant="error">removed in {removed.removedIn}</arc-badge>
        ) : api.status === 'deprecated' ? (
          <arc-badge variant="warning">deprecated</arc-badge>
        ) : (
          <>
            <arc-tag color={interactivityColors[component.interactivity]}>{component.interactivity}</arc-tag>
            {/* From the manifest, not the page data — `status` was a docs-only
                optional field until 4.1 and is now declared on the component.
                `stable` is unbadged: it is 192 of 202, so a badge for it would
                mean "component" rather than anything about maturity. */}
            {api.status === 'beta' && <arc-badge variant="warning">beta</arc-badge>}
            {api.status === 'experimental' && <arc-badge variant="error">experimental</arc-badge>}
          </>
        )}
      </div>
      <code class="component-page__tag">&lt;{component.tag}&gt;</code>
    </arc-page-header>

    {/* Still documented in full — it works and is supported for this whole
        major. The notice goes first because someone landing here from an
        existing codebase needs the survivor before they need the API table. */}
    {!removed && api.status === 'deprecated' && api.mergedInto && (
      <section id="deprecated" class="deprecation">
        <p>
          <strong>{component.name} is deprecated.</strong> It still works, is still published, and is
          still exported from <code>@arclux/arc-ui</code> for all of v4 — nothing about it changed.
          It is removed in v5. Use{' '}
          <a href={`/docs/components/${api.mergedInto.replace(/^arc-/, '')}`}>
            <code>&lt;{api.mergedInto}&gt;</code>
          </a>{' '}
          instead; the mechanical change is in{' '}
          <a href="https://github.com/arclux/arc-ui/blob/main/MIGRATION.md#the-merges">MIGRATION.md</a>.
        </p>
      </section>
    )}

    {/* Tombstone — everything below this is skipped for a removed component. */}
    {removed && (
      <section id="removed" class="tombstone">
        <p class="tombstone__lede">
          <strong>{removed.name} was removed in {removed.removedIn}.</strong> It is not published, and
          <code>&lt;{removed.tag}&gt;</code> no longer resolves to anything. This page is here so the link
          still answers.
        </p>

        <h2 class="docs-heading">Why</h2>
        <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        {/* A plain paragraph, not arc-markdown: that component fills itself in
            on hydration, and a tombstone is the one page most likely to be read
            by a crawler or with JS off. data/removed.ts keeps the prose free of
            markdown for the same reason. */}
        <p class="tombstone__why">{removed.why}</p>

        <h2 class="docs-heading">Use instead</h2>
        <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <ul class="tombstone__alts">
          {removed.alternatives.map((alt) => (
            <li>
              {alt.href ? <a href={alt.href}>{alt.label}</a> : <span class="tombstone__alt-name">{alt.label}</span>}
              {alt.forthcoming && <span class="tombstone__forthcoming">not yet shipped</span>}
              {alt.note && <span class="tombstone__note">{alt.note}</span>}
            </li>
          ))}
        </ul>

        <p class="tombstone__migration">
          The full entry, with the mechanical fix, is in
          <a href={`https://github.com/arclux/arc-ui/blob/main/MIGRATION.md${removed.migration}`}>MIGRATION.md</a>.
        </p>
      </section>
    )}

    {/* Overview */}
    {component.overview && (
      <section id="overview">
        <h2 class="docs-heading">Overview</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <div class="component-page__overview">
          <arc-markdown>{component.overview}</arc-markdown>
        </div>
      </section>
    )}

    {/* Guidelines */}
    {component.guidelines && (
      <section id="guidelines">
        <h2 class="docs-heading">Guidelines</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <div class="component-page__guidelines">
          <arc-card>
            <h3 class="guidelines__heading">When to use</h3>
            <ul class="guidelines__list guidelines__list--do">
              {component.guidelines.do.map((item: string) => <li>{item}</li>)}
            </ul>
          </arc-card>
          {component.guidelines.dont && component.guidelines.dont.length > 0 && (
            <arc-card>
              <h3 class="guidelines__heading">When not to use</h3>
              <ul class="guidelines__list guidelines__list--dont">
                {component.guidelines.dont.map((item: string) => <li>{item}</li>)}
              </ul>
            </arc-card>
          )}
        </div>
      </section>
    )}

    {/* Features */}
    {component.features && (
      <section id="features">
        <h2 class="docs-heading">Features</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <ul class="component-page__features">
          {component.features.map((f: string) => <li>{f}</li>)}
        </ul>
      </section>
    )}

    <!-- Preview -->
    {!removed && (
    <section id="preview">
      <h2 class="docs-heading">Preview</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <div class="component-page__preview">
        {component.replayable && (
          <button class="preview-replay" aria-label="Replay animation" data-preview-replay>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
              <path d="M2 8a6 6 0 0 1 10.2-4.3L11 5h4V1l-1.6 1.6A7.5 7.5 0 0 0 .5 8h1.5Zm12 0a6 6 0 0 1-10.2 4.3L5 11H1v4l1.6-1.6A7.5 7.5 0 0 0 15.5 8H14Z" fill="currentColor"/>
            </svg>
            Replay
          </button>
        )}
        {component.previewHtml ? (
          <div
            class:list={['live-preview', component.previewLayout && `live-preview--${component.previewLayout}`]}
            style={component.previewHeight
              ? component.previewLayout === 'frame'
                ? `--preview-frame-height:${component.previewHeight}`
                : `min-height:${component.previewHeight}`
              : undefined}
            data-component={component.tag}
            data-has-html
            {...(component.previewSetup ? { 'data-setup': component.previewSetup } : {})}
            set:html={component.previewHtml}
          />
        ) : (
          <div class="live-preview" data-component={component.tag}></div>
        )}
      </div>
    </section>
    )}

    <!-- Usage / Code Tabs -->
    {!removed && (
    <section id="usage">
      <h2 class="docs-heading">Usage</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      {api.group && (
        <div class="interactivity-note" data-level="group">
          <p>
            <strong>{component.name}</strong> is in the <code>{api.group}</code> domain group, so it is
            deliberately absent from the default <code>@arclux/arc-ui</code> barrel. Import it from
            <code>@arclux/arc-ui/{api.group}</code>, or from its own subpath
            <code>@arclux/arc-ui/{component.slug}</code>. Everything else — the element, the CSS, the
            framework wrappers, the support it gets — is unchanged.
          </p>
        </div>
      )}
      {interactivityNotes[component.interactivity] && (
        <div class="interactivity-note" data-level={component.interactivity}>
          <p>{interactivityNotes[component.interactivity]}</p>
        </div>
      )}
      <ComponentShowcase tabs={component.tabs} />
    </section>
    )}

    <!-- API Table -->
    {api.props.length > 0 && (
      <section id="api">
        <h2 class="docs-heading">API</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <div class="component-page__api">
          <ApiList rows={api.props} />
        </div>
      </section>
    )}

    {/* Events */}
    {api.events.length > 0 && (
      <section id="events">
        <h2 class="docs-heading">Events</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <div class="component-page__api">
          <ApiList rows={api.events} kind="event" />
        </div>
      </section>
    )}

    {/* Sub-components */}
    {subComponents.map((sub: any) => (
      <section id={sub.tag}>
        <h2 class="docs-heading">{sub.name}</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <code class="component-page__tag">&lt;{sub.tag}&gt;</code>
        <p class="component-page__desc" style="margin-top:var(--space-sm)">{sub.description}</p>
        {sub.api.props.length > 0 && (
          <div class="component-page__api" style="margin-top:var(--space-md)">
            <ApiList rows={sub.api.props} />
          </div>
        )}
      </section>
    ))}

    {/* See Also */}
    {seeAlsoItems.length > 0 && (
      <section id="see-also">
        <h2 class="docs-heading">See Also</h2>
        <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
        <ul class="see-also__list">
          {seeAlsoItems.map((item: any) => (
            <li>
              <a href={item.href} class="see-also__link">
                <span class="see-also__name">{item.label}</span>
                {item.description && <span class="see-also__desc">{item.description}</span>}
                {item.type === 'guide' && <span class="see-also__badge">Guide</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Prev / Next */}
    <nav class="component-pager" aria-label="Component navigation">
      {prevComponent ? (
        <a href={`/docs/components/${prevComponent.slug}`} class="component-pager__link" rel="prev">
          <span class="component-pager__label">Previous</span>
          <span class="component-pager__name">{prevComponent.name}</span>
        </a>
      ) : (
        <span />
      )}
      {nextComponent && (
        <a href={`/docs/components/${nextComponent.slug}`} class="component-pager__link component-pager__link--next" rel="next">
          <span class="component-pager__label">Next</span>
          <span class="component-pager__name">{nextComponent.name}</span>
        </a>
      )}
    </nav>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</DocsLayout>

<!-- Client-side: register WCs and populate live previews -->
<script>
  import { iconRegistry } from '@arclux/arc-ui';

  // Expose to previewSetup scripts (which run via new Function, outside module scope)
  (window as any).__arcIconRegistry = iconRegistry;

  function initShowcase() {
    runPreviewSetup();
  }

  function runPreviewSetup() {
    // Run any previewSetup scripts embedded as data attributes
    document.querySelectorAll('.live-preview[data-setup]').forEach((el) => {
      try { new Function('el', el.getAttribute('data-setup')!)(el); } catch (err) { console.error('[previewSetup]', err); }
    });
  }

  /* populatePreviews removed — all components define previewHtml in data */

  function initReplay() {
    document.querySelectorAll<HTMLButtonElement>('[data-preview-replay]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const preview = btn.closest('.component-page__preview')?.querySelector('.live-preview');
        if (!preview) return;
        const html = preview.innerHTML;
        preview.innerHTML = '';
        // Force a reflow so the browser treats re-inserted nodes as new
        void preview.offsetHeight;
        preview.innerHTML = html;
        runPreviewSetup();
      });
    });
  }

  /** Prevent links inside live previews from navigating */
  function disablePreviewLinks() {
    document.querySelectorAll('.live-preview').forEach((preview) => {
      // Block all click navigation: light-DOM <a> tags and shadow-DOM anchors
      preview.addEventListener('click', (e) => {
        const path = e.composedPath() as Element[];
        for (const el of path) {
          if (el === preview) break;
          if (el instanceof HTMLAnchorElement && el.href) {
            e.preventDefault();
            return;
          }
        }
      });
      // Block arc-navigate events from WC-internal links
      preview.addEventListener('arc-navigate', (e) => {
        e.stopPropagation();
      });
    });
  }

  document.addEventListener('astro:page-load', () => { initShowcase(); initReplay(); disablePreviewLinks(); });
</script>

<style>
  arc-page-header::part(heading) {
    font-size: var(--text-2xl);
    font-weight: 600;
    background: var(--gradient-display-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  arc-page-header::part(title-row) {
    justify-content: flex-start;
  }

  arc-page-header::part(description) {
    max-width: 50%;
    text-wrap: balance;
  }

  .component-page__badges {
    display: flex;
    gap: var(--space-xs);
  }

  .component-page__tag {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent-secondary);
    background: var(--bg-surface);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    align-self: flex-start;
    transition: box-shadow var(--transition-fast);
  }

  .component-page__tag:hover {
    box-shadow: 0 0 12px rgba(var(--accent-secondary-rgb), 0.15);
  }

  .docs-heading {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }


  .component-page__preview {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-deep);
    padding: var(--space-xl);
    min-height: 100px;
    position: relative;
    box-shadow: inset 0 1px 0 var(--bg-hover);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .preview-replay {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-ghost);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 5px 10px;
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .preview-replay:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary-border);
    background: var(--accent-primary-subtle);
  }

  .preview-replay:focus-visible {
    outline: none;
    box-shadow: var(--focus-glow);
  }

  .preview-replay svg {
    transition: transform 300ms var(--ease-out-expo);
  }

  .preview-replay:active svg {
    transform: rotate(-360deg);
  }

  .component-page__preview::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--glow-line-gradient);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    opacity: 0.6;
  }

  .component-page__preview:hover {
    box-shadow: var(--glow-card-hover), inset 0 1px 0 var(--bg-hover);
  }

  /* Default: centered flex, overflow VISIBLE so popups/dropdowns aren't
     clipped. (overflow-x:auto + overflow-y:visible is an invalid combo — the
     browser forces both axes to auto, which turned every preview into a
     scroll container and clipped every select/date-picker/menu panel.) */
  .component-page__preview .live-preview {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    position: relative;
    min-height: 60px;
    min-width: 0;
    width: 100%;
    overflow: visible;
    padding-bottom: var(--space-xs);
  }

  /* Full-width flow for components that own their layout (charts, calendars) */
  .component-page__preview .live-preview--block {
    display: block;
  }

  /* Wide content (grids, boards, tables) scrolls horizontally inside the
     preview instead of widening the page. Clips overlays — use only for
     components that don't open panels past their bounds. */
  .component-page__preview .live-preview--scroll {
    display: block;
    overflow-x: auto;
  }

  /* Full-page shells (app-shell, auth-shell) render inside a fixed-height
     viewport frame; content beyond it scrolls within, never spills the card.
     Pair with previewHeight; height (not just min-height) is what contains. */
  .component-page__preview .live-preview--frame {
    display: block;
    overflow: auto;
    height: var(--preview-frame-height, 480px);
    min-height: 0;
    border-radius: var(--radius-md);
    contain: layout paint;
  }

  .component-page__preview .live-preview:empty {
    overflow: hidden;
  }

  .component-page__preview .live-preview:empty::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(77,126,247,0.04) 20%,
