---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { tokenCount, utilityClassCount } from '../../data/site-stats';
import '@arclux/arc-ui/utilities.css';

const headings = [
  { id: 'overview', label: 'Overview' },
  { id: 'why', label: 'Why not Tailwind' },
  { id: 'install', label: 'Install' },
  { id: 'spacing', label: 'Spacing' },
  { id: 'layout', label: 'Layout' },
  { id: 'surface', label: 'Surface' },
  { id: 'limits', label: 'Limits' },
];

/** Kept in the page rather than generated: these are the shapes worth showing. */
const spacing = [
  ['.arc-p-md', 'padding: var(--space-md)'],
  ['.arc-px-lg', 'padding-inline: var(--space-lg)'],
  ['.arc-py-sm', 'padding-block: var(--space-sm)'],
  ['.arc-ps-xl', 'padding-inline-start: var(--space-xl)'],
  ['.arc-m-0', 'margin: 0'],
  ['.arc-mx-auto', 'margin-inline: auto'],
  ['.arc-gap-md', 'gap: var(--space-md)'],
  ['.arc-gap-y-lg', 'row-gap: var(--space-lg)'],
];

const surface = [
  ['.arc-text-primary', 'color: var(--text-primary)'],
  ['.arc-text-lg', 'font-size: var(--text-lg)'],
  ['.arc-bg-card', 'background-color: var(--bg-card)'],
  ['.arc-border', 'border: 1px solid var(--border-default)'],
  ['.arc-border-subtle', 'border-color: var(--border-subtle)'],
  ['.arc-rounded-md', 'border-radius: var(--radius-md)'],
  ['.arc-shadow-lg', 'box-shadow: var(--shadow-lg)'],
  ['.arc-font-mono', 'font-family: var(--font-mono)'],
];

const fontRoles = ['body', 'label', 'mono', 'display', 'quote'];
---

<DocsLayout
  title="Utilities"
  description="Optional arc- prefixed utility classes for spacing, layout and surface, generated from ARC UI's design tokens."
  activeSlug="utilities"
  headings={headings}
  breadcrumbs={[{ label: 'Utilities' }]}
>
  <div class="prose-page">
    <h1>Utilities</h1>

    <section id="overview">
      <p>
        ARC UI components style what's inside their shadow roots and nothing outside. The space
        <em>between</em> components is yours to lay out, usually with flex, gap and padding CSS
        written against the {tokenCount} custom properties in <code>base.css</code>.
      </p>
      <p>
        The utility layer is <strong>{utilityClassCount} generated, <code>arc-</code>-prefixed
        classes</strong>, about 2.6&nbsp;KB gzipped, for spacing, layout and surface. This site
        loads the stylesheet, so the demos on this page use the classes themselves.
      </p>
    </section>

    <section id="why">
      <h2 class="docs-heading">Why not Tailwind</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p>
        You can use Tailwind, and for most utility work you should. Its
        spacing scale isn't tied to the tokens <code>arc-card</code> reads for its own padding.
      </p>
      <p>
        These classes are generated from <code>tokens.js</code>, the same file that generates
        <code>base.css</code>. A class and a component that use the same step read the same
        custom property (<code>.arc-p-lg</code> and a card's default padding both read <code>--space-lg</code>),
        so overriding that token changes both:
      </p>
      <arc-code-block language="css" code={`:root { --space-md: 20px; }

/* .arc-p-md and every component's internal md spacing move together */`}></arc-code-block>
      <p>
        Every class on a token scale (spacing, color, type size, radius, shadow) takes its value
        from a <code>var()</code>. Use these where your layout should follow the
        tokens, and anything you like for the rest.
      </p>
    </section>

    <section id="install">
      <h2 class="docs-heading">Install</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <arc-code-block language="js" code={`import '@arclux/arc-ui/base.css';       /* defines the tokens */
import '@arclux/arc-ui/utilities.css'; /* uses them */`}></arc-code-block>
      <p>
        The stylesheet is separate, so if you only want the tokens you don't load it. Every class
        has the <code>arc-</code> prefix, because your project may also run Tailwind or
        Bootstrap, and an unprefixed <code>.flex</code> would collide with theirs. The prefix
        makes the classes longer, and a library has no way around that.
      </p>
    </section>

    <section id="spacing">
      <h2 class="docs-heading">Spacing</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p>
        Every step of the <code>--space-*</code> scale, for padding, margin and gap. The suffixes
        map to logical properties: <code>x</code>/<code>y</code> for the inline and block axes,
        <code>s</code>/<code>e</code> for start and end, <code>t</code>/<code>b</code> for block
        start and end. A layout built from these mirrors under <code>dir="rtl"</code> without a
        second stylesheet. Here is the same class in both directions:
      </p>
      <div class="demo-stack">
        <div class="demo-box arc-ps-xl arc-py-sm"><code>.arc-ps-xl</code></div>
        <div class="demo-box arc-ps-xl arc-py-sm" dir="rtl"><code>.arc-ps-xl</code> <code>dir="rtl"</code></div>
      </div>
      <table>
        <tbody>
          {spacing.map(([name, decl]) => (
            <tr><td><code>{name}</code></td><td><code>{decl}</code></td></tr>
          ))}
        </tbody>
      </table>
      <p>
        Steps are <code>xs sm md lg xl 2xl 3xl 4xl</code>, plus <code>0</code> everywhere and
        <code>auto</code> on margins.
      </p>
    </section>

    <section id="layout">
      <h2 class="docs-heading">Layout</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <div class="demo-box arc-flex arc-items-center arc-justify-between arc-gap-md arc-p-md">
        <code>.arc-flex</code>
        <code>.arc-items-center</code>
        <code>.arc-justify-between</code>
      </div>
      <div class="demo-grid arc-grid arc-grid-cols-3 arc-gap-sm">
        <div class="demo-box arc-p-sm arc-col-span-2"><code>.arc-col-span-2</code></div>
        <div class="demo-box arc-p-sm"><code>.arc-grid-cols-3</code></div>
        <div class="demo-box arc-p-sm"><code>.arc-gap-sm</code></div>
        <div class="demo-box arc-p-sm arc-col-span-full"><code>.arc-col-span-full</code></div>
      </div>
      <ul>
        <li>
          <strong>Display</strong>: <code>.arc-flex</code>, <code>.arc-inline-flex</code>,
          <code>.arc-grid</code>, <code>.arc-block</code>, <code>.arc-contents</code>,
          <code>.arc-hidden</code>.
        </li>
        <li>
          <strong>Flex</strong>: <code>.arc-flex-col</code>, <code>.arc-flex-wrap</code>,
          <code>.arc-flex-1</code>, <code>.arc-grow</code>, <code>.arc-shrink-0</code>.
        </li>
        <li>
          <strong>Alignment</strong>: <code>.arc-items-center</code>,
          <code>.arc-justify-between</code>, <code>.arc-self-end</code>.
        </li>
        <li>
          <strong>Grid</strong>: <code>.arc-grid-cols-1</code> through <code>-6</code>,
          <code>.arc-col-span-*</code>, <code>.arc-col-span-full</code>.
        </li>
        <li>
          <strong>Size</strong>: <code>.arc-w-full</code>, <code>.arc-h-full</code>,
          <code>.arc-max-w-full</code>, and <code>.arc-min-w-0</code>, which lets a flex child
          shrink below its content width so its text can truncate with an ellipsis.
        </li>
      </ul>
    </section>

    <section id="surface">
      <h2 class="docs-heading">Surface</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <div class="arc-bg-card arc-border arc-rounded-md arc-shadow-lg arc-p-md demo-card">
        <div class="arc-text-primary"><code>.arc-bg-card .arc-border .arc-rounded-md .arc-shadow-lg</code></div>
        <div class="arc-text-secondary arc-text-sm"><code>.arc-text-secondary</code> <code>.arc-text-sm</code></div>
        <div class="arc-text-accent-primary arc-font-mono arc-text-sm"><code>.arc-text-accent-primary</code> <code>.arc-font-mono</code></div>
      </div>
      <table>
        <tbody>
          {surface.map(([name, decl]) => (
            <tr><td><code>{name}</code></td><td><code>{decl}</code></td></tr>
          ))}
        </tbody>
      </table>
      <p>
        Class names follow the token names, so <code>.arc-text-primary</code> is a color and
        <code>.arc-text-lg</code> is a type size, as with <code>--text-primary</code> and
        <code>--text-lg</code>. The generator fails the build if a new token would make a color
        and a size share a class name.
      </p>
      <p class="demo-fonts">
        Font classes name the five typographic <strong>roles</strong>:
        {fontRoles.map((role) => (
          <span class={`arc-font-${role}`}>.arc-font-{role}</span>
        ))}
      </p>
    </section>

    <section id="limits">
      <h2 class="docs-heading">Limits</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <ul>
        <li>
          <strong>Light DOM only.</strong> A class can't reach into a shadow root, so these style
          the space around ARC UI components and nothing inside them. For that, use
          <code>::part()</code> and the components' CSS custom properties.
        </li>
        <li>
          <strong>No responsive or state variants.</strong> There's no <code>sm:</code> or
          <code>hover:</code>. Write a media query.
        </li>
        <li>
          <strong>No arbitrary values.</strong> A class set to an arbitrary pixel value wouldn't
          follow the tokens.
        </li>
        <li>
          <strong>Requires the tokens.</strong> The scale classes read a <code>var()</code>, so
          load <code>base.css</code> or define the same variables yourself.
        </li>
      </ul>
    </section>
  </div>
</DocsLayout>

<style>
  .prose-page { max-width: 70ch; }
  .prose-page h1 { font-family: var(--font-display); margin-bottom: var(--space-lg); }
  .prose-page h2 { margin-top: var(--space-2xl); }
  .prose-page p { color: var(--text-secondary); line-height: 1.7; margin-bottom: var(--space-md); }
  .prose-page ul { color: var(--text-secondary); line-height: 1.7; padding-inline-start: var(--space-lg); margin-bottom: var(--space-md); }
  .prose-page li { margin-bottom: var(--space-sm); }
  .prose-page pre {
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
    margin-bottom: var(--space-md);
  }
  .prose-page code { font-family: var(--font-mono); font-size: var(--_text-sm); }
  .prose-page strong { color: var(--text-primary); }
  .prose-page table {
    inline-size: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-md);
  }
  .prose-page td {
    padding: var(--space-sm) var(--space-md) var(--space-sm) 0;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    vertical-align: top;
  }

  /* Demo chrome: everything else the demos do is the utility classes themselves. */
  .demo-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
  }
  .demo-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }
  .demo-grid { margin-bottom: var(--space-md); }
  .demo-card { margin-bottom: var(--space-md); }
  .demo-card > div { margin-bottom: var(--space-xs); }
  .demo-card > div:last-child { margin-bottom: 0; }
  .demo-fonts span {
    display: inline-block;
    margin-inline-start: var(--space-sm);
    color: var(--text-primary);
  }
</style>
