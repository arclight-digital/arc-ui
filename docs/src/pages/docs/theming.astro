---
import DocsLayout from '../../layouts/DocsLayout.astro';

const headings = [
  { id: 'how-themes-work', label: 'How themes work' },
  { id: 'dark-mode', label: 'Dark mode' },
  { id: 'light-mode', label: 'Light mode' },
  { id: 'auto-mode', label: 'Auto mode' },
  { id: 'fixed-regions', label: 'Fixed regions' },
  { id: 'custom-themes', label: 'Custom themes' },
  { id: 'synthesizer', label: 'Theme Synthesizer' },
];
---

<DocsLayout
  title="Theming"
  description="Switch ARC UI between dark, light and auto modes, pin regions to one scheme, and override tokens for a theme of your own."
  activeSlug="theming"
  headings={headings}
  breadcrumbs={[{ label: 'Theming' }]}
>
  <div class="theming-page">
    <h1 class="page-title">Theming</h1>
    <p class="page-desc">
      ARC UI's colors come from CSS custom properties. One attribute switches the mode, and
      overriding tokens gives you a theme of your own.
    </p>

    <section id="how-themes-work">
      <h2 class="docs-heading">How themes work</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        The <code>data-theme</code> attribute on <code>&lt;html&gt;</code> sets the mode. There
        are three:
      </p>
      <div class="theme-modes">
        <arc-card>
          <span class="theme-mode-card__label">Dark</span>
          <code>data-theme="dark"</code>
          <span class="theme-mode-card__desc">The default. Near-black surfaces with blue and violet accents.</span>
        </arc-card>
        <arc-card>
          <span class="theme-mode-card__label">Light</span>
          <code>data-theme="light"</code>
          <span class="theme-mode-card__desc">Light backgrounds, with darker accents for contrast.</span>
        </arc-card>
        <arc-card>
          <span class="theme-mode-card__label">Auto</span>
          <code>data-theme="auto"</code>
          <span class="theme-mode-card__desc">Follows the OS setting through <code>prefers-color-scheme</code>.</span>
        </arc-card>
      </div>
      <p class="docs-text">
        Components restyle as soon as the attribute changes. On this site, the toggle in the top
        bar changes it.
      </p>
    </section>

    <section id="dark-mode">
      <h2 class="docs-heading">Dark mode</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        Dark is the default, so the attribute is optional.
      </p>
      <div class="docs-code"><arc-code-block language="html" code={`<!-- Dark mode is the default — no attribute needed -->
<html>
  <!-- or explicitly: -->
<html data-theme="dark">`}></arc-code-block></div>
      <p class="docs-text">The background tokens, rendered on this page:</p>
      <div class="token-preview-grid">
        <arc-card class="token-preview" style="--bg-card: var(--bg-deep)">
          <code>--bg-deep</code>
        </arc-card>
        <arc-card class="token-preview" style="--bg-card: var(--bg-surface)">
          <code>--bg-surface</code>
        </arc-card>
        <arc-card class="token-preview">
          <code>--bg-card</code>
        </arc-card>
        <arc-card class="token-preview" style="--bg-card: var(--bg-elevated)">
          <code>--bg-elevated</code>
        </arc-card>
      </div>
    </section>

    <section id="light-mode">
      <h2 class="docs-heading">Light mode</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        In light mode, shadows are tinted with the accent colors instead of black.
      </p>
      <div class="docs-code"><arc-code-block language="html" code={`<html data-theme="light">`}></arc-code-block></div>
    </section>

    <section id="auto-mode">
      <h2 class="docs-heading">Auto mode</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        Auto follows the OS setting through <code>prefers-color-scheme</code>. To keep a
        visitor's own choice across visits, store it and restore it on load:
      </p>
      <div class="docs-code"><arc-code-block language="js" code={`// Set theme and persist
function setTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  localStorage.setItem('arc-theme', theme);
}

// Restore on page load
const saved = localStorage.getItem('arc-theme') || 'auto';
document.documentElement.setAttribute('data-theme', saved);`}></arc-code-block></div>
      <arc-alert variant="tip"><code>arc-theme-toggle</code> does this for you. It stores the choice in <code>localStorage</code> under <code>arc-theme</code>.</arc-alert>
    </section>

    <section id="fixed-regions">
      <h2 class="docs-heading">Fixed regions</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        <code>.theme-fixed-dark</code> and <code>.theme-fixed-light</code> keep a subtree in one
        scheme whatever the page theme is, for regions like a nav, a footer or a command bar.
        The class applies the same scheme the library generates for <code>:root</code>, so a
        pinned region has the contrast that scheme was tuned for.
      </p>
      <div class="docs-code"><arc-code-block language="html" code={`<div class="theme-fixed-dark">
  <arc-top-bar fixed>
    <!-- Dark tokens, whatever the page is doing -->
  </arc-top-bar>
</div>

<aside class="theme-fixed-light">
  <!-- and the reverse, for a light panel on a dark page -->
</aside>`}></arc-code-block></div>
      <p class="docs-text">
        On a page in the same scheme, a pinned region matches the page: a dark nav on a dark
        page is near-black. On a page in the other scheme it stops short, because near-black
        against near-white would be the hardest edge on the page. It uses a deep color derived
        from your accent instead. This site's top bar and footer work this way, and in light
        mode they're deep blue.
      </p>
      <arc-alert variant="tip">
        That color takes its hue from <code>--accent-primary</code> and its lightness from the
        scheme, so overriding your accent recolors pinned regions too. A teal accent gives a
        deep teal nav, and a gray one stays gray. A browser without relative color syntax
        keeps the default blue in pinned regions.
      </arc-alert>
    </section>

    <section id="custom-themes">
      <h2 class="docs-heading">Custom themes</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        Gradients, glows and focus rings read the accent tokens through <code>var()</code>.
        Override the two accents and their <code>-rgb</code> triplets (used for transparency)
        and those follow:
      </p>
      <div class="docs-code"><arc-code-block language="css" code={`:root {
  --accent-primary: rgb(0, 150, 136);
  --accent-primary-rgb: 0, 150, 136;
  --accent-secondary: rgb(233, 30, 99);
  --accent-secondary-rgb: 233, 30, 99;
  /* That's it. Glows, gradients, and focus rings recompose from these. */
}`}></arc-code-block></div>
      <p class="docs-text">
        The button below applies those four lines to this page:
      </p>
      <div class="cascade-demo">
        <arc-button id="cascade-toggle" variant="primary">Apply the override</arc-button>
      </div>
      <arc-alert variant="info">When you override accent or background tokens, keep text at 4.5:1 contrast and UI elements at 3:1.</arc-alert>
    </section>

    <section id="synthesizer">
      <h2 class="docs-heading">Theme Synthesizer</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        The <a href="/synth">Theme Synthesizer</a> edits colors, fonts, type sizes, spacing,
        radii, layout sizes and durations with a live preview. It exports
        <code>arc-theme.css</code> with only the tokens you changed, to load after
        <code>base.css</code>.
      </p>
      <div class="synth-cta">
        <a href="/synth">
          <arc-button variant="primary">Open the Theme Synthesizer</arc-button>
        </a>
      </div>
    </section>

    <section class="see-also">
      <h2 class="docs-heading">See also</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <ul class="see-also__list">
        <li><a href="/docs/tokens">Design tokens</a>: every token group, with values</li>
        <li><a href="/synth">Theme Synthesizer</a>: build a theme with a live preview</li>
        <li><a href="/docs/components/theme-toggle">Theme toggle</a>: a button that cycles through the three modes</li>
      </ul>
    </section>
  </div>
</DocsLayout>

<script>
  // Custom-theme cascade demo: apply the four base-token overrides from the
  // code block above to <html> (the same element :root compounds live on),
  // so every glow/gradient/focus-ring var() chain re-resolves page-wide.
  const CASCADE_OVERRIDES: Record<string, string> = {
    '--accent-primary': 'rgb(0, 150, 136)',
    '--accent-primary-rgb': '0, 150, 136',
    '--accent-secondary': 'rgb(233, 30, 99)',
    '--accent-secondary-rgb': '233, 30, 99',
  };

  function initCascadeDemo() {
    const btn = document.getElementById('cascade-toggle');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = 'true';
    const root = document.documentElement;
    const applied = () => root.style.getPropertyValue('--accent-primary') !== '';
    const sync = () => {
      btn.textContent = applied() ? 'Remove the override' : 'Apply the override';
    };
    btn.addEventListener('click', () => {
      const on = applied();
      for (const [prop, value] of Object.entries(CASCADE_OVERRIDES)) {
        if (on) root.style.removeProperty(prop);
        else root.style.setProperty(prop, value);
      }
      sync();
    });
    sync();
  }
  initCascadeDemo();
  document.addEventListener('astro:page-load', initCascadeDemo);
  // Demo is page-scoped: clean up on client-side navigation away.
  document.addEventListener('astro:before-swap', () => {
    for (const prop of Object.keys(CASCADE_OVERRIDES)) {
      document.documentElement.style.removeProperty(prop);
    }
  });
</script>

<style>
  /* Theme mode cards */
  .theme-modes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .theme-modes arc-card::part(inner) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
  }

  .theme-mode-card__label {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .theme-modes arc-card code {
    font-size: var(--text-xs);
    color: var(--text-primary);
  }

  .theme-mode-card__desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .theme-mode-card__desc code {
    font-size: var(--text-xs);
    background: var(--bg-surface);
    padding: 1px 4px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  /* Token preview cards */
  .token-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .token-preview::part(inner) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 60px;
    padding: var(--space-sm);
  }

  .token-preview code {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Cascade demo */
  .cascade-demo {
    margin-bottom: var(--space-md);
  }

  /* CTA */
  .synth-cta {
    margin-top: var(--space-sm);
  }

  .synth-cta a {
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .theme-modes { grid-template-columns: 1fr; }
  }
</style>
