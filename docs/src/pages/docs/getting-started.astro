---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { components } from '../../data/components/index';
import { version, tokenCount } from '../../data/site-stats';

const componentCount = components.length;

/* Ordered as the reader needs them, not as the library is organized: install,
   render something, then the things you only care about once it works. */
const headings = [
  { id: 'install', label: 'Install' },
  { id: 'first-component', label: 'Your first component' },
  { id: 'imports', label: 'Import patterns' },
  { id: 'frameworks', label: 'Framework setup' },
  { id: 'theming', label: 'Theming' },
  { id: 'design-tokens', label: 'Design tokens' },
  { id: 'typescript', label: 'TypeScript' },
  { id: 'own-components', label: 'Your own components' },
  { id: 'testing', label: 'Testing' },
  { id: 'production', label: 'Going to production' },
  { id: 'next-steps', label: 'Next steps' },
];

const cdnSnippet = `<link rel="stylesheet"
  href="https://unpkg.com/@arclux/arc-ui@${version}/base.css">
<script type="module"
  src="https://unpkg.com/@arclux/arc-ui@${version}/register"><\/script>

<arc-button variant="primary">Click Me</arc-button>`;

/* The three reference faces base.css names, at the weights the roles ask for.
   A face that is not loaded falls back to system-ui silently, so this is a
   step, not a footnote. */
const fontsSnippet = `<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@300..800&family=JetBrains+Mono:wght@400..700&family=Tomorrow:wght@400;500;600&display=swap">`;

const ownComponentSnippet = `import { LitElement, html, css } from 'lit';
import { tokenStyles } from '@arclux/arc-ui/shared-styles';

class AppPanel extends LitElement {
  static styles = [
    tokenStyles,
    css\`
      :host { display: block; padding: var(--space-md); }
    \`,
  ];
  render() {
    return html\`<slot></slot>\`;
  }
}
customElements.define('app-panel', AppPanel);`;

const testingSnippet = `// Playwright: the rendered copy, found by its role and text
await page.getByRole('menuitem', { name: 'Rename' }).click();
await page.getByRole('radio', { name: 'Weekly' }).click();

// Not the element you authored: it is display: none, and never receives the click
// await page.locator('arc-menu-item[value="rename"]').click();`;
---

<DocsLayout
  title="Getting started"
  description="Install ARC UI, register the components and render your first one."
  activeSlug="getting-started"
  headings={headings}
  breadcrumbs={[{ label: 'Getting started' }]}
>
  <div class="getting-started">
    <h1 class="page-title">Getting started</h1>
    <p class="page-desc">
      ARC UI is {componentCount} web components built with Lit. They work as plain HTML, and
      React, Vue, Svelte, Angular, Solid and Preact each get a generated wrapper package with
      typed props.
    </p>

    <!-- Install -->
    <section id="install">
      <h2 class="docs-heading">Install</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <arc-tabs class="install-tabs">
        <arc-tab label="npm">
          <arc-code-block language="bash" code="npm install @arclux/arc-ui lit"></arc-code-block>
        </arc-tab>
        <arc-tab label="pnpm">
          <arc-code-block language="bash" code="pnpm add @arclux/arc-ui lit"></arc-code-block>
        </arc-tab>
        <arc-tab label="yarn">
          <arc-code-block language="bash" code="yarn add @arclux/arc-ui lit"></arc-code-block>
        </arc-tab>
        <arc-tab label="CDN">
          <arc-code-block language="html" code={cdnSnippet}></arc-code-block>
        </arc-tab>
      </arc-tabs>

      <p class="docs-text">
        Lit is a peer dependency, so you install it alongside ARC UI. TODO(copy): the CDN tab's
        modules import <code>lit</code> by its bare name, which a browser can't resolve without an
        import map. Fix the snippet or drop the tab?
      </p>
    </section>

    <!-- Your First Component -->
    <section id="first-component">
      <h2 class="docs-heading">Your first component</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <ol class="steps">
        <li class="step">
          <div class="step__content">
            <strong class="step__title">Import the tokens and register the components</strong>
            <p class="docs-text">
              <code>base.css</code> defines the design tokens, and <code>register</code> defines
              the components.
            </p>
            <arc-code-block language="js" code={`import '@arclux/arc-ui/base.css';
import '@arclux/arc-ui/register';`}></arc-code-block>
          </div>
        </li>

        <li class="step">
          <div class="step__content">
            <strong class="step__title">Load the fonts</strong>
            <p class="docs-text">
              ARC UI ships no font files. <code>base.css</code> names three reference faces
              (Host Grotesk for body text, Tomorrow for labels, JetBrains Mono for code) and loads none
              of them. Skip this step and text renders in <code>system-ui</code>, and code in
              <code>ui-monospace</code>. A font CDN
              is the quickest way to load them:
            </p>
            <arc-code-block language="html" code={fontsSnippet}></arc-code-block>
            <p class="docs-text">
              To self-host, or to use your own typefaces instead, see
              <a href="/docs/typography#loading">Loading the font files</a>.
            </p>
          </div>
        </li>

        <li class="step">
          <div class="step__content">
            <strong class="step__title">Write the markup</strong>
            <p class="docs-text">
              These are plain HTML elements, with no provider or wrapper component to set up.
            </p>
            <arc-code-block language="html" code={`<arc-button variant="primary">Get Started</arc-button>
<arc-input label="Email" placeholder="you@example.com"></arc-input>
<arc-toggle label="Dark mode"></arc-toggle>`}></arc-code-block>
          </div>
        </li>

        <li class="step">
          <div class="step__content">
            <strong class="step__title">The result</strong>
            <p class="docs-text">
              This is the markup above, rendered on this page.
            </p>
            <div class="quick-demo">
              <arc-button variant="primary">Get Started</arc-button>
              <arc-input label="Email" placeholder="you@example.com"></arc-input>
              <arc-toggle label="Dark mode"></arc-toggle>
            </div>
          </div>
        </li>
      </ol>
    </section>

    <!-- Import Patterns -->
    <section id="imports">
      <h2 class="docs-heading">Import patterns</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <p class="docs-text">
        The three entry points differ in how much they load:
      </p>

      <div class="import-table">
        <div class="import-row">
          <code class="import-row__code">@arclux/arc-ui/register</code>
          <span class="import-row__note">Registers every component (except <code>arc-code-block</code>, below). The simplest choice while you're trying things out.</span>
        </div>
        <div class="import-row">
          <code class="import-row__code">@arclux/arc-ui/button</code>
          <span class="import-row__note">Registers one component and the components it uses. Use these in production to keep the bundle small.</span>
        </div>
        <div class="import-row">
          <code class="import-row__code">{`{ ArcButton } from '@arclux/arc-ui'`}</code>
          <span class="import-row__note">The class, for extending it or creating elements in script. Loads and registers every component except <code>arc-code-block</code> and the marketing and media groups (<code>@arclux/arc-ui/marketing</code>, <code>@arclux/arc-ui/media</code>).</span>
        </div>
      </div>

      <arc-alert variant="info" style="margin-top:var(--space-sm)">
        <code>arc-code-block</code> isn't in <code>register</code> or any other barrel, because
        it carries a syntax highlighter. Import it from <code>@arclux/arc-ui/code-block</code>.
      </arc-alert>
    </section>

    <!-- Framework Setup -->
    <section id="frameworks">
      <h2 class="docs-heading">Framework setup</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <p class="docs-text">
        Prism, the project's code generator, writes each wrapper package from the Lit source.
        Only the import changes:
      </p>
      <arc-code-block language="js" code={`import { Button, Card } from '@arclux/arc-ui-react';   // React
import { Button, Card } from '@arclux/arc-ui-vue';     // Vue
import { Button, Card } from '@arclux/arc-ui-svelte';  // Svelte
import { Button, Card } from '@arclux/arc-ui-angular'; // Angular
import { Button, Card } from '@arclux/arc-ui-solid';   // Solid
import { Button, Card } from '@arclux/arc-ui-preact';  // Preact`}></arc-code-block>

      <p class="docs-text">
        The <a href="/docs/frameworks">Frameworks</a> guide covers install and usage for each
        one, and using the elements without a wrapper.
      </p>
    </section>

    <!-- Theming -->
    <section id="theming">
      <h2 class="docs-heading">Theming</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <p class="docs-text">
        The <code>data-theme</code> attribute on <code>&lt;html&gt;</code> picks one of three modes:
      </p>
      <arc-code-block language="html" code={`<html data-theme="dark">   <!-- default -->
<html data-theme="light">
<html data-theme="auto">   <!-- follows OS preference -->`}></arc-code-block>

      <p class="docs-text">
        The theme toggle in this site's top bar sets that attribute. For a theme of your own,
        override the tokens (see <a href="/docs/theming">Theming</a>) or build one in the
        <a href="/synth">Theme Synthesizer</a> and export it.
      </p>
    </section>

    <!-- Design Tokens -->
    <section id="design-tokens">
      <h2 class="docs-heading">Design tokens</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <p class="docs-text">
        <code>base.css</code> defines {tokenCount} custom properties, and the components read
        the same ones. Your own CSS can use them too:
      </p>

      <arc-code-block language="css" code={`@import '@arclux/arc-ui/base.css';

.my-component {
  color: var(--text-primary);
  background: var(--bg-card);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  font-family: var(--font-body);
  box-shadow: var(--shadow-md);
}`}></arc-code-block>

      <div class="token-preview">
        <div class="token-category">
          <span class="token-category__label">Colors</span>
          <div class="token-chips">
            <span class="token-chip" style="background:var(--accent-primary)"></span>
            <span class="token-chip" style="background:var(--accent-secondary)"></span>
            <span class="token-chip" style="background:var(--color-success)"></span>
            <span class="token-chip" style="background:var(--color-warning)"></span>
            <span class="token-chip" style="background:var(--color-error)"></span>
            <span class="token-chip" style="background:var(--color-info)"></span>
          </div>
        </div>
        <div class="token-category">
          <span class="token-category__label">Spacing</span>
          <code class="token-mono">--space-xs · sm · md · lg · xl · 2xl</code>
        </div>
        <div class="token-category">
          <span class="token-category__label">Radii</span>
          <code class="token-mono">--radius-xs · sm · md · lg · xl · full</code>
        </div>
        <div class="token-category">
          <span class="token-category__label">Shadows</span>
          <code class="token-mono">--shadow-xs · sm · md · lg · xl</code>
        </div>
      </div>

      <p class="docs-text">
        The <a href="/docs/tokens">Design tokens</a> page lists them by group.
      </p>
    </section>

    <!-- TypeScript -->
    <section id="typescript">
      <h2 class="docs-heading">TypeScript</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <p class="docs-text">
        The framework wrappers ship their own types. To type <code>arc-*</code> tags in React,
        Preact or Solid JSX without a wrapper, add the generated declaration file to your
        program as a file. A <code>types</code> entry in <code>compilerOptions</code> does
        nothing here (see <a href="/docs/frameworks#no-wrapper">Without a wrapper</a>).
      </p>

      <arc-code-block language="json" filename="tsconfig.json" code={`{
  "include": [
    "src",
    "node_modules/@arclux/arc-ui/types/react-jsx.d.ts"
  ]
}`}></arc-code-block>
    </section>

    <!-- Going to Production -->
    <section id="own-components">
      <h2 class="docs-heading">Your own components</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <p class="docs-text">
        A component you write with Lit has its own shadow root, and a shadow root does not see
        document styles. The <code>*, *::before, *::after {'{'} box-sizing: border-box {'}'}</code>
        reset in your global stylesheet stops at its boundary, so padded boxes inside it overflow
        and nothing in your page's CSS shows why.
      </p>
      <p class="docs-text">
        Adopt <code>tokenStyles</code>, the styles ARC UI's own components start from. It has the
        box-sizing and margin reset, the static token defaults and the reduced-motion rule:
      </p>
      <arc-code-block language="js" code={ownComponentSnippet}></arc-code-block>
      <p class="docs-text">
        Themed tokens (colors, shadows, gradients) aren't in it. Custom properties inherit
        through the shadow boundary, so they reach your component from <code>base.css</code> on
        the document, as they do for every ARC UI component.
      </p>
      <p class="docs-text">
        <code>tokenStyles</code> also zeroes every margin and padding, as ARC UI's components expect.
        To add only the box-sizing reset to components you already have, adopt
        <code>resetStyles</code> from the same module instead.
      </p>
    </section>

    <section id="testing">
      <h2 class="docs-heading">Testing</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <p class="docs-text">
        Some components read the children you write as data and render their own copies. The
        <code>arc-menu-item</code>s inside <code>arc-dropdown-menu</code> and the
        <code>arc-option</code>s inside <code>arc-segmented-control</code> and
        <code>arc-select</code> are <code>display: none</code>. The visible, clickable item is
        the copy in the parent's shadow root, so a test that clicks the element you wrote fails
        with "element is not visible". Each component that works this way says "read as data"
        on its default slot, in the API reference and in
        <code>custom-elements.json</code>, where each parent also lists the elements it expects
        under <code>children</code>, with their slot.
      </p>
      <p class="docs-text">
        Find the rendered item the way a user does, by its role and its text. The rendered copies
        carry the roles (<code>menuitem</code>, <code>radio</code>, <code>option</code>), and
        Playwright's role locators pierce shadow roots:
      </p>
      <arc-code-block language="js" code={testingSnippet}></arc-code-block>
    </section>

    <section id="production">
      <h2 class="docs-heading">Going to production</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <p class="docs-text">
        A custom element renders its fallback content until JavaScript registers it.
        <code>base.css</code> hides that fallback (<code>:not(:defined) {'{'} opacity: 0 {'}'}</code>), so unregistered components stay hidden and fade in as their definitions load. On a
        page with many components, two more steps make them appear sooner and stop the layout
        shifting.
      </p>

      <p class="docs-text">
        <strong>Register what's above the fold first.</strong> Import the components visible on
        first paint statically, so they land in a small chunk, and load the full registry with a
        dynamic import after them.
      </p>
      <arc-code-block language="js" code={`import '@arclux/arc-ui/base.css';

// Shell components visible on first paint — small synchronous chunk
import '@arclux/arc-ui/top-bar';
import '@arclux/arc-ui/button';
import '@arclux/arc-ui/badge';

// Everything else — lazy chunk that fades in when ready
import('@arclux/arc-ui/register');`}></arc-code-block>

      <p class="docs-text">
        <strong>Reserve space for layout-critical elements.</strong> A hidden element still takes
        up space, so give shell components their final size before they upgrade and nothing
        moves when they do.
      </p>
      <arc-code-block language="css" code={`arc-top-bar:not(:defined) {
  display: block;
  height: 64px;
}

arc-button:not(:defined) {
  display: inline-flex;
  min-height: 40px;
}`}></arc-code-block>

      <p class="docs-text">
        This site loads its top bar, navigation and buttons this way. If you server-render, every
        component arrives as declarative shadow DOM, styled before any JavaScript runs. See
        <a href="/docs/server-rendering">Server rendering</a>.
      </p>
    </section>

    <!-- Next Steps -->
    <section id="next-steps">
      <h2 class="docs-heading">Next steps</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>

      <div class="next-grid">
        <arc-feature-card heading="Browse components" description={`${componentCount} components, each with a live demo and API reference.`} href="/docs/components">
          <arc-icon slot="icon" name="squares-four" size="md"></arc-icon>
        </arc-feature-card>
        <arc-feature-card heading="Frameworks" description="Install and usage for each framework, and using the elements without a wrapper." href="/docs/frameworks">
          <arc-icon slot="icon" name="stack" size="md"></arc-icon>
        </arc-feature-card>
        <arc-feature-card heading="Design tokens" description="Every token group, with names and values." href="/docs/tokens">
          <arc-icon slot="icon" name="palette" size="md"></arc-icon>
        </arc-feature-card>
        <arc-feature-card heading="Theme Synthesizer" description="Build a theme with a live preview and export it as CSS." href="/synth">
          <arc-icon slot="icon" name="sliders" size="md"></arc-icon>
        </arc-feature-card>
      </div>
    </section>
  </div>
</DocsLayout>

<style>
  /* arc-code-block takes the measure from docs.css, site-wide. These are the
     page's own blocks, held to the same edge. */
  .install-tabs,
  .import-table,
  .quick-demo,
  .token-preview,
  .getting-started :global(arc-alert) {
    max-width: var(--docs-measure);
  }

  /* Install: one command at a time. Three stacked panels spent most of a
     screen restating the same line for package managers a reader has already
     chosen between, and the tabs come with the copy button the raw snippets
     never had. */
  .install-tabs {
    margin-bottom: var(--space-sm);
  }

  .install-tabs :global(arc-code-block) {
    margin-bottom: 0;
  }

  /* Steps: an ordered list, so the numbering is the document's rather than
     three hand-placed spans, and a screen reader is told how many there are. */
  .steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: 0;
  }

  .step {
    counter-increment: step;
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .step::before {
    content: counter(step);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-top: 2px;
    border-radius: 50%;
    background: rgba(var(--accent-primary-rgb), 0.12);
    border: 1px solid rgba(var(--accent-primary-rgb), 0.35);
    box-shadow: 0 0 12px rgba(var(--accent-primary-rgb), 0.15);
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .step__content {
    flex: 1;
    min-width: 0;
  }

  .step__title {
    display: block;
    font-size: var(--text-md);
    color: var(--text-primary);
    margin-bottom: var(--space-xs);
  }

  .step__content .docs-text {
    margin-bottom: var(--space-xs);
  }

  .quick-demo {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    flex-wrap: wrap;
  }

  /* Import patterns: the specifier and what it costs you, side by side. This
     was a bulleted aside inside step one, where it interrupted the first thing
     the reader was trying to do with a decision they could not yet make. */
  .import-table {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .import-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-sm) var(--space-md);
  }

  .import-row + .import-row {
    border-top: 1px solid var(--border-subtle);
  }

  .import-row__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-primary);
  }

  .import-row__note {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Token preview */
  .token-preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
  }

  .token-category {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .token-category__label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    min-width: 64px;
  }

  .token-chips {
    display: flex;
    gap: 6px;
  }

  .token-chip {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
  }

  .token-mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  /* Next steps grid */
  .next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
  }

  @media (max-width: 768px) {
    .step { gap: var(--space-sm); }
  }
</style>
