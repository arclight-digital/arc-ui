---
import DocsLayout from '../../layouts/DocsLayout.astro';

const headings = [
  { id: 'roles-not-typefaces', label: 'How roles work' },
  { id: 'the-roles', label: 'The roles' },
  { id: 'assigning', label: 'Assigning a typeface' },
  { id: 'loading', label: 'Loading the font files' },
  { id: 'fallbacks', label: 'Fallbacks & layout shift' },
  { id: 'reference-faces', label: 'The reference faces' },
];

const roles = [
  {
    slot: 'body',
    name: 'Body',
    reference: 'Host Grotesk',
    fallback: 'system-ui, sans-serif',
    weight: '500',
    uses: 'Prose, inputs, descriptions, option lists, table cells. The default for everything not covered by another role.',
    specimen: 'Sphinx of black quartz, judge my vow.',
  },
  {
    slot: 'label',
    name: 'Label',
    reference: 'Tomorrow',
    fallback: 'system-ui, -apple-system, Segoe UI, sans-serif',
    weight: '600',
    uses: 'Form labels, table headers, eyebrows, dividers, segment labels. Set small, uppercase and tracked, so it needs a face that reads well at 12px in capitals.',
    specimen: 'Section label',
  },
  {
    slot: 'mono',
    name: 'Mono',
    reference: 'JetBrains Mono',
    fallback: 'ui-monospace, monospace',
    weight: '400',
    uses: 'Code blocks, keyboard hints, command palette shortcuts, and tabular numerics: meter readouts, stat deltas, calendar day numbers.',
    specimen: '1,024.7 ms · +12.4% · 0x2F',
  },
  {
    slot: 'display',
    name: 'Display',
    reference: 'follows Body',
    fallback: 'follows Body',
    weight: '500',
    uses: 'Large headings and hero type. Uses the Body face until you assign one. Its weight is set separately from Body\'s.',
    specimen: 'Radiant interfaces',
  },
  {
    slot: 'quote',
    name: 'Quote',
    reference: 'Georgia',
    fallback: 'serif',
    weight: '200',
    uses: 'The quotation glyph on arc-blockquote, the one place the system wants a serif.',
    specimen: '“',
  },
];
---

<DocsLayout
  title="Typography"
  description="ARC UI ships no font files. Assign your own typefaces to five role slots."
  activeSlug="typography"
  headings={headings}
  breadcrumbs={[{ label: 'Typography' }]}
>
  <div class="typography-page">
    <h1 class="page-title">Typography</h1>
    <p class="page-desc">
      ARC UI ships no font files. It defines five typographic <strong>roles</strong> and names a
      reference face for each. To use your own face, override one token per role.
    </p>

    <section id="roles-not-typefaces">
      <h2 class="docs-heading">How roles work</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        Components assign a role to each piece of text and set its size, weight and tracking.
        You pick the face for each role and load its font files.
      </p>
      <p class="docs-text">
        Each role has four tokens: the family you assign, the fallback stack, the weight, and the
        combined value that components read:
      </p>
      <arc-code-block language="css" code={`--font-body-family:    'Host Grotesk';               /* assign this */
--font-body-fallback:  system-ui, sans-serif;        /* rarely */
--font-body-weight:    500;                          /* if your face disagrees */
--font-body:           var(--font-body-family), var(--font-body-fallback);`}></arc-code-block>
      <p class="docs-text">
        Override only <code>-family</code>. The fallback stays in place and every component using
        that role picks up the new face, so you never retype a font stack.
      </p>
      <p class="docs-text">
        The weight is its own token because your face may not have the weight the role uses.
        Label is set at 600. Point it at a face whose heaviest cut is 500 and the browser fakes
        the bold, which looks smeared. Setting <code>--font-label-weight</code> to 500 fixes every
        component at once, because derived tokens like <code>--section-title-weight</code> and
        <code>--ui-accent-weight</code> read the role's weight instead of repeating the number.
      </p>
    </section>

    <section id="the-roles">
      <h2 class="docs-heading">The roles</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <div class="role-list">
        {roles.map((r) => (
          <arc-card>
            <div class="role-head">
              <span class="role-name">{r.name}</span>
              <code class="role-slot">--font-{r.slot}-family</code>
            </div>
            <div class={`role-specimen role-specimen--${r.slot}`}>{r.specimen}</div>
            <p class="role-uses">{r.uses}</p>
            <div class="role-meta">
              <span><strong>Reference</strong> {r.reference}</span>
              <span><strong>Fallback</strong> {r.fallback}</span>
              <span><strong>Weight</strong> {r.weight}</span>
            </div>
          </arc-card>
        ))}
      </div>
      <p class="docs-text">
        <code>--font-accent</code> is an alias of the Label role, kept from before the roles were
        split out. The name sounds like a display face, but it has always set form labels and
        table headers. Use <code>--font-label</code> in new work.
      </p>
    </section>

    <section id="assigning">
      <h2 class="docs-heading">Assigning a typeface</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        Set the family tokens on <code>:root</code>, after ARC UI's stylesheet. Custom properties
        inherit through the shadow boundary, so components pick them up.
      </p>
      <arc-code-block language="css" code={`@import '@arclux/arc-ui/base.css';

:root {
  --font-body-family:    'Inter';
  --font-label-family:   'Inter';
  --font-mono-family:    'IBM Plex Mono';
  --font-display-family: 'Fraunces';   /* opt into a display face */
}`}></arc-code-block>
      <p class="docs-text">
        Assigning one role leaves the others alone, except Display, which follows Body until you
        assign it. A role you don't assign keeps its reference face, or its fallback if that face
        isn't loaded.
      </p>
      <h3 class="tier-heading">Using one typeface everywhere</h3>
      <p class="docs-text">
        Point the roles at the same family. Size, weight and tracking are set separately for each
        role, so the hierarchy stays.
      </p>
      <arc-code-block language="css" code={`:root {
  --font-body-family:  'Inter';
  --font-label-family: 'Inter';
}`}></arc-code-block>
      <h3 class="tier-heading">Scoping to part of a page</h3>
      <p class="docs-text">
        Role tokens are ordinary custom properties, so they cascade. Assign them on any ancestor
        to change the faces in that part of the page.
      </p>
      <arc-code-block language="css" code={`.marketing-section {
  --font-display-family: 'Playfair Display';
}`}></arc-code-block>
    </section>

    <section id="loading">
      <h2 class="docs-heading">Loading the font files</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        Assigning a role tells components which family to ask for. Loading the font is up to you:
        self-host it, use a font CDN, or use a package like Fontsource. A self-hosted
        <code>@font-face</code> looks like this:
      </p>
      <arc-code-block language="css" code={`@font-face {
  font-family: 'Inter';
  src: url('/fonts/inter-variable.woff2') format('woff2');
  font-weight: 100 900;        /* the font's real axis range, not one face per weight */
  font-display: swap;
  font-style: normal;
}

:root { --font-body-family: 'Inter'; }`}></arc-code-block>
      <p class="docs-text">
        Declare a variable font <strong>once</strong>, with a weight range. If you declare the
        same file several times with one weight each, the browser can't set the
        <code>wght</code> axis and renders the font's <em>default instance</em> for all of them.
        There's no error, and every weight ARC UI uses, from 200 to 700, renders the same.
      </p>
      <p class="docs-text">
        Use the range the font has. A weight outside it gets the nearest end of the axis, so a
        face whose lightest cut is 300 can't give the Quote role its default 200. Set
        <code>--font-quote-weight</code> to a weight the face has.
      </p>
      <p class="docs-text">
        Preload the faces used above the fold, and only those:
      </p>
      <arc-code-block language="html" code={`<link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />`}></arc-code-block>

      <h3 class="tier-heading">Use the family name the package registers</h3>
      <p class="docs-text">
        Whatever loads your font decides what the family is <em>called</em>, and the assignment
        has to use that exact string. An unknown family name isn't an error. The browser skips
        it, the role falls back, and the page renders in <code>system-ui</code>, which looks
        enough like a grotesque that you may not notice. Fontsource's variable packages, for
        example, register the family with a <code>Variable</code> suffix:
      </p>
      <arc-code-block language="js" code={`import '@fontsource-variable/host-grotesk';   // registers "Host Grotesk Variable"`}></arc-code-block>
      <arc-code-block language="css" code={`:root {
  --font-body-family: 'Host Grotesk';            /* ✗ silently unused */
  --font-body-family: 'Host Grotesk Variable';   /* ✓ what the package registered */
}`}></arc-code-block>
      <p class="docs-text">
        The static Fontsource packages (<code>@fontsource/host-grotesk</code>) register the bare
        name. To check yours, read the <code>font-family</code> in the package's CSS, or open
        DevTools: the Computed panel shows the face that's rendering, and Rendered Fonts shows
        the file it came from. If it says <code>system-ui</code>, the name is wrong.
      </p>
    </section>

    <section id="fallbacks">
      <h2 class="docs-heading">Fallbacks &amp; layout shift</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        Each role has a fallback stack, used when its face isn't loaded. You can replace a
        fallback on its own:
      </p>
      <arc-code-block language="css" code={`:root { --font-body-fallback: Georgia, serif; }`}></arc-code-block>
      <p class="docs-text">
        A fallback has different widths and vertical metrics from your webfont, so text reflows
        when the real face arrives. To prevent that, declare a fallback adjusted to your font's
        metrics:
      </p>
      <arc-code-block language="css" code={`@font-face {
  font-family: 'Inter Fallback';
  src: local('Arial');
  size-adjust: 107%;        /* measured against Inter, not a general-purpose value */
  ascent-override: 90%;
  descent-override: 22%;
}

:root {
  --font-body-family:   'Inter';
  --font-body-fallback: 'Inter Fallback', system-ui, sans-serif;
}`}></arc-code-block>
      <p class="docs-text">
        Fontaine and <code>next/font</code> can generate these overrides for you. With
        <code>font-display: swap</code> and a matched fallback, the swap no longer shows as a
        jump.
      </p>
    </section>

    <section id="reference-faces">
      <h2 class="docs-heading">The reference faces</h2>
      <arc-divider align="left" variant="line-gradient" style="max-width:48px;margin-bottom:var(--space-md)"></arc-divider>
      <p class="docs-text">
        The defaults name Host Grotesk, Tomorrow, JetBrains Mono and Georgia. The components were
        designed with them, and this site loads them for the specimens above, but ARC UI doesn't
        ship or load them. If you load nothing, each role renders in its fallback, and that's a
        supported setup.
      </p>
    </section>
  </div>
</DocsLayout>

<style>
  .role-list {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .role-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .role-name {
    font-family: var(--font-label);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .role-slot {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--interactive);
  }

  .role-specimen {
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .role-specimen--body {
    font-family: var(--font-body);
    font-weight: var(--font-body-weight);
    font-size: var(--text-lg);
  }

  .role-specimen--label {
    font-family: var(--font-label);
    font-weight: var(--font-label-weight);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .role-specimen--mono {
    font-family: var(--font-mono);
    font-weight: var(--font-mono-weight);
    font-size: var(--text-md);
    font-variant-numeric: tabular-nums;
  }

  .role-specimen--display {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .role-specimen--quote {
    font-family: var(--font-quote);
    font-weight: var(--font-quote-weight);
    font-size: var(--text-3xl);
    line-height: 1;
  }

  .role-uses {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .role-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .role-meta strong {
    font-family: var(--font-label);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-ghost);
    margin-right: var(--space-xs);
  }
</style>
