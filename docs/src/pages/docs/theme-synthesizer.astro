---
/**
 * The synthesizer moved to /synth when it stopped being a docs page and became
 * an application. This stub keeps every published link, search result and
 * bookmark pointing at the old URL working.
 *
 * A meta refresh rather than a server redirect: the docs site is static, and a
 * `_redirects` rule would only cover the Cloudflare deployment — anyone
 * previewing a build locally, or serving the output anywhere else, would get a
 * 404 on a URL that has been in the sidebar for two minor versions.
 */
const target = '/synth';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Theme Synthesizer — ARC UI</title>
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>The Theme Synthesizer has moved to <a href={target}>arcui.dev/synth</a>.</p>
  </body>
</html>
