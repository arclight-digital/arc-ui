---
/**
 * SiteSearch — ⌘K / Ctrl+K site-wide search built on arc-command-palette.
 *
 * Two tiers, on purpose:
 *
 *   Titles — all ~175 guides and components, rendered statically at build time.
 *     They are the dominant query and they cost one HTML block that compresses
 *     to a few KB and caches identically on every page. No fetch, so ⌘K is
 *     usable the instant the page is interactive.
 *   Content — every `<section>` of every page, fetched once on first open from
 *     /search-index.json (built by integrations/search-index.mjs). Inlining it
 *     would put the whole site's prose into every page; fetching it eagerly
 *     would spend that on readers who never search.
 *
 * The palette matches fuzzily and ranks, and it searches an item's
 * `description` as well as its label — which is what makes the content tier
 * work at all. See shared/fuzzy-match.js.
 */
import { components } from '../data/components/index';

const tierOrder = ['layout', 'navigation', 'content', 'data', 'typography', 'input', 'feedback'];
const tierIcons: Record<string, string> = {
  layout: 'layout',
  navigation: 'compass',
  content: 'article',
  data: 'chart-bar',
  typography: 'text-aa',
  input: 'textbox',
  feedback: 'bell',
};
// Same order as the sidebar: fixed tier order, alphabetical within tier
const ordered = tierOrder.flatMap((t) =>
  components.filter((c) => c.tier === t).sort((a, b) => a.name.localeCompare(b.name)),
);

const guides = [
  { title: 'Getting Started', href: '/docs/getting-started' },
  { title: 'Components', href: '/docs/components' },
  { title: 'Design Tokens', href: '/docs/tokens' },
  { title: 'Theming', href: '/docs/theming' },
  { title: 'Theme Synthesizer', href: '/synth' },
  { title: 'Frameworks', href: '/docs/frameworks' },
  { title: 'Accessibility', href: '/docs/accessibility' },
  { title: 'Utilities', href: '/docs/utilities' },
  { title: 'Server Rendering', href: '/docs/server-rendering' },
  { title: 'Browser Support', href: '/docs/browser-support' },
  { title: 'Contributing', href: '/docs/contributing' },
  { title: 'Changelog', href: '/docs/changelog' },
];

const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
---

<arc-command-palette id="site-search" placeholder="Search components and guides…">
  <arc-command-group heading="Guides">
    {guides.map((g) => (
      <arc-command-item icon="book-open" shortcut="Guide" value={g.href}>{g.title}</arc-command-item>
    ))}
  </arc-command-group>
  {tierOrder.map((tier) => (
    <arc-command-group heading={cap(tier)}>
      {ordered.filter((c) => c.tier === tier).map((c) => (
        <arc-command-item
          icon={tierIcons[c.tier]}
          shortcut={cap(c.tier)}
          keywords={[c.tag, ...(c.searchKeywords ?? [])].join(' ')}
          value={`/docs/components/${c.slug}`}
        >{c.name}</arc-command-item>
      ))}
    </arc-command-group>
  ))}
  {/* Filled on first open from /search-index.json. Present in the markup so
      the palette has a group to append into and the heading order is fixed
      rather than depending on when the fetch lands. */}
  <arc-command-group heading="On this site" id="site-search-content"></arc-command-group>
</arc-command-palette>

<script is:inline>
  (function () {
    // Document-level delegation: document survives view-transition swaps, so
    // these listeners bind once per session and keep working after navigation.
    if (window.__arcSiteSearch) return;
    window.__arcSiteSearch = true;

    var getPalette = function () { return document.getElementById('site-search'); };

    // The content tier, fetched once per session on first open. The palette
    // watches its own light DOM, so appending items is all that is needed —
    // there is nothing to notify.
    var indexState = 'idle';
    function loadContentIndex() {
      if (indexState !== 'idle') return;
      indexState = 'loading';

      fetch('/search-index.json')
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (records) {
          var group = document.getElementById('site-search-content');
          if (!group || !records.length) { indexState = 'done'; return; }

          // One fragment, one insertion: appending 1,400 elements one at a time
          // would run the palette's MutationObserver on every one of them.
          var frag = document.createDocumentFragment();
          records.forEach(function (r) {
            var item = document.createElement('arc-command-item');
            item.setAttribute('icon', 'text-align-left');
            item.setAttribute('shortcut', r.page || 'Page');
            item.setAttribute('value', r.href);
            // The prose is searched and shown as the second line; the page name
            // goes in keywords so "theming contrast" finds a section of the
            // theming guide whose own heading never says "theming".
            if (r.text) item.setAttribute('description', r.text);
            item.setAttribute('keywords', ((r.page || '') + ' ' + (r.text || '')).slice(0, 400));
            item.textContent = r.title;
            frag.appendChild(item);
          });
          group.appendChild(frag);
          indexState = 'done';
        })
        .catch(function () {
          // Titles still work. A search that silently loses its content tier is
          // better than one that throws on open.
          indexState = 'idle';
        });
    }

    function openPalette(p, toggle) {
      if (!p) return;
      loadContentIndex();
      p.open = toggle ? !p.open : true;
    }

    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && !e.shiftKey && !e.altKey && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault();
        openPalette(getPalette(), true);
      }
    });

    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest && e.target.closest('[data-site-search-trigger]');
      if (t) openPalette(getPalette(), false);
    });

    // detail.value is the item's href. This used to search back through the DOM
    // for an item whose label and shortcut matched the ones reported, because
    // the palette carried no value — which picked the wrong item whenever two
    // shared a label, and content sections share headings constantly ("Usage"
    // appears on most component pages).
    document.addEventListener('arc-select', function (e) {
      var p = getPalette();
      if (!p || e.target !== p) return;
      var href = e.detail && e.detail.value;
      if (!href) return;
      p.open = false;
      window.location.assign(href);
    });

    // The key handler is OS-agnostic (metaKey || ctrlKey); only the visible
    // hint is platform-specific.
    var applyKbd = function () {
      var mac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
      document.querySelectorAll('[data-search-kbd]').forEach(function (el) {
        el.textContent = mac ? '⌘K' : 'Ctrl K';
      });
    };
    applyKbd();
    document.addEventListener('astro:page-load', applyKbd);
  })();
</script>
