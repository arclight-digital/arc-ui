---
/**
 * The tabbed code block on a component page — one tab per framework.
 *
 * This used to also render a header, a live preview and an API table, behind a
 * `codeOnly` flag. Its only caller always passed that flag, so none of it ever
 * rendered: the page supplies its own heading, the preview comes from the
 * component data, and the API is `ApiList`. Those branches are gone rather than
 * kept as a second, divergent implementation of surfaces that already exist.
 */
import { Code } from 'astro:components';

interface CodeTab {
  label: string;
  lang: string;
  code: string;
}

interface Props {
  tabs: CodeTab[];
}

const { tabs } = Astro.props;

/** Astro's `Code` takes a fixed set of grammars; everything else is JS. */
function grammar(lang: string) {
  if (lang === 'html' || lang === 'css') return lang;
  if (lang === 'jsx' || lang === 'tsx') return 'tsx';
  return 'js';
}
---

<section class="showcase">
  <div class="showcase__code-area">
    <arc-tabs>
      {tabs.map((tab) => (
        <arc-tab label={tab.label}>
          <div class="showcase__code-wrap">
            <arc-copy-button value={tab.code}></arc-copy-button>
            <Code code={tab.code} lang={grammar(tab.lang)} theme="css-variables" />
          </div>
        </arc-tab>
      ))}
    </arc-tabs>
  </div>
</section>

<style>
  .showcase {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }

  .showcase__code-area arc-tab {
    margin: calc(-1 * var(--space-lg)) 0;
  }

  .showcase__code-wrap {
    position: relative;
  }

  .showcase__code-wrap arc-copy-button {
    position: absolute;
    top: var(--space-sm);
    inset-inline-end: var(--space-sm);
    z-index: 1;
  }

  .showcase__code-wrap pre {
    margin: 0;
    border: none;
    border-radius: 0;
    background: var(--bg-surface);
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-sm);
    position: static;
  }

  .showcase__code-wrap pre::before {
    display: none;
  }

  @media (max-width: 768px) {
    .showcase__code-wrap pre {
      padding: var(--space-sm) var(--space-md);
      font-size: var(--text-xs);
    }
  }
</style>
