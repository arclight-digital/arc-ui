---
/**
 * The API surface of a component: aligned metadata columns, with each
 * member's description on its own full-width row beneath them.
 *
 * The four-column version failed because the description column competed with
 * the other three for width and always won: identifiers broke mid-word
 * (`paddi`/`ng`, `inter`/`active`) and a union type wrapped across three lines.
 * `overflow-wrap: anywhere` was on every cell to stop the panel scrolling
 * sideways — correct in itself, since a scroll region with nothing focusable in
 * it is an axe failure, but applied to the prop name it broke the one string
 * that must stay whole.
 *
 * Dropping the description out of the column grid fixes the cause: name and
 * type keep a single meaning per column and now have the width to sit on one
 * line, and the prose gets the full measure. The default rides at the type's
 * shoulder rather than holding a column of its own — it is an annotation on the
 * type, and a column made it a peer while leaving most rows to pad themselves
 * with a placeholder dash. One `tbody` per member, so a member and its
 * description are one unit to the document outline rather than two adjacent
 * rows that happen to be related.
 *
 * ## Why nothing here is in a container
 *
 * The first pass gave every datum its own treatment: the type in a bordered
 * chip, the default behind an uppercase eyebrow, the header filled and tracked
 * out to 2px, a hover tint on rows that aren't interactive. Decorating each
 * field to the same degree ranks none of them — the reader gets four things
 * shouting at one volume and has to sort out the hierarchy themselves. It is
 * also the most reproduced docs-table styling there is, which is its own
 * argument against it.
 *
 * So the rank is carried by the type itself, in the one order that survives
 * this palette: the name is lifted to --text-primary and bolded, the type sits
 * at --text-secondary in mono, and the default reads as source — `= "md"` —
 * rather than as a labelled field. Stepping down the muted/ghost ramp instead
 * would have bought almost nothing; those two are a handful of rgb points
 * apart, so weight, size and family do the work colour can't.
 */
interface Row {
  name: string;
  /** Props: the declared type. */
  type?: string;
  /** Props: the constructor default, already quoted as source text. */
  default?: string;
  /** Events: the detail payload type. */
  detail?: string;
  description: string;
}

interface Props {
  rows: Row[];
  kind?: 'prop' | 'event';
}

const { rows, kind = 'prop' } = Astro.props;

/** Second cell: the type for a prop, the detail payload for an event. */
const secondary = (r: Row) => (kind === 'event' ? r.detail : r.type);
---

<dl class="api">
  {rows.map((r) => (
    <div class="api__member">
      <dt class="api__sig">
        <code class="api__name">{r.name}</code>
        {secondary(r) && (
          <code class="api__type">
            {kind === 'event' && <span class="api__key">detail:</span>}
            {secondary(r)}
          </code>
        )}
        {kind === 'prop' && r.default && (
          <code class="api__default"><span class="api__eq" aria-hidden="true">=</span>{r.default}</code>
        )}
      </dt>
      <dd class="api__desc">{r.description}</dd>
    </div>
  ))}
</dl>

<style>
  .api {
    margin: 0;
  }

  /* The panel itself has no padding — the table this replaced was inset by its
     own cell padding, so the inset has to be reinstated here or every line sits
     flush against the card border. It rides on the member rather than the list
     so each rule still spans the full width of the panel, edge to edge. */
  .api__member {
    padding: var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
  }

  .api__member:last-child {
    border-bottom: none;
  }

  /* The signature, read the way it is written in a d.ts: name, type, default,
     on one baseline. As a two-column table the type sat a dead 300px away from
     the name it belonged to — a colspan description row inflates the first
     column no matter what width it is given — and the pair had to be read
     across a gap rather than as one line. */
  .api .api__sig {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-sm);
    row-gap: var(--space-xs);
  }

  /* The one string on this page that must never break. */
  .api .api__name {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
  }

  /* A documented object type — `Array<{key:string,label:string}>` — has no
     spaces to break at, so it alone may break anywhere rather than push the
     panel sideways. min-width:0 is what makes that reachable: a flex item's
     base size is its max-content width, so without it the type refuses to
     shrink below its longest line and widens the panel instead of breaking —
     the wrapping was declared but could never happen, which is how a capped
     panel became a scroll region axe fails on. */
  .api .api__type {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--code-size);
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  /* `= "md"`, the way a default is written in the language being documented.
     A labelled field made the reader parse a label to learn what a signature
     already says. Absent simply means no default: there is no column to line
     up with, so nothing needs a placeholder dash. */
  .api .api__default {
    min-width: 0;
    margin-inline-start: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--code-size);
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }

  .api .api__eq {
    color: var(--text-ghost);
    margin-inline-end: 0.4ch;
  }

  /* An event's payload is not its type: it arrives on `event.detail`, and with
     the column headers gone a bare object next to an event name claimed a
     relationship that doesn't exist. Naming the key says it in the language the
     listener is written in, and rhymes with the `=` a default carries. */
  .api .api__key {
    color: var(--text-ghost);
    margin-inline-end: 0.6ch;
  }

  /* Support text, and sized like it. At body size and full card width this ran
     past 120 characters a line — `max-width` on a `td` is ignored by table
     layout, so the measure cap the old markup declared never applied and the
     prose swamped the row it belonged to. */
  .api .api__desc {
    margin: var(--space-sm) 0 0;
    /* The panel carries the measure now, so the description fills it instead
       of stopping short and leaving the card hanging open to its right. */
    font-size: var(--code-size);
    line-height: 1.7;
    color: var(--text-secondary);
  }
</style>
