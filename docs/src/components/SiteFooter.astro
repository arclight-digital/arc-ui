  }

  /* ── Afterglow ── */
  .afterglow {
    position: relative;
    z-index: 0;
    display: flex;
    justify-content: center;
    overflow: hidden;
    /* Headroom above the glyphs: the bloom must fade out on its own, not be
       sliced at the clip edge. The crop is only ever at the bottom. */
    padding-top: 36px;
  }

  .afterglow__stack {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(110px, 16vw, 250px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    white-space: nowrap;
    /* The sink: the word's lower third drops below the page edge. Em-based,
       so the crop point tracks the type size on every viewport. */
    margin-bottom: -0.3em;
  }

  .afterglow__word,
  .afterglow__bloom {
    display: block;
    user-select: none;
  }

  /* The hero headline's bloom, at footer scale: a blurred twin behind the
     word is what makes it read as emitted light rather than printed ink */
  .afterglow__bloom {
    position: absolute;
    inset: 0;
    color: rgba(var(--accent-primary-rgb), 0.4);
    filter: blur(30px);
  }

  .afterglow__word {
    position: relative;
    /* White-hot at the top edge — the same tip treatment as the tunnel's
       beams — dying out before the crop finishes the sinking-light read.
       The first layer is a slow sheen drifting across the glyphs. */
    background:
      linear-gradient(105deg, transparent 32%, rgba(255, 255, 255, 0.28) 50%, transparent 68%),
      linear-gradient(180deg,
        rgba(255, 255, 255, 0.85),
        rgba(var(--accent-primary-rgb), 0.7) 32%,
        rgba(var(--accent-secondary-rgb), 0.3) 62%,
        transparent 85%);
    background-size: 250% 100%, 100% 100%;
    background-position: 200% 0, 0 0;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: afterglow-sheen 9s ease-in-out infinite;
  }

  @keyframes afterglow-sheen {
    0%   { background-position: 200% 0, 0 0; }
    100% { background-position: -150% 0, 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .afterglow__word {
      animation: none;
    }
  }

  /* The page's last pixel row is the site's recurring glow hairline — the
     word sinks through it and the page ends the way its sections divide */
  .afterglow__horizon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--glow-line-gradient);
    filter:
      drop-shadow(0 0 8px rgba(var(--accent-primary-rgb), 0.6))
      drop-shadow(0 -6px 18px rgba(var(--accent-secondary-rgb), 0.35));
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    arc-footer::part(columns) { grid-template-columns: 1fr; }
    .site-footer__brand { align-items: center; text-align: center; }
    .site-footer__title { justify-content: center; }
    .site-footer__tagline { max-width: none; }
    .site-footer__col--end { margin-left: 0; text-align: left; }
    .site-footer__col--end .site-footer__col-links a:hover { transform: translateX(3px); }
    .site-footer__social-row { justify-content: center; }
    .site-footer__legal-inner { flex-direction: column; gap: var(--space-xs); text-align: center; }
  }
</style>
