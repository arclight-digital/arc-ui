<style>
  /* ── Glow horizon along the top ──
     Safe to use the semantic token: .theme-fixed re-declares the surface
     aliases in its own scope (shared/tokens.js), so --surface-base resolves
     against the forced --bg-deep here and matches the bar exactly. */
  .site-footer {
    position: relative;
    background: var(--surface-base);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--glow-line-gradient);
    filter: drop-shadow(0 0 6px rgba(var(--accent-primary-rgb), 0.4));
    z-index: 1;
  }

  /* ── Ambient gradient wash ── */
  .site-footer::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 50% at 20% 80%, rgba(var(--accent-primary-rgb), 0.05), transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 20%, rgba(var(--accent-secondary-rgb), 0.04), transparent 70%);
    z-index: 0;
  }

  /* ── Scroll reveal — CSS tier only, so it can never hide the footer:
       without animation-timeline support the animation just plays on load ── */
  @keyframes footer-reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .site-footer {
    animation: footer-reveal 0.6s ease-out both;
    animation-timeline: view();
    animation-range: entry 0% entry 30%;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer {
      animation: none;
    }
  }

  /* ── Panel sits on the shared surface so the afterglow reads continuous.
       Transparent so the wrapper's wash shows through — a host-element rule
       outranks the component's own :host background. ── */
  .site-footer__panel {
    position: relative;
    z-index: 1;
    background: transparent;
  }

  /* ── Brand section ── */
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .site-footer__title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-body);
  }

  .site-footer__name {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.5px;
    background: var(--gradient-accent-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    /* clip-text paint box: keep descender room whatever the line-height */
    padding-block: 0.1em 0.2em;
    margin-block: -0.1em -0.2em;
    transition: filter var(--transition-fast);
  }

  .site-footer__name:hover {
    filter: drop-shadow(0 0 8px rgba(var(--accent-primary-rgb), 0.6));
  }

  .site-footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 320px;
    text-wrap: balance;
  }

  /* One claim per line — "One Lit / source" is not a place to break */
  .site-footer__tagline-line {
    display: block;
  }

  /* ── Column links ── */
  .site-footer__col-title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-md);
  }

  .site-footer__col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .site-footer__col-links a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    display: inline-block;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .site-footer__col-links a:hover {
    color: rgb(var(--accent-primary-rgb));
    transform: translateX(3px);
  }

  .site-footer__col--end {
    margin-left: auto;
