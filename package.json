{
  "name": "arc-ui-monorepo",
  "private": true,
  "type": "module",
  "version": "3.2.0",
  "description": "ARC UI \u2014 ARC Radiant Components. A framework-agnostic design system built with Lit Web Components.",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm run build:wc && pnpm run build:react && pnpm run build:docs",
    "build:wc": "pnpm --filter @arclux/arc-ui run build",
    "build:react": "pnpm --filter @arclux/arc-ui-react run build",
    "build:docs": "pnpm --filter arc-ui-docs run build",
    "dev": "pnpm --filter arc-ui-docs run dev",
    "generate": "node scripts/generate.js",
    "generate:icons": "node scripts/generate/icons.js",
    "generate:prism:watch": "npx prism --watch",
    "pretest": "pnpm run generate:icons",
    "test": "web-test-runner",
    "lint": "eslint 'packages/*/src/**/*.{js,ts}'",
    "lint:fix": "eslint --fix 'packages/*/src/**/*.{js,ts}'",
    "format": "prettier --write 'packages/*/src/**/*.{js,ts,css}' 'shared/**/*.{js,css}' 'docs/src/data/components/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.{js,ts,css}' 'shared/**/*.{js,css}' 'docs/src/data/components/*.ts'",
    "audit:a11y": "node scripts/a11y-audit.js",
    "docs:deploy": "cd docs && pnpm wrangler pages deploy",
    "bump-versions": "node scripts/bump-versions.js",
    "check": "node scripts/check.js",
    "publish-all": "pnpm -r publish --access public",
    "smoke:wrappers": "node scripts/smoke-test-wrappers.js",
    "test:wrappers": "node scripts/wrapper-runtime.js",
    "mutate": "node scripts/mutate.js",
    "mutate:props": "node scripts/mutate.js --source packages/web-components/src/shared/props.js --tests packages/web-components/test/props.test.js --gate 90",
    "mutate:sample": "node scripts/mutate-sample.js",
    "test:log": "bash scripts/test-run.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@arclux/prism": "^2.13.0",
    "@axe-core/playwright": "^4.12.1",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@phosphor-icons/core": "^2.1.1",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "axe-core": "^4.12.1",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "lucide-static": "^0.563.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "packageExtensions": {
      "@sveltejs/package": {
        "peerDependencies": {
          "typescript": "*"
        }
      }
    }
  }
}
